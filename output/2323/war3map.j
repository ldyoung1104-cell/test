call Bcb(JL,RN,GetUnitStateSwap(UNIT_STATE_MAX_LIFE,RN)*.025,1.,1.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
endif
call RemoveLocation(Id)
