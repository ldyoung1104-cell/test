call UnitApplyTimedLife(JI,$42487765,1)
call IssuePointOrderById(JI,OrderId("dreadlordinferno"),GetLocationX(Ie),GetLocationY(Ie))
endif
elseif EF==$68304241 then
if BFi(1,20)<=9 then
if Bdi(RN) then
set XK=GetUnitStateSwap(UNIT_STATE_MAX_LIFE,RN)*1*.01
elseif GetUnitAbilityLevel(RN,$41393033)>0 then
set XK=GetUnitStateSwap(UNIT_STATE_MAX_LIFE,RN)*4*.01
else
set XK=0
endif
call Bcb(JL,RN,XK+100000.,1.,1.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
endif
endif
call RemoveLocation(Ie)
set Ie=null
set JL=null
set RN=null
set JI=null
endfunction
function B5k takes nothing returns nothing
local unit JL=GetAttacker()
local unit RN=GetTriggerUnit()
local unit JI
local player RT=GetOwningPlayer(JL)
local location It=GetUnitLoc(JL)
local location dM=PolarProjectionBJ(It,200.,GetUnitFacing(JL)+BFj(150,210))
if BFi(1,100)<=9 then
set JI=CreateUnitAtLoc(RT,$68303738,dM,GetUnitFacing(JL))
call UnitApplyTimedLife(JI,$426D6563,3)
call SetUnitVertexColor(JI,255,255,255,200)
call IssueTargetOrder(JI,"attack",RN)
endif
if BFi(1,100)<=5 then
set JI=CreateUnitAtLoc(RT,$68303737,dM,GetUnitFacing(JL))
call SetUnitVertexColor(JI,255,255,255,200)
call UnitApplyTimedLife(JI,$426D6563,3)
endif
call RemoveLocation(dM)
set dM=PolarProjectionBJ(It,150.,GetUnitFacing(JL)+60)
if BFi(1,400)<=17 then
set JI=CreateUnitAtLoc(RT,$68303736,dM,GetUnitFacing(JL))
call SetUnitVertexColor(JI,255,255,255,200)
call UnitApplyTimedLife(JI,$426D6563,4)
endif
if BFi(1,2000)<=51 then
set JI=CreateUnitAtLoc(RT,$68303739,dM,GetUnitFacing(JL))
call SetUnitVertexColor(JI,255,255,255,200)
call UnitApplyTimedLife(JI,$426D6563,4)
call IssueTargetOrder(JI,"attack",RN)
endif
if BFi(1,1000)<=45 then
set JI=CreateUnitAtLoc(HY,$65304B56,It,GetUnitFacing(JL))
call UnitApplyTimedLife(JI,$42487765,1)
call IssueImmediateOrder(JI,"howlofterror")
endif
call RemoveLocation(It)
call RemoveLocation(dM)
set JI=null
set JL=null
set RN=null
set RT=null
set It=null
set dM=null
endfunction
function B5l takes nothing returns nothing
