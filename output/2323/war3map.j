function BIm takes string LC returns string
local integer Hk=0
local integer Lf=StringLength(LC)
loop
exitwhen Hk>=Lf
if SubString(LC,Hk,Hk+1)=="#" then
return SubString(LC,0,Hk)
endif
set Hk=Hk+1
endloop
return LC
endfunction
function BIn takes string LC returns nothing
local string LD=StringCase(LC,false)
local integer EK=0
if LD=="" then
return
endif
loop
exitwhen EK>=LE
if LF[EK]==LD then
return
endif
set EK=EK+1
endloop
set LF[LE]=LD
set LE=LE+1
endfunction
function BIo takes string LC returns boolean
local string LD=StringCase(LC,false)
local string Vc=BIm(LD)
local integer EK=0
if LD=="" then
return false
endif
loop
exitwhen EK>=LE
if LF[EK]==LD or LF[EK]==Vc then
return true
endif
set EK=EK+1
endloop
return false
endfunction
function BIp takes player Cp returns boolean
