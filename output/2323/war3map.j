call TriggerExecute(aX)
endif
if BFi(1,100)<=8 then
call TriggerExecute(aY)
endif
call RemoveLocation(Id)
call RemoveLocation(Ie)
set JL=null
set RN=null
set JI=null
set Id=null
set Ie=null
set RT=null
endfunction
