function Bjc takes integer DT,integer Ks,real II,real Kt,real EN,real JS,boolean Ku returns nothing
if Ku then
set R6[DT]=BDs(Ks,"GUICommandButton__CommandButton icon")
else
set R6[DT]=BDt(Ks,"GUICommandButton__CommandButton icon")
endif
call DzFrameSetSize(R6[DT],II*1./Kx*Ky,Kt*1./Kz*K0)
call DzFrameSetPoint(R6[DT],K1,Ks,K1,EN*1./Kx*Ky,-(JS*1.)/Kz*K0)
set R7[DT]=BD6(R6[DT],"GUICommandButton__CommandButton text1")
call DzFrameSetFont(R7[DT],"Fonts\\esamanruMedium.ttf",20*1.*K3,0)
call DzFrameSetPoint(R7[DT],K4,R6[DT],K4,0*1./Kx*Ky,-(0*1.)/Kz*K0)
call DzFrameSetEnable(R7[DT],false)
if DT==0 then
set R8[DT]=BDv(R6[DT],"GUICommandButton__CommandButton button")
else
set R8[DT]=BDx(R6[DT],"GUICommandButton__CommandButton button")
endif
call DzFrameSetSize(R8[DT],II*1./Kx*Ky,Kt*1./Kz*K0)
call DzFrameSetPoint(R8[DT],K4,R6[DT],K4,0*1./Kx*Ky,-(0*1.)/Kz*K0)
call SaveInteger(K6,0,R8[DT],DT)
call DzFrameSetScriptByCode(R8[DT],1,function Bja,false)
call DzFrameSetScriptByCode(R8[DT],2,function BjY,false)
call DzFrameSetScriptByCode(R8[DT],3,function BjZ,false)
endfunction
function Bjd takes nothing returns nothing
