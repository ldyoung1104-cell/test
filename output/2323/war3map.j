function BJO takes string t6,integer t7 returns integer
local integer t8=LoadInteger(KU,StringHash(t6),0)
local integer t9=LoadInteger(KU,StringHash(t6),-2)
if LoadStr(KU,StringHash(t6),-1)!=t6 then
return 0
endif
if t7>=t8 then
return 0
endif
if t7<t9 then
set t7=t9-1
endif
return t8-t7
endfunction
function BJP takes string t6,integer t7 returns integer
local integer uD=LoadInteger(KU,StringHash(t6),-2)
if t7<uD then
return uD-1
endif
return t7
endfunction
