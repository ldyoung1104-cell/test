call BST(DR,10,CreateUnitAtLoc(HY,$65303736,LoadLocationHandle(E9,0,DR*EM+1),GetRandomDirectionDeg()))
set bj_lastPlayedSound=BHD("SE\\napdo2.wav",null,85,.8,true,1000,1500)
call StopSound(bj_lastPlayedSound,false,false)
call BHH(LoadUnitHandle(E2,0,DR*EM+0),bj_lastPlayedSound)
set Cl=BiE()
call BiZ(Cl,450,LoadLocationHandle(E9,0,DR*EM+1),Condition(function Brm),function Brn)
call BiF(Cl)
call BJ5(DR,.04,1)
endif
