function B2W takes nothing returns nothing
local unit JL=GetAttacker()
local unit RN=GetTriggerUnit()
if GetUnitState(JL,UNIT_STATE_MANA)==100 then
call SetUnitState(JL,UNIT_STATE_MANA,0*1.)
call TriggerExecute(bz)
else
call SetUnitState(JL,UNIT_STATE_MANA,(GetUnitState(JL,UNIT_STATE_MANA)+1)*1.)
endif
if GetUnitState(JL,UNIT_STATE_LIFE)==40 then
call SetUnitState(JL,UNIT_STATE_LIFE,1*1.)
call TriggerExecute(b0)
else
call SetUnitState(JL,UNIT_STATE_LIFE,(GetUnitState(JL,UNIT_STATE_LIFE)+1)*1.)
endif
if BFi(1,100)<=7 then
call TriggerExecute(b1)
endif
if BFi(1,100)<=14 then
call TriggerExecute(b2)
endif
endfunction
function B2X takes nothing returns nothing
