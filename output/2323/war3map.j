function CUB takes nothing returns nothing
local integer EK=0
call EnableDragSelect(true,true)
call EnableSelect(true,true)
loop
exitwhen EK>=LG
call BDa(Player(EK))
set EK=EK+1
endloop
call ResetToGameCamera(0.)
call SetWaterBaseColor(255,255,255,255)
call RemoveDestructable(tD)
call BdD(tE)
call BdD(tF)
call BdD(tG)
call BdD(tH)
call BdD(tI)
call BdD(tJ)
call BdD(tK)
call BdD(tL)
call BdD(tM)
call BdD(tN)
call BdD(tO)
call BdD(tP)
