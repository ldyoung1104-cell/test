function CCG takes nothing returns nothing
local integer JG=GetPlayerId(GetTriggerPlayer())
local unit RU=GetTriggerUnit()
local unit Xp=GetSpellTargetUnit()
local integer fN=GetUnitTypeId(Xp)
local integer fO=0
local real EN=GetPlayerStartLocationX(Player(JG))
local real JS=GetPlayerStartLocationY(Player(JG))
if GetOwningPlayer(Xp)!=Player(7) then
call DisplayTimedTextToPlayer(Player(JG),0,0,5,"|cffff0000[오류]|r 조합식 유닛에게만 사용할 수 있습니다.")
set RU=null
set Xp=null
return
endif
if fN!=$68303630 and fN!=$68303350 and fN!=$68303351 and fN!=$68303358 and fN!=$6830334C and fN!=$68303355 then
call DisplayTimedTextToPlayer(Player(JG),0,0,5,"|cffff0000[오류]|r "+GetUnitName(RU)+"가 건조할 수 있는 선박 유닛이 아닙니다.")
call IssueImmediateOrder(RU,"stop")
set RU=null
set Xp=null
return
endif
if fN==$68303630 then
set fO=2
elseif fN==$68303350 then
set fO=10
elseif fN==$68303351 then
set fO=10
elseif fN==$68303358 then
set fO=15
elseif fN==$6830334C then
set fO=15
elseif fN==$68303355 then
set fO=20
endif
if fO>0 then
if GetPlayerState(Player(JG),PLAYER_STATE_RESOURCE_LUMBER)<fO then
call DisplayTimedTextToPlayer(Player(JG),0,0,10,"|cffff0000[오류]|r |cff20b2aa"+GetUnitName(Xp)+"|r을 건조하려면 |cff7ad823"+I2S(fO)+"목재|r가 필요합니다.")
call IssueImmediateOrder(RU,"stop")
return
endif
call SetPlayerState(Player(JG),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(Player(JG),PLAYER_STATE_RESOURCE_LUMBER)-fO)
call CreateUnit(Player(JG),fN,EN,JS,bj_UNIT_FACING)
call DisplayTimedTextToPlayer(Player(JG),0,0,10,"|cff04ffc4[알림]|r "+GetUnitName(RU)+"가 |cff20b2aa"+GetUnitName(Xp)+"|r을 건조했습니다!")
call UnitRemoveAbility(RU,$41304449)
set RU=null
set Xp=null
return
endif
endfunction
function CCI takes nothing returns nothing
