function CW5 takes nothing returns boolean
local player Cp=Co
if GetLocalPlayer()==Cp then
set Cq=true
call DzFrameShow(Cr,true)
endif
return true
endfunction
function CW6 takes nothing returns boolean
local player Cp=Co
if GetLocalPlayer()==Cp then
set Cq=false
set Ct=false
call DzFrameSetFocus(DzFrameFindByName("LoginDialogIdEditBox",0),false)
call DzFrameSetFocus(DzFrameFindByName("LoginDialogPasswordEditBox",0),false)
call DzFrameShow(Cr,false)
endif
return true
endfunction
function CW7 takes nothing returns boolean
local player Cp=Co
if GetLocalPlayer()==Cp then
set Cq=not Cq
call DzFrameShow(Cr,Cq)
endif
return true
endfunction
function CW8 takes nothing returns boolean
set Cw=Ct
return true
endfunction
function CW9 takes nothing returns boolean
local player Cp=Co
if GetLocalPlayer()==Cp then
set Cy=not Cy
if Cy then
call DzFrameSetTexture(DzFrameFindByName("LoginDialogShowPasswordButtonA",0),"UI\\Glues\\BattleNet\\BattlenetWorkingExpansion\\BNetWorkingExp0020.blp",0)
else
call DzFrameSetTexture(DzFrameFindByName("LoginDialogShowPasswordButtonA",0),"UI\\Glues\\BattleNet\\BattlenetWorkingExpansion\\BNetWorkingExp0004.blp",0)
endif
call DzFrameShow(DzFrameFindByName("LoginDialogShowPasswordButtonDisabled",0),not Cy)
call Bh2(C3)
endif
return true
endfunction
function CXB takes nothing returns boolean
local player Cp=Co
local string C7=C5
if GetLocalPlayer()==Cp and C6!=C7 then
if JNStringCount(C7,"["+C8+"]")>0 then
call DzFrameSetText(DzFrameFindByName("LoginDialogTooltip",0),"사용할 수 없는 특수문자 포함")
else
set C7=JNStringRegex(C7,"^[^"+C8+"]+$",0)
if StringLength(C7)>C9 then
set C7=SubString(C7,0,C9)
call DzFrameSetText(DzFrameFindByName("LoginDialogTooltip",0),"ID는 최대 "+I2S(C9)+"자")
else
call DzFrameSetText(DzFrameFindByName("LoginDialogTooltip",0),"")
endif
endif
set C6=C7
call DzFrameSetText(DzFrameFindByName("LoginDialogIdEditBox",0),C6)
endif
return true
endfunction
function CXC takes nothing returns boolean
local player Cp=Co
local string DC=C5
local integer DD=StringLength(DC)
local integer DE=StringLength(C0)
local string DF=""
if GetLocalPlayer()==Cp and DD!=DE then
if DD>DE then
set DF=JNStringReplace(DC,"*","")
if JNStringCount(DF,"[ㄱ-ㅣ가-힣]")>0 then
call DzFrameSetText(DzFrameFindByName("LoginDialogTooltip",0),"한글 불가")
return true
endif
if JNStringCount(DF,"["+C8+"]")>0 then
call DzFrameSetText(DzFrameFindByName("LoginDialogTooltip",0),"특수문자 불가")
return true
endif
if DG then
set DF=JNStringRegex(DF,"[A-Za-z0-9]$",0)
else
set DF=JNStringRegex(DF,".$",0)
endif
if DF!="" then
set C3=C3+DF
if StringLength(C3)>DH then
set C3=SubString(C3,0,DH)
call DzFrameSetText(DzFrameFindByName("LoginDialogTooltip",0),"PW는 최대 "+I2S(DH)+"자")
elseif StringLength(C3)<DI then
call DzFrameSetText(DzFrameFindByName("LoginDialogTooltip",0),"PW는 최소 "+I2S(DI)+"자")
endif
call Bh2(C3)
endif
else
set C3=SubString(C3,0,DD)
call Bh2(C3)
endif
endif
return true
endfunction
function CXD takes nothing returns boolean
local player Cp=Co
if GetLocalPlayer()==Cp and Cq then
if C6=="" then
call DzFrameSetFocus(DzFrameFindByName("LoginDialogIdEditBox",0),true)
elseif C0=="" then
call DzFrameSetFocus(DzFrameFindByName("LoginDialogPasswordEditBox",0),true)
elseif not Ct then
call vy(Cp)
else
call vx(Cp)
call Bhy(Cp)
endif
endif
return true
endfunction
function CXE takes nothing returns boolean
local player Cp=Co
if GetLocalPlayer()==Cp then
if JNLogin(C6,C3) then
call DzSyncData("LogIn",C6)
else
call DisplayTextToPlayer(Cp,0,0,"|cffff0000[오류]|r 로그인에 실패했습니다. 계정 또는 맵 버전을 확인해주세요.")
set Ct=false
call Bhx(Cp)
endif
endif
return true
endfunction
function CXF takes nothing returns boolean
local player Cp=Co
local string DM=DzFrameGetText(DzFrameFindByName("LoginDialogIdEditBox",0))
local string DN=DzFrameGetText(DzFrameFindByName("LoginDialogPasswordEditBox",0))
if GetLocalPlayer()==Cp then
if DM=="" or JNStringCount(DM,"["+C8+"]")>0 then
call DzFrameSetText(DzFrameFindByName("LoginDialogTooltip",0),"ID를 올바르게 입력하세요")
elseif StringLength(DN)<DI or StringLength(DN)>DH then
call DzFrameSetText(DzFrameFindByName("LoginDialogTooltip",0),"PW 길이를 확인하세요")
else
set Ct=not Ct
if Ct then
call DzFrameSetSize(Cr,.3,.17)
call DzFrameSetSize(Cr,.3,.17)
call DzFrameSetText(DzFrameFindByName("LoginDialogIdLabel",0),DM)
call DzFrameSetText(DzFrameFindByName("LoginDialogPasswordLabel",0),DN)
call DzFrameSetText(DzFrameFindByName("LoginDialogConfirmButton",0),"확인")
else
call DzFrameSetSize(Cr,.3,.25)
call DzFrameSetText(DzFrameFindByName("LoginDialogIdTitle",0),"아이디를 입력하세요")
call DzFrameSetText(DzFrameFindByName("LoginDialogConfirmButton",0),"결정")
endif
call DzFrameShow(DzFrameFindByName("LoginDialogPasswordTitle",0),not Ct)
call DzFrameShow(DzFrameFindByName("LoginDialogIdEditBox",0),not Ct)
call DzFrameShow(DzFrameFindByName("LoginDialogPasswordEditBox",0),not Ct)
call DzFrameShow(DzFrameFindByName("LoginDialogIdLabel",0),Ct)
call DzFrameShow(DzFrameFindByName("LoginDialogPasswordLabel",0),Ct)
call DzFrameShow(DzFrameFindByName("LoginDialogTooltip",0),not Ct)
endif
endif
return true
endfunction
function CXG takes nothing returns boolean
local player Cp=Co
if GetLocalPlayer()==Cp then
set Ct=false
call DzFrameSetSize(Cr,.3,.25)
