function Bjm takes player Cl returns boolean
local integer JG=GetPlayerId(Cl)
return TU[JG]==MW or TU[JG]==MQ or TU[JG]==KW or TU[JG]==MR or TU[JG]==MS or TU[JG]==MU or TU[JG]==MV
endfunction
function Bjn takes integer TK returns integer
if TK==$68303438 then
return SE
elseif TK==$68303432 then
return SL
elseif TK==$68303254 then
return SP
elseif TK==$68303535 then
return SJ
elseif TK==$68303543 then
return SH
elseif TK==$68303538 then
return SK
elseif TK==$48303938 then
return SG
elseif TK==$48303856 then
return SF
elseif TK==$4830354E then
return SI
elseif TK==$48303941 then
return SM
elseif TK==$48303936 then
return SO
elseif TK==$48303939 then
return SS
elseif TK==$48304244 then
return SQ
elseif TK==$48303855 then
return SR
elseif TK==$68303441 then
return SN
endif
return 0
endfunction
function Bjo takes player Cl,integer TK returns boolean
local string TS
local integer TR=Bjn(TK)
if TR==0 then
return false
endif
set TS=Sv[GetPlayerId(Cl)]
return LoadBoolean(SD,StringHash(TS),TR) or (TK==TT and Bjm(Cl))
endfunction
function Bjp takes unit Cm returns boolean
local player RT=GetOwningPlayer(Cm)
local string TS
local integer Zm
local boolean Zn
set TS=Sv[GetPlayerId(RT)]
if GetUnitTypeId(Cm)==$68303438 then
set Zm=SE
elseif GetUnitTypeId(Cm)==$68303432 then
set Zm=SL
elseif GetUnitTypeId(Cm)==$68303254 then
set Zm=SP
elseif GetUnitTypeId(Cm)==$68303535 then
set Zm=SJ
elseif GetUnitTypeId(Cm)==$68303543 then
set Zm=SH
elseif GetUnitTypeId(Cm)==$68303538 then
set Zm=SK
elseif GetUnitTypeId(Cm)==$48303938 then
set Zm=SG
elseif GetUnitTypeId(Cm)==$48303856 then
set Zm=SF
elseif GetUnitTypeId(Cm)==$4830354E then
set Zm=SI
elseif GetUnitTypeId(Cm)==$48303941 then
set Zm=SM
elseif GetUnitTypeId(Cm)==$48303936 then
set Zm=SO
elseif GetUnitTypeId(Cm)==$48303939 then
set Zm=SS
elseif GetUnitTypeId(Cm)==$48304244 then
set Zm=SQ
elseif GetUnitTypeId(Cm)==$48303855 then
set Zm=SR
elseif GetUnitTypeId(Cm)==$68303441 then
set Zm=SN
else
call DisplayTimedTextToPlayer(RT,0,0,5,"|cffff0000[Error]|r 해당 유닛은 스킨이 존재하지 않습니다.")
set RT=null
return false
endif
set Zn=LoadBoolean(SD,StringHash(TS),Zm) or (GetUnitTypeId(Cm)==TT and Bjm(RT))
set RT=null
return Zn
endfunction
function Bjq takes unit RN returns nothing
local unit JI
local location Id=GetUnitLoc(RN)
local integer VP
local integer VQ
local integer VR
local integer VS
local integer JG=GetPlayerId(GetOwningPlayer(RN))
if IsUnitType(RN,UNIT_TYPE_HERO) then
set VP=GetHeroXP(RN)
set VQ=GetHeroStatBJ(bj_HEROSTAT_STR,RN,false)
set VR=GetHeroStatBJ(bj_HEROSTAT_AGI,RN,false)
set VS=GetHeroStatBJ(bj_HEROSTAT_INT,RN,false)
if GetUnitTypeId(RN)==$48303938 then
set JI=CreateUnitAtLoc(GetOwningPlayer(RN),$48303845,Id,bj_UNIT_FACING)
elseif GetUnitTypeId(RN)==$48303856 then
set JI=CreateUnitAtLoc(GetOwningPlayer(RN),$48303842,Id,bj_UNIT_FACING)
elseif GetUnitTypeId(RN)==$4830354E then
set JI=CreateUnitAtLoc(GetOwningPlayer(RN),$48304135,Id,bj_UNIT_FACING)
elseif GetUnitTypeId(RN)==$48303941 then
set JI=CreateUnitAtLoc(GetOwningPlayer(RN),$48304159,Id,bj_UNIT_FACING)
call SetUnitAnimation(JI,"morph")
call QueueUnitAnimation(JI,"stand")
elseif GetUnitTypeId(RN)==$48303936 then
set JI=CreateUnitAtLoc(GetOwningPlayer(RN),$4830424E,Id,bj_UNIT_FACING)
elseif GetUnitTypeId(RN)==$48303939 then
set JI=CreateUnitAtLoc(GetOwningPlayer(RN),$48304339,Id,bj_UNIT_FACING)
elseif GetUnitTypeId(RN)==$48304244 then
set JI=CreateUnitAtLoc(GetOwningPlayer(RN),$4830425A,Id,bj_UNIT_FACING)
elseif GetUnitTypeId(RN)==$48303855 then
set JI=CreateUnitAtLoc(GetOwningPlayer(RN),$48304331,Id,bj_UNIT_FACING)
call SetUnitAnimation(JI,"morph")
call QueueUnitAnimation(JI,"stand")
endif
call SetHeroXP(JI,VP,false)
call GroupAddUnit(Hp[VT[JG]],JI)
call ModifyHeroStat(bj_HEROSTAT_STR,JI,bj_MODIFYMETHOD_SET,VQ)
call ModifyHeroStat(bj_HEROSTAT_AGI,JI,bj_MODIFYMETHOD_SET,VR)
call ModifyHeroStat(bj_HEROSTAT_INT,JI,bj_MODIFYMETHOD_SET,VS)
else
if GetUnitTypeId(RN)==$68303438 then
set JI=CreateUnitAtLoc(GetOwningPlayer(RN),$68303846,Id,bj_UNIT_FACING)
call BH0(LZ[JG],JI,$68303438)
elseif GetUnitTypeId(RN)==$68303432 then
set JI=CreateUnitAtLoc(GetOwningPlayer(RN),$68304138,Id,bj_UNIT_FACING)
call BH0(LZ[JG],JI,$68303432)
elseif GetUnitTypeId(RN)==$68303254 then
set JI=CreateUnitAtLoc(GetOwningPlayer(RN),$68304251,Id,bj_UNIT_FACING)
call BH0(LZ[JG],JI,$68303254)
elseif GetUnitTypeId(RN)==$68303535 then
set JI=CreateUnitAtLoc(GetOwningPlayer(RN),$68304137,Id,bj_UNIT_FACING)
call BH0(LZ[JG],JI,$68303535)
elseif GetUnitTypeId(RN)==$68303538 then
set JI=CreateUnitAtLoc(GetOwningPlayer(RN),$6830375A,Id,bj_UNIT_FACING)
elseif GetUnitTypeId(RN)==$68303543 then
set JI=CreateUnitAtLoc(GetOwningPlayer(RN),$68303955,Id,bj_UNIT_FACING)
set VW=JI
call TriggerExecute(VX)
elseif GetUnitTypeId(RN)==$68303441 then
set JI=CreateUnitAtLoc(GetOwningPlayer(RN),$68304156,Id,bj_UNIT_FACING)
endif
endif
call Bhm(JI)
call RemoveUnit(RN)
call RemoveLocation(Id)
set RN=null
set JI=null
set Id=null
endfunction
function Bjr takes player Cl,integer TK returns boolean
local group H1
local unit Cm
local boolean VY=false
if not Bjo(Cl,TK) then
return false
endif
set H1=CreateGroup()
call GroupEnumUnitsOfPlayer(H1,Cl,null)
loop
set Cm=FirstOfGroup(H1)
exitwhen Cm==null
call GroupRemoveUnit(H1,Cm)
if GetUnitTypeId(Cm)==TK then
call Bjq(Cm)
set VY=true
endif
endloop
call DestroyGroup(H1)
set H1=null
set Cm=null
return VY
endfunction
