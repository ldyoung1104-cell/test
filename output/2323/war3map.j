endif
if BFi(1,100)<=14 then
set JI=CreateUnitAtLoc(HY,$65303031,Ie,GetUnitFacing(JL))
call SetUnitAnimation(JI,"birth")
set JI=CreateUnitAtLoc(HY,$65303351,Ie,GetUnitFacing(JL))
set Cl=BiE()
call BiZ(Cl,600,Ie,Condition(function Br5),function Br7)
call BiF(Cl)
