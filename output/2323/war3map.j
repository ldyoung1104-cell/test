set e7=CreateTrigger()
call BKD(e7)
call TriggerAddAction(e7,function CB2)
set e8=CreateTrigger()
call BKD(e8)
call TriggerAddAction(e8,function CB3)
set fC=CreateTrigger()
call BKD(fC)
call TriggerAddAction(fC,function CBw)
set fD=CreateTrigger()
call BKD(fD)
call TriggerAddAction(fD,function CBu)
call BC5(KH,$41323033,function CBg)
