endif
if KL[EF+2] then
call SetCameraField(CAMERA_FIELD_ANGLE_OF_ATTACK,KM[EF+2],KN[EF+2])
endif
if KL[EF+3] then
call SetCameraField(CAMERA_FIELD_FIELD_OF_VIEW,KM[EF+3],KN[EF+3])
endif
if KL[EF+4] then
call SetCameraField(CAMERA_FIELD_ROLL,KM[EF+4],KN[EF+4])
endif
if KL[EF+5] then
call SetCameraField(CAMERA_FIELD_ROTATION,KM[EF+5],KN[EF+5])
endif
if KL[EF+6] then
call SetCameraField(CAMERA_FIELD_ZOFFSET,KM[EF+6],KN[EF+6])
endif
if KL[EF+10] then
call PanCameraToTimed(KM[EF+10],KM[EF+11],KN[EF+10])
endif
endfunction
