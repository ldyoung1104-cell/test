function CHN takes nothing returns nothing
local unit JL=GetAttacker()
local integer ZX=33
local integer ZY=100+5*(GetUnitAbilityLevel(JL,$4130514A)-1)
if GetUnitState(JL,UNIT_STATE_LIFE)>=150 then
call SetUnitState(JL,UNIT_STATE_LIFE,1*1.)
call TriggerExecute(hG)
elseif not UnitHasBuffBJ(JL,$42303749) then
call TriggerExecute(hH)
else
call SetUnitState(JL,UNIT_STATE_LIFE,(GetUnitState(JL,UNIT_STATE_LIFE)+1)*1.)
endif
if UnitHasBuffBJ(JL,$4230384E) then
call SetUnitAnimation(JL,"spell channel")
call TriggerExecute(hI)
set ZX=100
endif
if BFi(1,100)<=ZX then
call TriggerExecute(hJ)
endif
if BFi(1,1000)<=ZY then
call IssueTargetOrder(CG9(GetPlayerId(GetOwningPlayer(JL))),"bloodlust",JL)
endif
set JL=null
endfunction
function CHO takes nothing returns nothing
local unit RU=GetTriggerUnit()
local player RT=GetOwningPlayer(RU)
local integer JG=GetPlayerId(RT)
local unit Cm=GetSpellTargetUnit()
if GetOwningPlayer(Cm)!=RT then
call DisplayTimedTextToPlayer(RT,0,0,5,"|cffff0000[오류]|r 자신의 유닛에게만 사용할 수 있습니다")
set RT=null
set RU=null
set Cm=null
return
endif
if UnitHasBuffBJ(Cm,$42303850) then
call DisplayTimedTextToPlayer(RT,0,0,5,"|cffff0000[오류]|r 이 유닛은 이미 공포에 휩싸여있습니다.")
set RT=null
set RU=null
set Cm=null
return
endif
if GetUnitAbilityLevel(RU,$4130514A)>=11 then
call DisplayTimedTextToPlayer(RT,0,0,5,"|cffff0000[알림]|r '지상 최강의 생물'의 스킬레벨이 최대치 입니다.")
set RT=null
set RU=null
set Cm=null
return
endif
if GetUnitAbilityLevel(Cm,$41393132)>0 or GetUnitAbilityLevel(Cm,$4130374E)>0 or GetUnitAbilityLevel(Cm,$41305148)>0 or GetUnitAbilityLevel(Cm,$41313052)>0 then
call DisplayTimedTextToPlayer(RT,0,0,5,"|cff04ffc4[알림]|r'배면귀' 효과로 '지상 최강의 생물' 스킬레벨이 증가합니다.")
call IncUnitAbilityLevel(RU,$4130514A)
call IncUnitAbilityLevel(RU,$41305331)
call IssueTargetOrder(CG9(JG),"banish",Cm)
else
call DisplayTimedTextToPlayer(RT,0,0,5,"|cffff0000[알림]|r 배면귀 효과는 전설/히든/변화/왜곡 유닛에만 적용 가능합니다.")
endif
set RT=null
set RU=null
set Cm=null
endfunction
