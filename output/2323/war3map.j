endif
if GetOwningPlayer(GetSpellTargetUnit())==Player(7) then
call DisplayTimedTextToPlayer(Player(JG),0,0,5,"|cffff0000[오류]|r 조합식 유닛에게는 사용할 수 없습니다.")
call UnitRemoveAbility(GetTriggerUnit(),$41304C51)
call UnitAddAbility(GetTriggerUnit(),$41304C51)
return
endif
if fT then
call DisplayTimedTextToPlayer(Player(JG),0,0,5,"|cff04ffc4[알림]|r 누가 |cffFF8200'경단먹이기'|r 스킬을 사용 중입니다. 잠시 후 다시 시도해주세요.")
call UnitRemoveAbility(GetTriggerUnit(),$41304C51)
call UnitAddAbility(GetTriggerUnit(),$41304C51)
return
endif
set fT=true
set fQ=GetTriggerUnit()
set fR=GetSpellTargetUnit()
set U6="오타마가 '경단먹이기' 스킬을 사용합니다\n"
set U6=U6+"◎ 대상 : "+GetUnitName(fR)+"|r\n"
set U6=U6+"◎ 소유권 변경 보상 : |cff7ad82312 목재|r\n\n"
set U6=U6+"소유권을 변경하시겠습니까?"
call DialogSetMessage(fP,U6)
set fS=DialogAddButton(fP,"수락",0)
set fU=DialogAddButton(fP,"거절",0)
call DialogDisplay(GetOwningPlayer(fR),fP,true)
endfunction
function CCJ takes nothing returns nothing
