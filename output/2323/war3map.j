function BhQ takes integer JG,integer Hk,integer i0 returns integer
local integer i1
local integer C2
if i0==fY then
set i1=Qx[JG]-1
set C2=Qz[JG*ix+Hk]
set Qz[JG*ix+Hk]=Qz[JG*ix+i1]
set Qx[JG]=i1
else
set i1=Qy[JG]-1
set C2=Q0[JG*ix+Hk]
set Q0[JG*ix+Hk]=Q0[JG*ix+i1]
set Qy[JG]=i1
endif
return C2
endfunction
function BhR takes integer JG,integer i0 returns integer
local integer kp
local integer kq
if i0==fY then
set kp=Qx[JG]
else
set kp=Qy[JG]
endif
if kp<=0 then
return 0
endif
set kq=BFi(0,kp-1)
return BhQ(JG,kq,i0)
endfunction
function BhS takes player Cl returns integer
local integer JG=GetPlayerId(Cl)
local integer C2
local integer e2=BFi(1,100)
call UnitRemoveAbility(RV[JG],LoadInteger(Qr,0,fZ[JG]))
set fZ[JG]=fZ[JG]-1
call UnitAddAbility(RV[JG],LoadInteger(Qr,0,fZ[JG]))
if (e2<=90 and Qx[JG]>0) or Qy[JG]==0 then
set C2=BhR(JG,fY)
set i2[JG]=i2[JG]+1
else
set C2=BhR(JG,fa)
set i3[JG]=i3[JG]+1
endif
if C2<=0 then
call BJDebugMsg("|cffff0000[오류]|r 아이템 뽑기중 오류가 발생했습니다. ErrorID : "+I2S(C2))
return 0
endif
call BhP(Cl,C2)
call BCg(Cl)
return C2
endfunction
function BhT takes player Cl returns integer
local integer JG=GetPlayerId(Cl)
local integer C2=BhR(JG,fa)
call UnitRemoveAbility(RV[JG],LoadInteger(Qr,1,fb[JG]))
set fb[JG]=fb[JG]-1
call UnitAddAbility(RV[JG],LoadInteger(Qr,1,fb[JG]))
set i3[JG]=i3[JG]+1
if C2<=0 then
call BJDebugMsg("|cffff0000[오류]|r 유니크 아이템 뽑기중 오류가 발생했습니다. ErrorID : "+I2S(C2))
return 0
endif
call BhP(Cl,C2)
call BCg(Cl)
return C2
endfunction
function BhU takes player Cl,integer iw returns integer
local integer JG=GetPlayerId(Cl)
local integer EK=0
local boolean iz=false
loop
exitwhen EK>=Qy[JG]
if Q0[JG*ix+EK]==iw then
set iz=true
call BhQ(JG,EK,fa)
exitwhen true
endif
set EK=EK+1
endloop
if not iz then
call BJDebugMsg("|cffff0000[오류] 이미 획득한 아이템 입니다.")
return -1
endif
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,10,GetPlayerName(Player(JG))+"|r 님이 |cffFF8200꾸러미상자 :: 아이템 |r을 사용해 "+GetObjectName(iw)+" 획득!")
set i3[JG]=i3[JG]+1
call BhP(Cl,iw)
call BCg(Cl)
return iw
endfunction
function BhV takes player Cl,integer iw returns integer
local integer JG=GetPlayerId(Cl)
local integer iy=-1
local integer EK
local boolean iz=false
set EK=0
loop
exitwhen EK>=Qx[JG]
if Qz[JG*ix+EK]==iw then
set iy=iw
set iz=true
call BhQ(JG,EK,fY)
set i2[JG]=i2[JG]+1
exitwhen true
endif
set EK=EK+1
endloop
if not iz then
set EK=0
loop
exitwhen EK>=Qy[JG]
if Q0[JG*ix+EK]==iw then
set iy=iw
set iz=true
call BhQ(JG,EK,fa)
set i3[JG]=i3[JG]+1
exitwhen true
endif
set EK=EK+1
endloop
endif
if iz then
call BhP(Cl,iy)
call BCg(Cl)
return iy
endif
return -1
endfunction
function BhW takes player Cl returns nothing
