function BlR takes nothing returns nothing
local integer EK=0
local integer TF=15
call Bkp(11,Sp,"스킨 미리보기",540,270,430,340)
call Bkp(12,Sp,"스킨 적용",380,270,990,340)
call BlQ(0,Sp,150,40,115,400)
call DzFrameSetText(UN[0],"전설")
call BlQ(6,Sp,150,40,285,400)
call DzFrameSetText(UN[6],"히든")
call BlQ(1,Sp,150,40,115,450)
call DzFrameSetText(UN[1],"제한")
call BlQ(2,Sp,150,40,285,450)
call DzFrameSetText(UN[2],"초월")
call BlQ(3,Sp,150,40,115,500)
call DzFrameSetText(UN[3],"영원")
call BlQ(4,Sp,150,40,285,500)
call DzFrameSetText(UN[4],"불멸")
call BlQ(5,Sp,150,40,115,550)
call DzFrameSetText(UN[5],"왜곡")
set UQ=BDt(Sp,"PremiumSkinPreviewImage")
call DzFrameSetSize(UQ,256*1./Kx*Ky,160*1./Kz*K0)
call DzFrameSetPoint(UQ,0,Sp,0,572*1./Kx*Ky,-(380*1.)/Kz*K0)
call DzFrameShow(UQ,false)
set UR=BD6(Sp,"PremiumSkinPreviewText")
call DzFrameSetFont(UR,"Fonts\\esamanruMedium.ttf",16*1.*K3,0)
call DzFrameSetPoint(UR,0,Sp,0,500*1./Kx*Ky,-(555*1.)/Kz*K0)
call DzFrameSetText(UR,"|cffbfbfbf우측에서 적용할 스킨을 선택하세요.|r")
loop
exitwhen EK>=TF
call Bk4(EK,Sp,1025+ModuloInteger(EK,5)*60,390+EK/5*60)
call DzFrameShow(TO[EK],false)
set EK=EK+1
endloop
call BlH(0,Sp,110,32,1090,585)
call DzFrameSetText(Ud[0],"이전")
call DzFrameSetFont(Ud[0],"Fonts\\esamanruMedium.ttf",16*1.*K3,0)
call BlH(1,Sp,110,32,1250,585)
call DzFrameSetText(Ud[1],"다음")
call DzFrameSetFont(Ud[1],"Fonts\\esamanruMedium.ttf",16*1.*K3,0)
endfunction
function BlS takes integer K7 returns nothing
local integer JG=GetPlayerId(DzGetTriggerUIEventPlayer())
if GetLocalPlayer()==Player(JG) then
call DzFrameShow(Si,false)
call DzFrameShow(Sl,false)
call DzFrameShow(Sj,false)
call BkD(Sk,false)
call DzFrameShow(Ss,false)
call DzFrameShow(Sr,true)
endif
if K7==1 or K7==4 then
if GetLocalPlayer()==Player(JG) then
call DzFrameShow(Sm,true)
call DzFrameShow(Sn,false)
call DzFrameShow(So,false)
call BkD(Sp,false)
endif
elseif K7==2 or K7==5 then
if GetLocalPlayer()==Player(JG) then
call DzFrameShow(Sm,false)
call DzFrameShow(Sn,true)
call DzFrameShow(So,false)
call BkD(Sp,false)
endif
elseif K7==3 or K7==6 then
if GetLocalPlayer()==Player(JG) then
call DzFrameShow(Sm,false)
call DzFrameShow(Sn,false)
call DzFrameShow(So,true)
call BkD(Sp,false)
endif
elseif K7==7 or K7==8 then
if GetLocalPlayer()==Player(JG) then
call Bk5(JG)
call DzFrameShow(Sm,false)
call DzFrameShow(Sn,false)
call DzFrameShow(So,false)
call BkD(Sp,true)
call BkD(Sk,false)
endif
endif
endfunction
