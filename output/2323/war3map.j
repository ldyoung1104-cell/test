set V7=PolarProjectionBJ(Ie,I0,GetUnitFacing(JL)+XI)
set JI=CreateUnitAtLoc(HY,$6530324A,V7,GetUnitFacing(JL)+180)
call SetUnitFlyHeight(JI,90,0)
call SetUnitVertexColor(JI,125,125,125,255)
call Bcb(JL,RN,100000.,1.,3.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
call Bcc(JL,0.,475,Ie,200000,1.,1.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
call RemoveLocation(V7)
endif
call RemoveLocation(Ie)
call RemoveLocation(Id)
set JI=null
set JL=null
set RN=null
set Id=null
set Ie=null
set V7=null
endfunction
