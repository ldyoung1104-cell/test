set KN[EF+2]=0.
set KN[EF+3]=0.
set KN[EF+4]=0.
set KN[EF+5]=0.
set KN[EF+6]=0.
set KN[EF+10]=0.
call BDZ()
endfunction
function BDe takes player Cl,camerasetup s8,boolean s9 returns nothing
local integer EF
if Cl==null then
return
endif
if s8==null then
return
endif
set EF=GetPlayerId(Cl)*KK
set KN[EF+0]=0.
set KN[EF+1]=0.
set KN[EF+2]=0.
set KN[EF+3]=0.
set KN[EF+4]=0.
set KN[EF+5]=0.
set KN[EF+6]=0.
set KM[EF+0]=CameraSetupGetField(s8,CAMERA_FIELD_TARGET_DISTANCE)
set KM[EF+1]=CameraSetupGetField(s8,CAMERA_FIELD_FARZ)
set KM[EF+2]=CameraSetupGetField(s8,CAMERA_FIELD_ANGLE_OF_ATTACK)
set KM[EF+3]=CameraSetupGetField(s8,CAMERA_FIELD_FIELD_OF_VIEW)
set KM[EF+4]=CameraSetupGetField(s8,CAMERA_FIELD_ROLL)
set KM[EF+5]=CameraSetupGetField(s8,CAMERA_FIELD_ROTATION)
set KM[EF+6]=CameraSetupGetField(s8,CAMERA_FIELD_ZOFFSET)
set KL[EF+0]=true
set KL[EF+1]=true
set KL[EF+2]=true
set KL[EF+3]=true
set KL[EF+4]=true
set KL[EF+5]=true
set KL[EF+6]=true
if s9 then
set KN[EF+10]=0.
set KM[EF+10]=CameraSetupGetDestPositionX(s8)
set KM[EF+11]=CameraSetupGetDestPositionY(s8)
set KL[EF+10]=true
endif
call BDZ()
endfunction
