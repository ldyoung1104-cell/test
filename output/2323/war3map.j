function BDZ takes nothing returns nothing
local integer dx=0
local integer EF
local boolean tB=false
loop
exitwhen dx>=bj_MAX_PLAYERS
set EF=dx*KK
if KL[EF+0] or KL[EF+1] or KL[EF+2] or KL[EF+3] or KL[EF+4] or KL[EF+5] or KL[EF+6] or KL[EF+10] then
set tB=true
exitwhen true
endif
set dx=dx+1
endloop
if tB and not tC then
call ResumeTimer(KI)
set tC=true
elseif not tB and tC then
call PauseTimer(KI)
set tC=false
endif
endfunction
