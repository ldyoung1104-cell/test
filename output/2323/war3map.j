call IssueTargetOrder(b8[GetPlayerId(GetOwningPlayer(JL))],"frostarmor",JL)
call TriggerExecute(cB)
endif
endif
if GetUnitState(JL,UNIT_STATE_MANA)==100 then
call SetUnitState(JL,UNIT_STATE_MANA,0*1.)
call TriggerExecute(cC)
else
call SetUnitState(JL,UNIT_STATE_MANA,(GetUnitState(JL,UNIT_STATE_MANA)+1)*1.)
endif
if BFi(1,16)==1 then
call TriggerExecute(cD)
endif
if BFi(1,400)<=57 then
call TriggerExecute(cE)
endif
if BFi(1,100)<=25 then
set JI=CreateUnitAtLoc(HY,$65304436,Ie,GetUnitFacing(JL))
set JI=CreateUnitAtLoc(HY,$65304437,Ie,GetUnitFacing(JL))
call Bcb(JL,RN,1000000.+I2R(b9)*10000,1.,1.,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL)
endif
call RemoveLocation(Ie)
set JL=null
set RN=null
set JI=null
set Ie=null
endfunction
