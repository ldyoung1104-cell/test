function Bkr takes nothing returns nothing
local integer JG=GetPlayerId(DzGetTriggerSyncPlayer())
local string U0=DzGetTriggerSyncData()
local integer TK
local integer Tq
local integer Up
local integer U3
call BHn(U0,",")
set TK=S2I(Rm[0])
set Tq=S2I(Rm[1])
set Up=Ly[Tq]
if LoadInteger(Lx[JG],TK,Up)!=Tt then
if LoadInteger(Lx[JG],TK,Up)==SX then
call SaveInteger(Lx[JG],TK,Up,U1)
else
call SaveInteger(Lx[JG],TK,Up,SX)
endif
call BkB(Player(JG),TK)
call Bkq(JG)
else
set U3=LoadInteger(L7,Up,L8)
if U4 and TK==$68303831 and Tq==5 or Tq==6 then
set U3=1
endif
if GetLocalPlayer()==Player(JG) then
set UU[0]="상품구매확인"
set UV[0]="'"+LoadStr(L7,Up,L9)+"' 상품을 |cff1e90ff"+I2S(U3)+" 베리|r 에 구매하시겠습니까?"
set UW[0]=I2S(TK)+","+I2S(Up)
set UX[0]="BuyCody"
call BkN(0,true)
endif
endif
endfunction
function Bks takes nothing returns nothing
local integer JG=GetPlayerId(DzGetTriggerSyncPlayer())
