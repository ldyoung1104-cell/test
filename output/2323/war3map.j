function CIg takes nothing returns nothing
local integer JG=GetPlayerId(GetTriggerPlayer())
if BIp(Player(JG)) then
call BIr(Player(JG),KT[GetPlayerId(Player(JG))])
return
endif
if X3>=10 then
call DisplayTimedTextToPlayer(Player(JG),0,0,10,"|cff04ffc4[알림]|r 10라운드 이전에만 오프라인 모드를 활성화할 수 있습니다.")
return
endif
if jJ[JG] then
call DisplayTimedTextToPlayer(Player(JG),0,0,10,"|cffff0000[오류]|r 로드한 유저는 사용할 수 없습니다.")
return
endif
if jK[JG] then
call DisplayTimedTextToPlayer(Player(JG),0,0,10,"|cffff0000[오류]|r 이미 오프라인 모드입니다.")
return
endif
set jK[JG]=true
if GetLocalPlayer()==Player(JG) then
call DzFrameShow(Va,false)
endif
set Sw[JG]=50
call DisplayTimedTextToPlayer(Player(JG),0,0,10,"오프라인 모드 작동. |cff00d9ff세이브|r가 불가능합니다.")
call DisplayTimedTextToPlayer(Player(JG),0,0,10,"|CFFC15AF4★|r 클리어 횟수를 |cff1e90ff50회|r로 설정합니다.")
endfunction
function CIh takes nothing returns nothing
call Bcx("-오프라인모드",true,function CIg)
call Bcx("-offline",true,function CIg)
endfunction
function CIj takes nothing returns nothing
local integer K7=S2I(DzGetTriggerSyncData())
local integer JG=GetPlayerId(DzGetTriggerSyncPlayer())
local real jU
if K7==1 then
call Bjh(JG,LT[JG])
elseif K7==2 then
call Bji(JG,IP[JG])
elseif K7==3 then
call Bjj(JG,LH[JG])
elseif K7==4 then
call Bjk(JG,LU[JG])
elseif K7==5 then
if jT[JG]==null then
set jT[JG]=CreateTimer()
endif
set jU=TimerGetRemaining(jT[JG])
if jU>0. then
if GetLocalPlayer()==Player(JG) then
call DisplayTimedTextToPlayer(Player(JG),0,0,3,"|cffF15F5F[시스템]|r 유틸 갱신 대기시간이 |cffffcc00"+R2SW(jU,1,1)+"초|r 남았습니다.")
endif
else
call BjL(JG)
call TimerStart(jT[JG],jc,false,null)
if GetLocalPlayer()==Player(JG) then
call DisplayTimedTextToPlayer(Player(JG),0,0,3,"|cffF15F5F[시스템]|r 유틸리티 정보를 갱신했습니다.")
endif
endif
endif
endfunction
function CIl takes nothing returns nothing
set je[GetPlayerId(GetTriggerPlayer())]=GetTriggerUnit()
endfunction
function CIm takes player ji returns player
local unit jj=je[GetPlayerId(ji)]
local player jk=null
if jj!=null then
set jk=GetOwningPlayer(jj)
endif
set jj=null
return jk
endfunction
function CIn takes playerstate jf,string jg,string jh returns nothing
local player ji=GetTriggerPlayer()
local player jk=CIm(ji)
local integer jn=-1
local string jl=GetEventPlayerChatString()
local string jm=GetEventPlayerChatStringMatched()
local integer h7=S2I(SubString(jl,StringLength(jm),StringLength(jl)))
local integer jo
if jk!=null then
set jn=GetPlayerId(jk)
endif
if h7<=0 then
call DisplayTimedTextToPlayer(ji,0,0,5,"|cffff0000[오류]|r 전송량은 1 이상이어야 합니다.")
elseif jk==null or jk==ji or jn<0 or jn>=LG or GetPlayerSlotState(jk)!=PLAYER_SLOT_STATE_PLAYING or GetPlayerController(jk)!=MAP_CONTROL_USER then
call DisplayTimedTextToPlayer(ji,0,0,5,"|cffff0000[오류]|r 자원을 받을 다른 플레이어의 유닛을 선택하세요.")
else
set jo=GetPlayerState(ji,jf)
if jo<h7 then
call DisplayTimedTextToPlayer(ji,0,0,5,"|cffff0000[오류]|r "+jh+jg+"|r가 부족합니다.")
else
call SetPlayerState(ji,jf,jo-h7)
call SetPlayerState(jk,jf,GetPlayerState(jk,jf)+h7)
call DisplayTimedTextToPlayer(ji,0,0,5,"|cff04ffc4[자원 전송]|r "+GetPlayerName(jk)+"|r 님에게 "+jh+I2S(h7)+" "+jg+"|r 전송")
call DisplayTimedTextToPlayer(jk,0,0,5,"|cff04ffc4[자원 전송]|r "+GetPlayerName(ji)+"|r 님에게서 "+jh+I2S(h7)+" "+jg+"|r 획득")
endif
endif
set ji=null
set jk=null
endfunction
function CIo takes nothing returns nothing
call CIn(PLAYER_STATE_RESOURCE_GOLD,"골드","|cffffd700")
endfunction
function CIp takes nothing returns nothing
call CIn(PLAYER_STATE_RESOURCE_LUMBER,"목재","|cff7ad823")
endfunction
function CIq takes nothing returns nothing
local trigger jd=CreateTrigger()
local integer EK=0
call TriggerAddAction(jd,function CIl)
loop
exitwhen EK>=LG
call TriggerRegisterPlayerUnitEvent(jd,Player(EK),EVENT_PLAYER_UNIT_SELECTED,null)
set EK=EK+1
endloop
call Bcx("-골드",false,function CIo)
call Bcx("-금",false,function CIo)
call Bcx("-돈",false,function CIo)
call Bcx("-목재",false,function CIp)
set jd=null
endfunction
function CIs takes nothing returns nothing
local integer JG=GetPlayerId(GetTriggerPlayer())
local integer EK=1
local string jq=""
local string jr="없음"
local string js=""
local string jt=""
loop
exitwhen EK>=jp
if LP[EK]!=null then
if EK==1 then
set jq=LP[EK]
else
set jq=jq+" / "+LP[EK]
endif
endif
set EK=EK+1
endloop
if jq=="" then
set jq="일반"
endif
if NB!=null and $6F303245==GetUnitTypeId(NB) then
set jr="워큐리"
elseif NB!=null and $6F303331==GetUnitTypeId(NB) then
set jr="새턴"
elseif NB!=null and $6F303332==GetUnitTypeId(NB) then
set jr="나스쥬로"
endif
if jK[JG] then
set js="|cffFF0000 (오프라인모드)|r"
endif
if YO[JG]>0 then
set jt=" / |cffFF8200선택위습|r : |cffFAED7D"+I2S(YO[JG])+"|r회"
endif
call DisplayTimedTextToPlayer(Player(JG),0,0,15,"◎ 플레이어 : "+KT[JG]+js)
call DisplayTimedTextToPlayer(Player(JG),0,0,15,"◎ 버전 : |cff6799FF"+ju+"|r")
call DisplayTimedTextToPlayer(Player(JG),0,0,15,"◎ 난이도 : "+ij+" / ◎ 모드 : "+jq)
call DisplayTimedTextToPlayer(Player(JG),0,0,15,"◎ 오로성 : "+jr)
call DisplayTimedTextToPlayer(Player(JG),0,0,15,"◎ 최종 유닛 카운트 : |cffFAED7D"+I2S(jv[JG])+"|r")
if LS[JG] then
call DisplayTimedTextToPlayer(Player(JG),0,0,15,"◎ 항법 : |cffB2EBF4"+LQ[JG]+"|r / ◎ 노드 : |cffffae00랜덤("+LR[JG]+")|r")
else
call DisplayTimedTextToPlayer(Player(JG),0,0,15,"◎ 항법 : |cffB2EBF4"+LQ[JG]+"|r / ◎ 노드 : |cffffae00"+LR[JG]+"|r")
endif
call DisplayTimedTextToPlayer(Player(JG),0,0,15,"◎ 최상위 유닛 : |cffFAED7D"+I2S(Q7[JG])+"|r개")
call DisplayTimedTextToPlayer(Player(JG),0,0,15,"◎ 보물 발견 횟수 : |cffFFFFFF흔함|r : |cffFAED7D"+I2S(YQ[JG])+"|r회 / |cffFFFFFF안흔함|r : |cffFAED7D"+I2S(YS[JG])+"|r회"+jt)
call DisplayTimedTextToPlayer(Player(JG),0,0,15,"◎ 유닛 도박")
call DisplayTimedTextToPlayer(Player(JG),0,0,15,"  |cffF15F5F▶ 하급|r : |cffFAED7D"+I2S(jw[JG])+"|r회 / 안흔함 |cffFAED7D"+I2S(jx[JG])+"|r개 / 흔함 |cffFAED7D"+I2S(jy[JG])+"|r개")
call DisplayTimedTextToPlayer(Player(JG),0,0,15,"  |cffF15F5F▶ 중급|r : |cffFAED7D"+I2S(jz[JG])+"|r회 / 성공 |cffFAED7D"+I2S(j0[JG])+"|r회")
call DisplayTimedTextToPlayer(Player(JG),0,0,15,"  |cffF15F5F▶ 고급|r : |cffFAED7D"+I2S(j1[JG])+"|r회 / 희귀 |cffFAED7D"+I2S(j2[JG])+"|r개 / 특별 |cffFAED7D"+I2S(j3[JG])+"|r개")
call DisplayTimedTextToPlayer(Player(JG),0,0,15,"  |cffF15F5F▶ 이세계|r : |cffFAED7D"+I2S(j4[JG])+"|r회 / 성공  |cffFAED7D"+I2S(j5[JG])+"|r회")
call DisplayTimedTextToPlayer(Player(JG),0,0,15,"  |cffF15F5F▶ 압살롬|r : |cffFAED7D"+I2S(j6[JG])+"|r회 / 성공  |cffFAED7D"+I2S(j7[JG])+"|r회")
call DisplayTimedTextToPlayer(Player(JG),0,0,15,"◎ 목재도박 : |cffFAED7D"+I2S(R2I(j8[JG]))+"|r회 / 성공  |cffFAED7D"+I2S(j9[JG])+"|r회")
call DisplayTimedTextToPlayer(Player(JG),0,0,15,"◎ 흔함판매 : |cffFAED7D"+I2S(R2I(LY[JG]))+"|r회 / ◎ 선택위습 사용 : |cffFAED7D"+I2S(R2I(kB[JG]))+"|r회")
endfunction
