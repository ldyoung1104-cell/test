function COv takes nothing returns nothing
local unit Cm
set Cm=CreateUnit(Player(5),pl,GetRectCenterX(B1),GetRectCenterY(B1),bj_UNIT_FACING)
call UnitAddAbility(Cm,$41393034)
call SetUnitAbilityLevel(Cm,$41303451,NJ)
call BDO(Cm,function COr)
set pt=BHs(0)
call TimerStart(pt,1,true,function COt)
set on=on+1
set Cm=null
endfunction
