function Bru takes nothing returns nothing
local unit JL=GetAttacker()
local unit RN=GetTriggerUnit()
local unit JI
local location Ie=GetUnitLoc(RN)
call SetUnitState(JL,UNIT_STATE_MANA,GetUnitStateSwap(UNIT_STATE_MANA,JL)+1)
if UnitHasBuffBJ(JL,$42303256)==true then
if GetUnitStateSwap(UNIT_STATE_MANA,JL)==100. then
call SetUnitState(JL,UNIT_STATE_MANA,0)
set JI=CreateUnitAtLoc(HY,$65303342,Ie,GetUnitFacing(JL))
call SetUnitScale(JI,3.85,1,1)
call SetUnitAnimationByIndex(JI,1)
set JI=CreateUnitAtLoc(HY,$6530334E,Ie,GetUnitFacing(JL))
call IssuePointOrderById(JI,OrderId("dreadlordinferno"),GetLocationX(Ie),GetLocationY(Ie))
call Bcc(JL,0.,600,Ie,$1C3A90,1.,1.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
endif
elseif BFi(1,100)<=10 then
set JI=CreateUnitAtLoc(HY,$6530334F,Ie,0)
call IssuePointOrderById(JI,OrderId("dreadlordinferno"),GetLocationX(Ie),GetLocationY(Ie))
call Bcc(JL,0.,600,Ie,200000,1.,1.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
endif
if GetUnitPropWindowBJ(RN)!=64. and Bdi(RN) or GetUnitAbilityLevel(RN,$41393033)>0 then
call SetUnitPropWindowBJ(RN,64.)
set JI=CreateUnitAtLoc(HY,$65303342,Ie,GetUnitFacing(JL))
call SetUnitScale(JI,3.85,1,1)
call SetUnitAnimationByIndex(JI,1)
set JI=CreateUnitAtLoc(HY,$6530334E,Ie,GetUnitFacing(JL))
call IssuePointOrderById(JI,OrderId("dreadlordinferno"),GetLocationX(Ie),GetLocationY(Ie))
call Bcc(JL,0.,600,Ie,$1C3A90,1.,1.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
if GetUnitAbilityLevel(RN,$41393033)>0 then
call Bcb(JL,RN,GetUnitStateSwap(UNIT_STATE_MAX_LIFE,RN)*.45,1.,1.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
endif
endif
call RemoveLocation(Ie)
set JI=null
set JL=null
set RN=null
set Ie=null
endfunction
