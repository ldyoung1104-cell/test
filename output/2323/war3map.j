if GetOwningPlayer(GetSpellTargetUnit())==Player(JG) then
call SetPlayerState(Player(JG),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(Player(JG),PLAYER_STATE_RESOURCE_LUMBER)+16)
call DisplayTimedTextToPlayer(Player(JG),0,0,5,"|cff04ffc4[알림]|r 자신의 유닛에게 사용해 즉시 |cff7ad82316 목재|r를 획득했습니다.")
call UnitRemoveAbility(GetTriggerUnit(),$41304C51)
call UnitRemoveAbility(GetTriggerUnit(),$41304F56)
return
endif
if not (GetUnitAbilityLevel(GetSpellTargetUnit(),$41304239)==1) and not (GetUnitAbilityLevel(GetSpellTargetUnit(),$41313754)==1) and not (GetUnitAbilityLevel(GetSpellTargetUnit(),$41303947)==1) and not (GetUnitAbilityLevel(GetSpellTargetUnit(),$41304242)==1) and not (GetUnitAbilityLevel(GetSpellTargetUnit(),$41304241)==1) and not (GetUnitAbilityLevel(GetSpellTargetUnit(),$41304238)==1) then
call DisplayTimedTextToPlayer(Player(JG),0,0,5,"|cffff0000[오류]|r 희귀 등급 이하 유닛에게만 사용 가능합니다.")
call UnitRemoveAbility(GetTriggerUnit(),$41304C51)
call UnitAddAbility(GetTriggerUnit(),$41304C51)
