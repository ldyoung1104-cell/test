call BdD(RN)
call BIY(JG,Vx)
set EN=Vu
set JS=Vv
if Pr==2 then
call DisplayTimedTextToPlayer(Cl,0,0,5,"버기 |cff00ff002개|r로 분해 !")
else
call DisplayTimedTextToPlayer(Cl,0,0,5,"버기 |cff00ff003개|r로 분해 !")
endif
loop
exitwhen EK>=Pr
set Vr=CreateUnit(Cl,Vx,EN,JS,bj_UNIT_FACING)
call IssueImmediateOrder(Vr,"holdposition")
if Vw[JG] then
call UnitAddAbility(Vr,$4130544A)
else
call UnitAddAbility(Vr,$41303759)
endif
set EK=EK+1
endloop
set RN=null
set Cl=null
set Vr=null
endfunction
