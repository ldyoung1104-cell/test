endfunction
function BjT takes integer K7 returns nothing
local integer JG=GetPlayerId(DzGetTriggerUIEventPlayer())
if K7==0 then
if R9[JG] then
if GetLocalPlayer()==DzGetTriggerUIEventPlayer() then
call DzFrameShow(SB,false)
endif
set R9[JG]=false
else
if GetLocalPlayer()==DzGetTriggerUIEventPlayer() then
call DzFrameShow(SB,true)
endif
set R9[JG]=true
endif
else
if GetLocalPlayer()==DzGetTriggerUIEventPlayer() then
call DzSyncData(SC,I2S(K7))
endif
endif
endfunction
function BjV takes integer DT returns nothing
