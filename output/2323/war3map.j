function Bri takes nothing returns nothing
local unit JL=GetAttacker()
local unit RN=GetTriggerUnit()
local unit JI
local location Id=GetUnitLoc(JL)
local location Ie=GetUnitLoc(RN)
local player RT=GetOwningPlayer(JL)
call Bcb(JL,RN,11500,1,1,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
if BFi(1,100)<=14 then
call SetUnitAnimation(JL,"spell")
set JI=CreateUnitAtLoc(HY,$65303342,Id,GetUnitFacing(JL))
call SetUnitAnimationByIndex(JI,0)
set JI=CreateUnitAtLoc(HY,$65303349,Ie,GetUnitFacing(JL))
call Bcc(JL,0,350,Ie,80000,1.,1.5,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
if not Bdi(RN) and not (GetUnitAbilityLevel(RN,$41393033)>0) and not (GetUnitAbilityLevel(RN,$41393034)>0) then
call Bcb(JL,RN,GetUnitState(RN,UNIT_STATE_LIFE)*.2*(.79+.01*I2R(GetUnitAbilityLevel(RN,JD))),1,1,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_UNIVERSAL)
else
call Bcb(JL,RN,150000,1,1,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
endif
endif
call RemoveLocation(Id)
call RemoveLocation(Ie)
set RT=null
set JI=null
set JL=null
set RN=null
set Id=null
set Ie=null
endfunction
