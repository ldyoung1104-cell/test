call SetTextTagPos(NC,GetUnitX(NB),GetUnitY(NB),20)
call SetTextTagColor(NC,139,189,255,255)
call SetTextTagPermanent(NC,true)
call SetTextTagVisibility(NC,true)
endfunction
function BeT takes nothing returns nothing
set M8=CreateTrigger()
call BKD(M8)
call TriggerAddAction(M8,function BeR)
endfunction
function BeU takes integer Nk returns string
if Nk<1 or Nk>Nl then
return ""
endif
return "Emoji\\emote"+I2S(Nk)+".blp"
endfunction
function BeV takes integer JG returns string
return Ld[JG]+BFy(KT[JG])+"|r"
endfunction
function BeX takes integer NY,integer M2 returns nothing
endfunction
function BeY takes integer NY,integer Mk returns nothing
endfunction
function BeZ takes integer NY returns nothing
endfunction
function Bea takes integer JG returns nothing
if OE[JG] then
call DzFrameSetTexture(Nv[JG],"Interface\\GrayBackGround_DashBoard.tga",0)
call BeX(Nv[JG],235)
call DzFrameSetText(N6[JG],"|cffff6060OFF|r")
else
call DzFrameSetTexture(Nv[JG],"Interface\\BlackBackGround.tga",0)
call BeX(Nv[JG],205)
call DzFrameSetText(N6[JG],"|cff80ff80ON|r")
endif
endfunction
function Beb takes nothing returns nothing
local integer NY=DzGetTriggerUIEventFrame()
if NY!=0 then
call DzFrameSetEnable(NY,false)
call DzFrameSetEnable(NY,true)
endif
endfunction
function Bec takes integer JG,boolean NV returns nothing
if GetLocalPlayer()==Player(JG) then
call DzFrameShow(NW,NV)
endif
set NX[JG]=NV
endfunction
function Bed takes integer OF returns boolean
return OF==1 or OF==3
endfunction
function Bee takes integer OF returns real
if Bed(OF) then
return 1920.-Ox-OO*.5
endif
return Ox+OO*.5
endfunction
function Bef takes integer OF returns real
if OF>=2 then
return 1080.*Ot
endif
return 1080.*Ou
endfunction
function Beh takes integer OF returns nothing
local real Ov=Bef(OF)
local real Oy=Ov-OP*.5-Op-4.
call DzFrameClearAllPoints(OK[OF])
if Bed(OF) then
call DzFrameSetPoint(OK[OF],Ow,NM,Ow,-Ox*1./Kx*Ky,-(Oy*1.)/Kz*K0)
else
call DzFrameSetPoint(OK[OF],0,NM,0,Ox*1./Kx*Ky,-(Oy*1.)/Kz*K0)
endif
call DzFrameClearAllPoints(OL[OF])
call DzFrameSetPoint(OL[OF],0,OK[OF],0,0*1./Kx*Ky,-(0*1.)/Kz*K0)
call DzFrameClearAllPoints(OJ[OF])
call DzFrameSetPoint(OJ[OF],K4,NM,K1,Bee(OF)*1./Kx*Ky,-(Ov*1.)/Kz*K0)
endfunction
function Bei takes integer OF returns nothing
call PauseTimer(Oq[OF])
call PauseTimer(Os[OF])
if OJ[OF]!=0 then
call DzFrameShow(OJ[OF],false)
endif
if OK[OF]!=0 then
call DzFrameShow(OK[OF],false)
endif
if OL[OF]!=0 then
call DzFrameShow(OL[OF],false)
endif
endfunction
function Bel takes real HS returns real
if HS<0. then
return 0.
else
if HS>1. then
return 1.
endif
endif
return HS
endfunction
function Bem takes real Hv,real Hw,real Db returns real
return Hv+(Hw-Hv)*Bel(Db)
endfunction
function Ben takes real OQ returns real
local real OM=1.
local real OT=OR+OS
local real OW=OT+OU+OV
local real Of=OW+OX
local real Oc=OY-(OZ+Oa+Ob)
local real Og=Oc+OZ+Oa
if OQ<=OR then
set OM=Bem(0.,Od,OQ/OR)
elseif OQ<=OT then
set OM=Bem(Od,1.,(OQ-OR)/OS)
elseif OQ<=OT+OU then
set OM=1.
elseif OQ<=OW then
set OM=Bem(1.,Oe,(OQ-(OT+OU))/OV)
elseif OQ<=Of then
set OM=Bem(Oe,1.,(OQ-OW)/OX)
elseif OQ<=Oc then
set OM=1.
elseif OQ<=Oc+OZ then
set OM=Bem(1.,Od,(OQ-Oc)/OZ)
elseif OQ<=Og then
set OM=Od
else
set OM=Bem(Od,0.,(OQ-Og)/Ob)
endif
if OM<0. then
set OM=0.
endif
return OM
endfunction
function Beo takes real OQ returns real
local real OT=OR+OS
local real Oc=OY-(OZ+Oa+Ob)
local real Oi=Oc+OZ
local real Og=Oi+Oa
if OQ<=OT then
return Bem(0.,1.,OQ/OT)
endif
if OQ<=Oc then
return 1.
endif
if OQ<=Oi then
return Bem(1.,Oj,(OQ-Oc)/OZ)
endif
if OQ<=Og then
return Oj
endif
return Bem(Oj,0.,(OQ-Og)/Ob)
endfunction
function Bep takes integer OF,real OM,real ON returns nothing
local integer M2=R2I(255.*Bel(ON))
call DzFrameSetSize(OJ[OF],OO*OM*1./Kx*Ky,OP*OM*1./Kz*K0)
call DzFrameSetAlpha(OJ[OF],M2)
endfunction
function Beq takes integer OF returns nothing
local integer OI=OH[OF]
if OI<=0 then
call DzFrameShow(OJ[OF],false)
call DzFrameShow(OK[OF],false)
call DzFrameShow(OL[OF],false)
elseif OE[OI-1] then
call DzFrameShow(OJ[OF],false)
call DzFrameShow(OK[OF],false)
call DzFrameShow(OL[OF],false)
else
call Bep(OF,Ben(Oh[OF]),Beo(Oh[OF]))
call DzFrameShow(OK[OF],false)
call DzFrameShow(OL[OF],false)
call DzFrameShow(OJ[OF],true)
endif
endfunction
function Ber takes nothing returns nothing
local integer OF=0
loop
exitwhen OF>=OG
if OH[OF]>0 then
call Beh(OF)
call Beq(OF)
endif
set OF=OF+1
endloop
endfunction
function Bes takes integer JG returns nothing
local integer OF=0
loop
exitwhen OF>=OG
if OH[OF]==JG+1 then
call Beq(OF)
endif
set OF=OF+1
endloop
endfunction
function Bet takes integer JG returns nothing
if JG<0 or JG>=Nu then
return
endif
if OE[JG] then
return
endif
if Ok[JG]==null then
return
endif
call StopSound(Ok[JG],false,false)
call StartSound(Ok[JG])
endfunction
function Beu takes nothing returns nothing
local integer OF=LoadInteger(De,0,GetHandleId(GetExpiredTimer()))
set Oh[OF]=Oh[OF]+O1
call Bep(OF,Ben(Oh[OF]),Beo(Oh[OF]))
endfunction
function Bev takes nothing returns nothing
local integer OF=LoadInteger(De,0,GetHandleId(GetExpiredTimer()))
call Bei(OF)
set OH[OF]=0
endfunction
function Bew takes integer JG,integer Nk returns nothing
local integer OF=JG
local string O0=BeU(Nk)
if OF<0 or OF>=OG then
return
endif
if O0=="" then
return
endif
call Bei(OF)
set OH[OF]=0
set OH[OF]=JG+1
set Oh[OF]=0.
call DzFrameSetText(OL[OF],BeV(JG))
call DzFrameSetTexture(OJ[OF],O0,0)
call Ber()
call Bep(OF,0.,0.)
call Beq(OF)
call Bet(JG)
call TimerStart(Oq[OF],O1,true,function Beu)
call TimerStart(Os[OF],OY,false,function Bev)
endfunction
function Bex takes nothing returns nothing
local integer JG=GetPlayerId(DzGetTriggerUIEventPlayer())
local integer OD=LoadInteger(K6,0,DzGetTriggerUIEventFrame())
if GetLocalPlayer()==Player(JG) then
set OE[OD]=not OE[OD]
call Bea(OD)
call Bes(OD)
call Beb()
endif
endfunction
function Bey takes nothing returns nothing
local integer JG=GetPlayerId(DzGetTriggerUIEventPlayer())
call Bec(JG,not NX[JG])
if GetLocalPlayer()==Player(JG) then
