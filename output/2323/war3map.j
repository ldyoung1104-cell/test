set ZB=ZB+2
endif
if ModuloInteger(ZB,10)==0 and ZB<=50 then
set ZB=ZB+1
endif
call Bvi(GetUnitAbilityLevelSwapped($41393031,Y7)-1,ZB,Y8)
endif
set EK=EK+1
endloop
set Y7=null
endfunction
