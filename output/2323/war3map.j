call SetUnitScale(LoadUnitHandle(E2,0,DR*EM+10),(100.+I2R(LoadInteger(FP,0,DR*EM+6))*5.)*.01,(100.+I2R(LoadInteger(FP,0,DR*EM+6))*5.)*.01,(100.+I2R(LoadInteger(FP,0,DR*EM+6))*5.)*.01)
call BST(DR,10,CreateUnitAtLoc(HY,$65304138,LoadLocationHandle(E9,0,DR*EM+2),LoadReal(FW,0,DR*EM+0)))
