function B5q takes nothing returns nothing
local unit RN=GetTriggerUnit()
local player RT=GetOwningPlayer(RN)
local integer dR
if GetPlayerState(RT,PLAYER_STATE_RESOURCE_FOOD_USED)<4 then
call DisplayTimedTextToPlayer(RT,0,0,5,"|cffff0000[오류]|r|cff1e90ff특성포인트|r가 부족합니다!")
call IssueImmediateOrder(RN,"stop")
return
endif
call DisplayTimedTextToPlayer(RT,0,0,5,"|cffffcc00퀵 파켓을 사용해 '알라바스타 건'을 강화합니다.|r")
call IncUnitAbilityLevel(RN,I4)
set dR=GetUnitAbilityLevel(RN,I4)
if dR==3 then
call IncUnitAbilityLevel(RN,I7)
elseif dR==5 then
call UnitAddAbility(RN,dS)
elseif dR==7 then
call IncUnitAbilityLevel(RN,dP)
elseif dR==10 then
call SetUnitAbilityLevel(RN,dS,2)
call SetPlayerAbilityAvailable(RT,$41304C44,false)
endif
call UnitRemoveAbility(RN,dT)
call SetPlayerState(RT,PLAYER_STATE_RESOURCE_FOOD_USED,GetPlayerState(RT,PLAYER_STATE_RESOURCE_FOOD_USED)-4)
set RT=null
set RN=null
endfunction
