function CEb takes nothing returns nothing
local integer Cl
local unit RN=GetTriggerUnit()
local unit JI
local location Ie=GetUnitLoc(RN)
set JI=CreateUnitAtLoc(HY,$6530344E,Ie,bj_UNIT_FACING)
set JI=CreateUnitAtLoc(HY,$6530344C,Ie,bj_UNIT_FACING)
set JI=CreateUnitAtLoc(HY,$65303450,Ie,bj_UNIT_FACING)
call IssuePointOrderById(JI,OrderId("dreadlordinferno"),GetLocationX(Ie),GetLocationY(Ie))
set Cl=BiE()
call BiZ(Cl,600.,Ie,Condition(function CEV),function CEZ)
call BiF(Cl)
call RemoveLocation(Ie)
set RN=null
set JI=null
set Ie=null
endfunction
function CEc takes nothing returns nothing
local integer Cl
local unit JL=GetAttacker()
local unit RN=GetTriggerUnit()
local unit JI
local location Id=GetUnitLoc(JL)
local location Ie=GetUnitLoc(RN)
if not UnitHasBuffBJ(JL,$42303845) then
set JI=CreateUnitAtLoc(HY,$68304335,Id,GetUnitFacing(JL))
call UnitAddAbility(JI,$41303739)
call IssueTargetOrder(JI,"bloodlust",JL)
call CEb()
elseif GetUnitUserData(JL)>=11 then
call SetUnitUserData(JL,0)
call CEb()
else
if BFi(1,8)==1 then
call SetUnitUserData(JL,GetUnitUserData(JL)+1)
set JI=CreateUnitAtLoc(HY,$65303447,Ie,GetUnitFacing(JL)+180.)
call SetUnitFlyHeight(JI,100.,0)
call SetUnitVertexColor(JI,0,0,0,PercentTo255(100.))
set JI=CreateUnitAtLoc(HY,$6530344F,Ie,bj_UNIT_FACING)
set JI=CreateUnitAtLoc(HY,$6530344C,Ie,bj_UNIT_FACING)
set JI=CreateUnitAtLoc(HY,$6530344D,Ie,GetUnitFacing(JL))
call SetUnitTimeScale(JI,1.15)
set Cl=BiE()
call BiZ(Cl,500.,Ie,Condition(function CEV),function CEa)
call BiF(Cl)
endif
if not UnitHasBuffBJ(JL,$42303831) then
set JI=CreateUnitAtLoc(HY,$68304335,Id,GetUnitFacing(JL))
call UnitAddAbility(JI,$41313434)
call IssueTargetOrder(JI,"frostarmor",JL)
call TriggerExecute(f8)
endif
endif
call RemoveLocation(Id)
call RemoveLocation(Ie)
set JL=null
set RN=null
set JI=null
set Id=null
set Ie=null
endfunction
