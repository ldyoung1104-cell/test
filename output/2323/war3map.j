function BjJ takes integer JG returns nothing
if jM[JG]==null then
set jM[JG]=CreateLeaderboard()
call LeaderboardSetStyle(jM[JG],true,true,false,false)
endif
call PlayerSetLeaderboard(Player(JG),jM[JG])
endfunction
function BjK takes integer JG returns nothing
set jN[JG]=LeaderboardGetItemCount(jM[JG])
if jO[JG] then
call LeaderboardAddItem(jM[JG],"|cffffcc00[유틸리티 정보 - 수동 갱신]|r",0,Player(JG))
else
call LeaderboardAddItem(jM[JG],"|cffffcc00[유틸 갱신 버튼을 눌러주세요]|r",0,Player(JG))
endif
call LeaderboardAddItem(jM[JG],"방어력 감소 합계 : |cffffcc00"+R2SW(BII(JG),1,1)+"|r",0,Player(JG))
call LeaderboardAddItem(jM[JG],"발동형 방어력 감소 : |cffffcc00"+R2SW(jQ[JG],1,1)+"|r",0,Player(JG))
call LeaderboardAddItem(jM[JG],"오라형 이동속도 감소 : |cffffcc00"+R2SW(BIJ(JG),1,1)+"%|r",0,Player(JG))
call LeaderboardAddItem(jM[JG],"발동형 이동속도 감소 : |cffffcc00"+R2SW(jS[JG],1,1)+"%|r",0,Player(JG))
endfunction
function BjL takes integer JG returns nothing
local integer EK
call BIH(JG)
set jO[JG]=true
if jM[JG]!=null then
set EK=LeaderboardGetItemCount(jM[JG])-1
loop
exitwhen EK<jN[JG]
call LeaderboardRemoveItem(jM[JG],EK)
set EK=EK-1
endloop
call BjK(JG)
call LeaderboardSetSizeByItemCount(jM[JG],LeaderboardGetItemCount(jM[JG]))
endif
endfunction
function BjM takes integer JG,string oe returns nothing
call BjJ(JG)
call LeaderboardSetLabel(jM[JG],"유틸보드 - "+oe)
call LeaderboardClear(jM[JG])
call LeaderboardAddItem(jM[JG],"|cffffcc00[스토리 기여도]|r",0,Player(JG))
endfunction
function BjO takes integer JG returns nothing
call BjK(JG)
call LeaderboardSetSizeByItemCount(jM[JG],LeaderboardGetItemCount(jM[JG]))
if GetLocalPlayer()==Player(JG) then
call LeaderboardDisplay(jM[JG],LU[JG])
endif
endfunction
function BjP takes integer JG returns nothing
call BjJ(JG)
call LeaderboardSetLabel(jM[JG],"유틸보드")
call LeaderboardClear(jM[JG])
call LeaderboardAddItem(jM[JG],"|cffaaaaaa현재 진행 중인 스토리 기여도 없음|r",0,Player(JG))
call BjK(JG)
call LeaderboardSetSizeByItemCount(jM[JG],LeaderboardGetItemCount(jM[JG]))
if GetLocalPlayer()==Player(JG) then
call LeaderboardDisplay(jM[JG],LU[JG])
endif
endfunction
function BjQ takes integer JG returns nothing
if jM[JG]!=null and GetLocalPlayer()==Player(JG) then
call LeaderboardDisplay(jM[JG],false)
endif
endfunction
function BjR takes integer K7 returns nothing
endfunction
