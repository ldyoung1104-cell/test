function Blg takes integer K7 returns nothing
local integer JG=GetPlayerId(DzGetTriggerUIEventPlayer())
local integer Tn
local integer EK
if K7<=5 then
if GetLocalPlayer()==Player(JG) then
call DzFrameShow(Si,false)
call DzFrameShow(Sl,false)
call DzFrameShow(Sj,false)
call DzFrameShow(Ss,false)
call DzFrameShow(Sr,false)
call DzFrameShow(Sq,true)
set EK=1
loop
exitwhen EK>40
set TY[EK]=LoadInteger(TZ,K7,EK)
if TY[EK]==0 then
call DzFrameShow(Ta[EK],false)
else
call DzFrameSetTexture(Ta[EK],LoadStr(TP,0,TY[EK]),0)
call DzFrameSetText(Tb[EK],I2S(LoadInteger(RH,Tc[JG],TY[EK]))+"회")
call DzFrameShow(Ta[EK],true)
endif
set EK=EK+1
endloop
endif
elseif K7<=14 then
if GetLocalPlayer()==Player(JG) then
call DzFrameShow(Sl,false)
call DzFrameShow(Sj,false)
call DzFrameShow(Si,true)
if K7==6 then
set Td=Td+Te
elseif K7==7 then
set Td=Td+Tf
elseif K7==8 then
set Td=Td+Tg
elseif K7==9 then
set Td=Td+Th
elseif K7==10 then
set Td=Td+Ti
elseif K7==11 then
set Td=Td+Tj
elseif K7==12 then
set Td=Td+Tk
elseif K7==13 then
set Td=Td+Tl
elseif K7==14 then
set Td=Td+Tm
endif
set Tn=To[Td]
set EK=1
loop
exitwhen EK>45
set TY[EK]=LoadInteger(TZ,Tn,EK)
if TY[EK]==0 then
call DzFrameShow(Tp[EK],false)
else
call DzFrameSetTexture(Tp[EK],LoadStr(TP,0,TY[EK]),0)
call DzFrameShow(Tp[EK],true)
call Bkq(JG)
endif
set EK=EK+1
endloop
endif
elseif K7<=19 then
if GetLocalPlayer()==Player(JG) then
set Tn=K7-14
set EK=1
loop
exitwhen EK>35
set TY[EK]=LoadInteger(TZ,Tn,EK)
if TY[EK]==0 then
call DzFrameShow(Ta[EK],false)
else
call DzFrameSetTexture(Ta[EK],LoadStr(TP,0,TY[EK]),0)
call DzFrameSetText(Tb[EK],I2S(LoadInteger(RH,Tc[JG],TY[EK]))+"회")
call DzFrameShow(Ta[EK],true)
endif
set EK=EK+1
endloop
endif
endif
endfunction
