function B3c takes nothing returns nothing
local unit JL=GetAttacker()
local unit RN=GetTriggerUnit()
local unit JI
local location Id=GetUnitLoc(JL)
local location Ie=GetUnitLoc(RN)
local real XP=AngleBetweenPoints(Id,Ie)
local player RT=GetOwningPlayer(JL)
local unit XX=IG[GetPlayerId(RT)]
local integer ZX=17
local integer Ix=GetUnitCurrentOrder(JL)
if $48304245==GetUnitTypeId(JL) or $48304330==GetUnitTypeId(JL) then
set ZX=25
endif
call TriggerExecute(cT)
if GetUnitStateSwap(UNIT_STATE_LIFE,JL)>=95. then
call SetUnitState(JL,UNIT_STATE_LIFE,1)
set JI=CreateUnitAtLoc(RT,$6830355A,Id,bj_UNIT_FACING)
call IssueImmediateOrderById(JL,OrderId("metamorphosis"))
call BdH(JL,RN,Ix)
if GetUnitAbilityLevel(JL,$41313241)>=2 then
call TriggerExecute(cU)
else
call TriggerExecute(cV)
endif
else
call SetUnitState(JL,UNIT_STATE_LIFE,GetUnitStateSwap(UNIT_STATE_LIFE,JL)+1)
endif
if BFi(1,100)<ZX then
call IssueTargetOrderById(cW[GetPlayerId(RT)],OrderId("bloodlust"),JL)
endif
if BFi(1,100)<=30 then
call IssueTargetOrder(cW[GetPlayerId(RT)],"firebolt",RN)
