local integer Vx
local unit JI
call BdD(GetSoldUnit())
call SetPlayerState(RT,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(RT,PLAYER_STATE_RESOURCE_GOLD)+30)
if BFi(1,1000)<=10 then
set EN=GetPlayerStartLocationX(RT)
set JS=GetPlayerStartLocationY(RT)
set JI=CreateUnit(RT,$68303630,EN,JS,bj_UNIT_FACING)
call DisplayTextToPlayer(RT,0,0,"물품 지원으로 "+GetUnitName(JI)+" 획득!")
return
endif
if BFi(1,100)<=50 then
set Vx=jY[BFi(1,9)]
call BIY(JG,Vx)
set EN=Vu
set JS=Vv
set JI=CreateUnit(RT,Vx,EN,JS,bj_UNIT_FACING)
call IssueImmediateOrder(JI,"holdposition")
if Vw[JG] then
call UnitAddAbility(JI,$4130544A)
else
call UnitAddAbility(JI,$41303759)
endif
else
set Vx=jZ[BFi(0,12)]
set EN=GetRectCenterX(Lq[JG])
set JS=GetRectCenterY(Lq[JG])
set JI=CreateUnit(RT,Vx,EN,JS,bj_UNIT_FACING)
call IssueImmediateOrder(JI,"holdposition")
endif
call DisplayTextToPlayer(RT,0,0,"물품 지원으로 "+GetUnitName(JI)+" 획득!")
set JI=null
endfunction
function CJW takes nothing returns nothing
if Bdi(GetSpellTargetUnit()) or GetUnitAbilityLevel(GetSpellTargetUnit(),$41393034)>0 or GetUnitAbilityLevel(GetSpellTargetUnit(),$41393033)>0 then
call IssueImmediateOrder(GetTriggerUnit(),"stop")
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,3,"흡수는 일반유닛에게만 사용 가능합니다")
call SetUnitState(GetTriggerUnit(),UNIT_STATE_MANA,(GetUnitState(GetTriggerUnit(),UNIT_STATE_MANA)+90)*1.)
return
else
call BdD(GetSpellTargetUnit())
endif
endfunction
function CJY takes integer JG,integer hP,integer Hk returns nothing
local integer R2=LoadInteger(R3,hP,Hk)
local integer EK=0
local integer Pr
local integer Rf=LoadInteger(Wb,R2,We)
local integer hT
local integer hU
local integer hV
local unit Cm
loop
exitwhen EK>=Rf
set hT=LoadInteger(Wq,R2,EK)
set hU=LoadInteger(Wr,R2,EK)
set hV=LoadInteger(Ws,R2,EK)
if hT==$554E4954 then
set Pr=0
loop
exitwhen Pr>=hV
set Cm=CreateUnit(Player(JG),hU,GetPlayerStartLocationX(Player(JG)),GetPlayerStartLocationY(Player(JG)),bj_UNIT_FACING)
call IssueImmediateOrder(Cm,"holdposition")
if IsUnitType(Cm,UNIT_TYPE_UNDEAD) then
call UnitAddAbility(Cm,$41303759)
endif
call DisplayTimedTextToPlayer(Player(JG),0,0,5,GetUnitName(Cm)+" 획득!")
set Pr=Pr+1
endloop
endif
set EK=EK+1
endloop
set Cm=null
endfunction
function CJZ takes nothing returns nothing
local integer JG=GetPlayerId(GetTriggerPlayer())
local integer hP=GetUnitTypeId(GetSpellTargetUnit())
local integer EK=0
local integer Rf=LoadInteger(R3,hP,-1)
if GetOwningPlayer(GetSpellTargetUnit())!=Player(JG) then
call DisplayTimedTextToPlayer(Player(JG),0,0,5,"자신의 유닛에만 사용할 수 있습니다.")
call Bcs(GetTriggerUnit(),100)
return
endif
if GetUnitAbilityLevel(GetSpellTargetUnit(),$41304241)<=0 and GetUnitTypeId(GetSpellTargetUnit())!=$68303143 and GetUnitTypeId(GetSpellTargetUnit())!=$68303135 and GetUnitAbilityLevel(GetSpellTargetUnit(),$41304239)<=0 then
call DisplayTimedTextToPlayer(Player(JG),0,0,5,"|cffff0000[오류]|r 연금술은 '특별' 또는 '희귀' 유닛에게만 사용 가능합니다.")
call Bcs(GetTriggerUnit(),100)
return
endif
call BdD(GetSpellTargetUnit())
call DisplayTimedTextToPlayer(Player(JG),0,0,5,"|cffFFB2F5[연금술]|r 분해 완료!")
loop
exitwhen EK>=Rf
call CJY(JG,hP,EK)
set EK=EK+1
endloop
endfunction
function CJb takes nothing returns nothing
