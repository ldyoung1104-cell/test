call SetUnitScale(LoadUnitHandle(E2,0,DR*EM+10),BFj(135.,155.)*.01,1,1)
call BST(DR,10,CreateUnitAtLoc(HY,$65303737,LoadLocationHandle(E9,0,DR*EM+1),GetRandomDirectionDeg()))
call SetUnitScale(LoadUnitHandle(E2,0,DR*EM+10),BFj(130.,150.)*.01,1,1)
call BST(DR,10,CreateUnitAtLoc(HY,$65303738,LoadLocationHandle(E9,0,DR*EM+1),GetRandomDirectionDeg()))
call SetUnitScale(LoadUnitHandle(E2,0,DR*EM+10),BFj(75.,95.)*.01,1,1)
call BST(DR,10,CreateUnitAtLoc(HY,$65303739,LoadLocationHandle(E9,0,DR*EM+1),GetRandomDirectionDeg()))
call SetUnitScale(LoadUnitHandle(E2,0,DR*EM+10),BFj(70.,90.)*.01,1,1)
call BJ5(DR,.1,1)
endif
