function CQ5 takes nothing returns nothing
local unit JL=GetEventDamageSource()
local unit RN=GetTriggerUnit()
local player RT=GetOwningPlayer(JL)
local real oY=GetUnitStateSwap(UNIT_STATE_MAX_LIFE,RN)
local real oj
local real ok
if not r7 then
set r7=true
call TimerStart(r8,.25,true,function CQ4)
endif
if sD!=oY then
set sD=oY
if r9<oY then
set r9=oY
else
set sE=sE*(oY/r9)
set r9=oY
endif
endif
set sE=sE+GetEventDamage()
if GetUnitStateSwap(UNIT_STATE_MAX_LIFE,RN)>=sE then
if GetPlayerController(RT)==MAP_CONTROL_USER then
set sC[GetPlayerId(RT)]=sC[GetPlayerId(RT)]+GetEventDamage()
else
set sC[GetUnitUserData(JL)]=sC[GetUnitUserData(JL)]+GetEventDamage()
endif
else
set oj=sE-oY
set ok=GetEventDamage()-oj
if GetPlayerController(RT)==MAP_CONTROL_USER then
set sC[GetPlayerId(RT)]=sC[GetPlayerId(RT)]+ok
else
set sC[GetUnitUserData(JL)]=sC[GetUnitUserData(JL)]+ok
endif
endif
set JL=null
set RN=null
set RT=null
endfunction
