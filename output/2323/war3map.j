function BoB takes nothing returns nothing
local integer Cl
call BJ7(0)
if HR[DR]==0 then
call BST(DR,0,GetAttacker())
call BST(DR,1,GetTriggerUnit())
call BTV(DR,0,GetUnitLoc(LoadUnitHandle(E2,0,DR*EM+0)))
call BTV(DR,1,GetUnitLoc(LoadUnitHandle(E2,0,DR*EM+1)))
call BWT(DR,0,AngleBetweenPoints(LoadLocationHandle(E9,0,DR*EM+1),LoadLocationHandle(E9,0,DR*EM+0)))
call BVU(DR,10,GetUnitCurrentOrder(LoadUnitHandle(E2,0,DR*EM+0)))
call EXPauseUnit(LoadUnitHandle(E2,0,DR*EM+0),true)
call SetUnitTimeScale(LoadUnitHandle(E2,0,DR*EM+0),1.72)
call SetUnitAnimation(LoadUnitHandle(E2,0,DR*EM+0),"attack slam")
call BJ3(DR,.29)
elseif HR[DR]==1 then
set bj_lastPlayedSound=BHD("SE\\swordeffect.wav",null,127,1,true,2000,2500)
call StopSound(bj_lastPlayedSound,false,false)
call BHH(LoadUnitHandle(E2,0,DR*EM+0),bj_lastPlayedSound)
call BST(DR,10,CreateUnitAtLoc(HY,$65303051,LoadLocationHandle(E9,0,DR*EM+1),LoadReal(FW,0,DR*EM+0)))
call BST(DR,10,CreateUnitAtLoc(HY,$65303051,LoadLocationHandle(E9,0,DR*EM+1),LoadReal(FW,0,DR*EM+0)))
call BST(DR,10,CreateUnitAtLoc(HY,$65303052,LoadLocationHandle(E9,0,DR*EM+1),LoadReal(FW,0,DR*EM+0)))
call SetUnitTimeScale(LoadUnitHandle(E2,0,DR*EM+10),2)
set Cl=BiE()
call BiZ(Cl,450,LoadLocationHandle(E9,0,DR*EM+1),Condition(function Bn8),function Bn9)
call BiF(Cl)
if GetUnitAbilityLevel(LoadUnitHandle(E2,0,DR*EM+1),$41393034)>0 then
call Bcb(LoadUnitHandle(E2,0,DR*EM+0),LoadUnitHandle(E2,0,DR*EM+1),5000,1.,1.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
endif
call BJ3(DR,.45)
elseif HR[DR]==2 then
call SetUnitTimeScale(LoadUnitHandle(E2,0,DR*EM+0),1.)
call EXPauseUnit(LoadUnitHandle(E2,0,DR*EM+0),false)
call BdH(LoadUnitHandle(E2,0,DR*EM+0),LoadUnitHandle(E2,0,DR*EM+1),LoadInteger(FP,0,DR*EM+10))
call BJx(DR)
endif
endfunction
