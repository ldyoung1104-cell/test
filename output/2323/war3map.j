function CJt takes nothing returns nothing
local integer Cl=BiE()
local unit Cm
local integer kl=0
local integer JG=GetPlayerId(GetTriggerPlayer())
local integer EK
call GroupEnumUnitsOfPlayer(Hp[Cl],GetTriggerPlayer(),Filter(function CJs))
set kl=Bib(Cl)
if kl<2 then
call DisplayTimedTextToPlayer(Player(JG),0,0,5,"|cffff8200기록지침 :: |r|ce32bb454[특성공학]|r에 필요한 |cffffd700랜덤위습|r이 부족합니다. 필요 개수 : |cffFF00002개|r")
