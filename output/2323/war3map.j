function BwW takes nothing returns nothing
local unit JL=GetAttacker()
local unit RN=GetTriggerUnit()
local integer JG=GetPlayerId(GetOwningPlayer(JL))
call SetUnitState(JL,UNIT_STATE_MANA,(GetUnitState(JL,UNIT_STATE_MANA)+1)*1.)
if BFi(1,400)<=57 then
if GetUnitAbilityLevel(JL,$41305338)==1 then
call BwN(JL,RN,true)
else
call BwN(JL,RN,false)
endif
endif
if GetUnitAbilityLevel(RN,Hl)-1>=50 then
if not UnitHasBuffBJ(JL,$4230355A) and GetUnitState(JL,UNIT_STATE_MANA)>=35 then
call SetUnitState(JL,UNIT_STATE_MANA,(GetUnitState(JL,UNIT_STATE_MANA)-33)*1.)
call IssueTargetOrder(ZQ[JG],"bloodlust",JL)
endif
if UnitHasBuffBJ(JL,$4230355A) then
call BwR(JL,RN)
elseif BFi(1,100)<=10 then
call BwU(JL,RN)
endif
