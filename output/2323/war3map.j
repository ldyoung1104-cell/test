function Bi4 takes nothing returns nothing
local integer Kr=DzGetGameUI()
local integer Rr
local integer Rt
local integer Ru
local integer Rv
local integer EK
local integer Rf
call DzLoadToc("war3mapImported\\ORDRTemplates.toc")
call Bi2(0,Kr,60,60,370,48,false)
call Bi1(0,"ReplaceableTextures\\CommandButtons\\BTNSkillz.blp","")
call DzFrameShow(RY[0],false)
set Rc=BDt(Kr,"PresentBoxRoot")
call DzFrameSetTexture(Rc,"Interface\\LogPoseBackGround.tga",0)
call DzFrameSetSize(Rc,800*1./Kx*Ky,650*1./Kz*K0)
call DzFrameSetPoint(Rc,K4,Kr,K4,0*1./Kx*Ky,-(-80*1.)/Kz*K0)
call DzFrameShow(Rc,false)
set Rr=BDu(Rc,"PresentBox_DashBoard","ORDRDashBoardPanel")
call DzFrameSetSize(Rr,740*1./Kx*Ky,120*1./Kz*K0)
call DzFrameSetPoint(Rr,0,Rc,0,30*1./Kx*Ky,-(30*1.)/Kz*K0)
set Rt=BD6(Rc,"PresentBoxRoot_name")
call DzFrameSetFont(Rt,"Fonts\\esamanruMedium.ttf",200*1.*K3,0)
call DzFrameSetPoint(Rt,Nr,Rc,Nr,0*1./Kx*Ky,-(40*1.)/Kz*K0)
call DzFrameSetText(Rt,"보상보관함")
set Ru=BD6(Rc,"PresentBoxRoot_text1")
call DzFrameSetFont(Ru,"Fonts\\esamanruMedium.ttf",20*1.*K3,0)
call DzFrameSetPoint(Ru,0,Rc,0,40*1./Kx*Ky,-(85*1.)/Kz*K0)
call DzFrameSetText(Ru,"◈ 플레이어가 받은 보상 목록을 확인할 수 있는 곳입니다")
set Rv=BD6(Rc,"PresentBoxRoot_text1")
call DzFrameSetFont(Rv,"Fonts\\esamanruMedium.ttf",20*1.*K3,0)
call DzFrameSetPoint(Rv,0,Rc,0,40*1./Kx*Ky,-(120*1.)/Kz*K0)
call DzFrameSetText(Rv,"◈ 맵 시작시 자동으로 보상이 수령되며, 데이터가 세이브 되면 보상이 확정 수령됩니다")
set EK=0
set Rf=20
loop
exitwhen EK>=Rf
if EK<10 then
call Bir(EK,Rc,40,165+EK*45)
else
call Bir(EK,Rc,410,165+(EK-10)*45)
endif
set EK=EK+1
endloop
call Bip(Rc,730,40)
call DzFrameSetTexture(Rx,"Interface\\LogPoseEscButtonOff.tga",0)
endfunction
