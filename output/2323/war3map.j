function BJH takes nothing returns nothing
local string X2=null
local timer Xv=GetExpiredTimer()
local integer Xw=GetHandleId(Xv)
local integer JG=LoadInteger(Xx,Xw,Xy)
local integer Xs=LoadInteger(Xx,Xw,Xz)
local unit Xt=LoadUnitHandle(Xx,Xw,X0)
local string QC=LoadStr(Xx,Xw,X1)
set X2="|cffdc143c[알람타이머]|r |cffFAED7D"+QC+"|r"
if Xt!=null then
if IsUnitType(Xt,UNIT_TYPE_HERO) then
set X2=X2+" : 기록지침"
else
set X2=X2+" : "+GetUnitName(Xt)
endif
endif
if LH[JG] then
if Xs==0 or X3<Xs then
call DisplayTimedTextToPlayer(Player(JG),0,0,5,X2)
call BHF(Player(JG),"Sound\\Interface\\QuestNew.wav","",127,1.)
endif
endif
call BHu(Xv)
call FlushChildHashtable(Xx,Xw)
set Xv=null
set Xt=null
endfunction
function BJI takes integer JG,integer Xs,real Kq,unit Xt,string QC returns nothing
local timer Xu=BHs(0)
local integer Xw
call TimerStart(Xu,Kq,false,function BJH)
set Xw=GetHandleId(Xu)
call SaveInteger(Xx,Xw,Xy,JG)
call SaveInteger(Xx,Xw,Xz,Xs)
if Xt!=null then
call SaveUnitHandle(Xx,Xw,X0,Xt)
endif
call SaveStr(Xx,Xw,X1,QC)
set Xu=null
endfunction
function BJJ takes nothing returns nothing
local integer EK=0
call BHu(GetExpiredTimer())
set Lw=true
loop
exitwhen EK>=bj_MAX_PLAYERS
if GetPlayerState(Player(EK),PLAYER_STATE_RESOURCE_GOLD)>0 then
call SetPlayerState(Player(EK),PLAYER_STATE_RESOURCE_GOLD,0)
set Lw=false
endif
if GetPlayerState(Player(EK),PLAYER_STATE_RESOURCE_LUMBER)>0 then
call SetPlayerState(Player(EK),PLAYER_STATE_RESOURCE_LUMBER,0)
set Lw=false
endif
set EK=EK+1
endloop
if Lw then
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,5,"현재 온라인입니다.")
else
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,5,"현재 싱글모드 입니다. 세이브/로드가 불가능합니다.")
endif
endfunction
