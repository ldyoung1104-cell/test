function CFW takes nothing returns nothing
local unit JL=GetAttacker()
local unit RN=GetTriggerUnit()
local unit JI
local location Id
if GetUnitStateSwap(UNIT_STATE_MANA,JL)==115. then
call TriggerExecute(gT)
call SetUnitState(JL,UNIT_STATE_MANA,0)
else
call SetUnitState(JL,UNIT_STATE_MANA,GetUnitStateSwap(UNIT_STATE_MANA,JL)+1)
endif
if BFi(1,16)==1 then
call ConditionalTriggerExecute(gU)
call SetUnitState(JL,UNIT_STATE_MANA,GetUnitStateSwap(UNIT_STATE_MANA,JL)+5)
endif
if BFi(1,100)<=25 then
call ConditionalTriggerExecute(gV)
call SetUnitState(JL,UNIT_STATE_MANA,GetUnitStateSwap(UNIT_STATE_MANA,JL)+5)
endif
if BFi(1,100)<=50 then
set Id=GetUnitLoc(JL)
set JI=CreateUnitAtLoc(HY,$6830344E,Id,GetUnitFacing(JL))
call SetUnitVertexColorBJ(JI,0.,25.,90.,25.)
call SetUnitFlyHeight(JI,160.,0.)
call SetUnitScale(JI,.72,1,1)
call IssueTargetOrder(gW[GetPlayerId(GetOwningPlayer(JL))],"firebolt",RN)
set JI=CreateUnitAtLoc(HY,$68303734,Id,GetUnitFacing(JL)+BFj(-25,25))
call SetUnitVertexColorBJ(JI,0.,25.,90.,0)
call SetUnitFlyHeight(JI,160.,0.)
call SetUnitScale(JI,.85,1,1)
call RemoveLocation(Id)
set Id=null
endif
set JL=null
set RN=null
set JI=null
endfunction
