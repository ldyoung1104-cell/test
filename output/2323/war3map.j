function Bln takes nothing returns nothing
local integer DT=LoadInteger(K6,0,DzGetTriggerUIEventFrame())
call DzFrameSetEnable(DzGetTriggerUIEventFrame(),false)
call DzFrameSetEnable(DzGetTriggerUIEventFrame(),true)
