call B_e(JL)
call IssueImmediateOrder(JL,"stop")
call IssueImmediateOrder(JL,"metamorphosis")
call TriggerExecute(Jv)
set JL=null
return
endif
endif
if GetUnitUserData(JL)>=10 then
call SetUnitUserData(JL,0)
call TriggerExecute(Jj)
else
if BFi(1,100)<=8 then
call TriggerExecute(Jw)
elseif BFi(1,100)<=15 then
call TriggerExecute(J0)
else
call TriggerExecute(J2)
endif
endif
endif
set JL=null
endfunction
