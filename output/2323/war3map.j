call SetSoundDistances(Hh,He,Hf)
call SetSoundDistanceCutoff(Hh,(He+Hf)/2)
call SetSoundConeAngles(Hh,0.,0.,127)
call SetSoundConeOrientation(Hh,0.,0.,0.)
else
set Hh=CreateSound(HZ,false,false,false,10,10,"DefaultEAXON")
call SetSoundDuration(Hh,Hg)
call SetSoundChannel(Hh,0)
call SetSoundVolume(Hh,Hb)
call SetSoundPitch(Hh,Hc)
