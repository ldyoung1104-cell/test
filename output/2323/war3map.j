function O30_UpTick takes nothing returns nothing
local integer O30_AI=0
local group O30_G
local unit O30_W
local player O30_P
loop
exitwhen O30_AI>=4
set O30_P=Player(O30_AI)
if O30_Up[O30_AI] then
set O30_G=GetUnitsOfPlayerAndTypeId(O30_P,YR)
set O30_W=FirstOfGroup(O30_G)
if O30_W!=null and O30_W!=O30_LastWisp[O30_AI] then
call KillUnit(O30_W)
set O30_LastWisp[O30_AI]=CreateUnit(O30_P,YR,-3456.,-9366.,bj_UNIT_FACING)
call IssueImmediateOrder(O30_LastWisp[O30_AI],"holdposition")
endif
call DestroyGroup(O30_G)
set O30_G=null
set O30_W=null
endif
set O30_AI=O30_AI+1
endloop
set O30_P=null
endfunction

function O30_UpChat takes nothing returns nothing
local player O30_P=GetTriggerPlayer()
local integer O30_ID=GetPlayerId(O30_P)
local string O30_Msg=GetEventPlayerChatString()
if O30_Msg=="@위" then
set O30_Up[O30_ID]=true
set O30_LastWisp[O30_ID]=null
call DisplayTextToPlayer(O30_P,0,0,"|cffffff80※ 위습이 자동으로 위로 이동합니다.")
elseif O30_Msg=="@취소" then
set O30_Up[O30_ID]=false
set O30_LastWisp[O30_ID]=null
call DisplayTextToPlayer(O30_P,0,0,"|cffffff80※ 위습 자동이동이 취소되었습니다.")
endif
set O30_P=null
endfunction

function O30_UpInit takes nothing returns nothing
local integer O30_AI=0
set O30_UpTrig=CreateTrigger()
loop
exitwhen O30_AI>=4
set O30_Up[O30_AI]=false
set O30_LastWisp[O30_AI]=null
call TriggerRegisterPlayerChatEvent(O30_UpTrig,Player(O30_AI),"@위",true)
call TriggerRegisterPlayerChatEvent(O30_UpTrig,Player(O30_AI),"@취소",true)
set O30_AI=O30_AI+1
endloop
call TriggerAddAction(O30_UpTrig,function O30_UpChat)
call TimerStart(CreateTimer(),0.20,true,function O30_UpTick)
endfunction

function MyCraft takes integer myKey returns boolean
call BIw()
set Q5=MyCurPlayer
set WS=myKey
call BI1(GetPlayerStartLocationX(MyCurPlayer),GetPlayerStartLocationY(MyCurPlayer))
set MyCraftOK=BI2()
return MyCraftOK
endfunction
function MyCntCb takes nothing returns nothing
if GetWidgetLife(GetEnumUnit())>.405 and not IsUnitType(GetEnumUnit(),UNIT_TYPE_DEAD) then
set MyTmpCnt=MyTmpCnt+1
endif
endfunction
function MyOwned takes integer myPid,integer myUt returns integer
if not HaveSavedHandle(VV,LZ[myPid],myUt) then
return 0
endif
set MyTmpCnt=0
call ForGroup(LoadGroupHandle(VV,LZ[myPid],myUt),function MyCntCb)
return MyTmpCnt
endfunction
function MyTabName takes integer myT returns string
if myT==0 then
return "안흔함(13)"
endif
if myT==1 then
return "희귀(43)"
endif
if myT==2 then
return "특별(33)"
endif
if myT==3 then
return "전설(39)"
endif
if myT==4 then
return "히든(22)"
endif
if myT==5 then
return "초월(30)"
endif
if myT==6 then
return "불멸(12)"
endif
if myT==7 then
return "영원(11)"
endif
if myT==8 then
return "신비(15)"
endif
if myT==9 then
return "제한(10)"
endif
if myT==10 then
return "왜곡(6)"
endif
if myT==11 then
return "변화(5)"
endif
if myT==12 then
return "특수(8)"
endif
if myT==13 then
return "세라핌(4)"
endif
if myT==14 then
return "랜덤전용(14)"
endif
if myT==15 then
return "미분류(1)"
endif
return ""
endfunction
