call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",LoadUnitHandle(E2,0,DR*EM+0),"origin"))
endif
if RectContainsUnit(BZ,LoadUnitHandle(E2,0,DR*EM+0))==false then
call SetUnitUserData(LoadUnitHandle(E2,0,DR*EM+0),0)
endif
if GetUnitFlyHeight(LoadUnitHandle(E2,0,DR*EM+0))>3. and GetUnitFlyHeight(LoadUnitHandle(E2,0,DR*EM+0))<16. then
call SetUnitFacingToFaceLocTimed(LoadUnitHandle(E2,0,DR*EM+0),LoadLocationHandle(E9,0,DR*EM+1),0)
else
call SetUnitX(LoadUnitHandle(E2,0,DR*EM+0),GetLocationX(LoadLocationHandle(E9,0,DR*EM+1)))
call SetUnitY(LoadUnitHandle(E2,0,DR*EM+0),GetLocationY(LoadLocationHandle(E9,0,DR*EM+1)))
endif
if GetUnitFlyHeight(LoadUnitHandle(E2,0,DR*EM+0))<=3. then
call SetUnitUserData(LoadUnitHandle(E2,0,DR*EM+0),0)
else
call SetUnitFlyHeight(LoadUnitHandle(E2,0,DR*EM+0),GetUnitFlyHeight(LoadUnitHandle(E2,0,DR*EM+0))-1,20000.)
endif
endif
call BJ2(DR,.03,1)
else
call BJx(DR)
endif
endif
endfunction
