endfunction
function CEW takes nothing returns boolean
return IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(LoadUnitHandle(E2,0,DR*EM+0)))==true
endfunction
function CEX takes nothing returns nothing
local unit RN=GetEnumUnit()
call Bd8(RN,3)
call Bcb(LoadUnitHandle(E2,0,DR*EM+0),RN,500000.,1.,1.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
set RN=null
endfunction
function CEY takes nothing returns nothing
local integer Cl
call BJ7(0)
if HR[DR]==0 then
call BST(DR,0,GetAttacker())
call BST(DR,1,GetTriggerUnit())
call BTV(DR,0,GetUnitLoc(LoadUnitHandle(E2,0,DR*EM+0)))
call BTV(DR,1,GetUnitLoc(LoadUnitHandle(E2,0,DR*EM+1)))
call BWT(DR,0,AngleBetweenPoints(LoadLocationHandle(E9,0,DR*EM+0),LoadLocationHandle(E9,0,DR*EM+1)))
call BOW(DR,3,CreateGroup())
call BVU(DR,6,0)
call BVU(DR,10,GetUnitCurrentOrder(LoadUnitHandle(E2,0,DR*EM+0)))
call EXPauseUnit(LoadUnitHandle(E2,0,DR*EM+0),true)
call SetUnitAnimation(LoadUnitHandle(E2,0,DR*EM+0),"spell one")
call BTV(DR,2,PolarProjectionBJ(LoadLocationHandle(E9,0,DR*EM+0),200.,LoadReal(FW,0,DR*EM+0)))
call BST(DR,2,CreateUnitAtLoc(HY,$65304D4C,LoadLocationHandle(E9,0,DR*EM+2),LoadReal(FW,0,DR*EM+0)))
call SetUnitAnimation(LoadUnitHandle(E2,0,DR*EM+2),"stand")
call SetUnitTimeScale(LoadUnitHandle(E2,0,DR*EM+2),1.2)
call BJ5(DR,.24,1)
elseif HR[DR]==1 then
call SetUnitAnimation(LoadUnitHandle(E2,0,DR*EM+2),"spell one")
set bj_lastPlayedSound=BHD("SE\\franky_beamsound.wav",null,127,1,true,1000,2200)
call BHH(LoadUnitHandle(E2,0,DR*EM+0),bj_lastPlayedSound)
call BJ5(DR,.01,1)
elseif HR[DR]==2 then
call BVU(DR,6,LoadInteger(FP,0,DR*EM+6)+1)
call BTV(DR,2,PolarProjectionBJ(LoadLocationHandle(E9,0,DR*EM+0),200.+110*I2R(LoadInteger(FP,0,DR*EM+6)-1),LoadReal(FW,0,DR*EM+0)))
call BST(DR,10,CreateUnitAtLoc(HY,$65304137,LoadLocationHandle(E9,0,DR*EM+2),LoadReal(FW,0,DR*EM+0)))
call SetUnitScale(LoadUnitHandle(E2,0,DR*EM+10),(50+2.5*I2R(LoadInteger(FP,0,DR*EM+6)))*.01,1,1)
call SetUnitFlyHeight(LoadUnitHandle(E2,0,DR*EM+10),180,0)
call UnitApplyTimedLife(LoadUnitHandle(E2,0,DR*EM+10),$42487765,.5)
if LoadInteger(FP,0,DR*EM+6)==4 then
call SetUnitAnimation(LoadUnitHandle(E2,0,DR*EM+2),"spell two")
call BST(DR,10,CreateUnitAtLoc(HY,$68304335,LoadLocationHandle(E9,0,DR*EM+1),LoadReal(FW,0,DR*EM+0)))
call UnitAddAbility(LoadUnitHandle(E2,0,DR*EM+10),$41313431)
call UnitApplyTimedLife(LoadUnitHandle(E2,0,DR*EM+10),$42487765,4)
set Cl=BiE()
call BiZ(Cl,725.,LoadLocationHandle(E9,0,DR*EM+1),Condition(function CEW),function CEX)
call BiF(Cl)
if Bdi(LoadUnitHandle(E2,0,DR*EM+1)) then
call Bcb(LoadUnitHandle(E2,0,DR*EM+0),LoadUnitHandle(E2,0,DR*EM+1),GetUnitState(LoadUnitHandle(E2,0,DR*EM+1),UNIT_STATE_MAX_LIFE)*.05,1,1,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
elseif GetUnitAbilityLevel(LoadUnitHandle(E2,0,DR*EM+1),$41393033)>0 then
call Bcb(LoadUnitHandle(E2,0,DR*EM+0),LoadUnitHandle(E2,0,DR*EM+1),GetUnitState(LoadUnitHandle(E2,0,DR*EM+1),UNIT_STATE_MAX_LIFE)*.3,1,1,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
endif
endif
if LoadInteger(FP,0,DR*EM+6)==8 then
call BJ2(DR,.1,3)
else
call BJ2(DR,.05,2)
endif
elseif HR[DR]==3 then
call KillUnit(LoadUnitHandle(E2,0,DR*EM+2))
call EXPauseUnit(LoadUnitHandle(E2,0,DR*EM+0),false)
call BdH(LoadUnitHandle(E2,0,DR*EM+0),LoadUnitHandle(E2,0,DR*EM+1),LoadInteger(FP,0,DR*EM+10))
call BJx(DR)
endif
endfunction
function CEZ takes nothing returns nothing
local unit JL=GetAttacker()
local unit RN=GetEnumUnit()
local real XK=(GetUnitState(RN,UNIT_STATE_MAX_LIFE)-GetUnitState(RN,UNIT_STATE_LIFE))*.04
call Bcb(JL,RN,$1312D0+XK,1.,1.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
set RN=null
set JL=null
endfunction
function CEa takes nothing returns nothing
