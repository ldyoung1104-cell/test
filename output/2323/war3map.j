function CG3 takes nothing returns nothing
local unit JL=GetAttacker()
local unit RN=GetTriggerUnit()
local unit JI
local location Id=GetUnitLoc(JL)
local location Ie=GetUnitLoc(RN)
local integer JG=GetPlayerId(GetOwningPlayer(JL))
call SetUnitState(JL,UNIT_STATE_MANA,GetUnitStateSwap(UNIT_STATE_MANA,JL)+1)
if GetUnitStateSwap(UNIT_STATE_MANA,JL)==100. then
call TriggerExecute(g5)
call SetUnitState(JL,UNIT_STATE_MANA,0)
endif
if BFi(1,100)<=12 then
call TriggerExecute(g6)
endif
if g7[JG]==1 then
if BFi(1,100)<=7 then
set bj_lastPlayedSound=BHD("SE\\SansAwaken.wav",null,100,1,true,1000,3000)
call BHH(JL,bj_lastPlayedSound)
set JI=CreateUnitAtLoc(HY,$6530504F,Ie,GetUnitFacing(JL))
call UnitApplyTimedLife(JI,$42487765,1.)
set JI=CreateUnitAtLoc(HY,$6530504F,Ie,GetUnitFacing(JL)+90)
call UnitApplyTimedLife(JI,$42487765,1.)
set JI=CreateUnitAtLoc(HY,$65305050,Ie,GetUnitFacing(JL))
call UnitApplyTimedLife(JI,$42487765,1.)
set JI=CreateUnitAtLoc(HY,$65305051,Ie,bj_UNIT_FACING)
call UnitApplyTimedLife(JI,$42487765,1.)
set JI=CreateUnitAtLoc(HY,$6530504B,Ie,bj_UNIT_FACING)
call UnitApplyTimedLife(JI,$42487765,1.)
call Bcb(JL,RN,$5F5E0FF,.1,1,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL)
endif
elseif GetUnitUserData(JL)>20 then
set JI=CreateUnitAtLoc(Player(JG),$68304335,Id,bj_UNIT_FACING)
call UnitAddAbility(JI,$41313059)
call UnitApplyTimedLife(JI,$42487765,5)
call IssueTargetOrderById(g8[JG],OrderId("sleep"),JL)
call SetUnitUserData(JL,0)
else
call SetUnitUserData(JL,GetUnitUserData(JL)+1)
endif
set JL=null
endfunction
function CG4 takes nothing returns nothing
set hD[1]="헤 헤 헤 헤..."
set hD[2]="뭔가 당황스러운 표정이군."
set hD[3]="우린 시공간의 연속성에 막대한 변칙이 있다는 걸 발견했어."
set hD[4]="넌 어떤 느낌일지 이해 못 할걸."
set hD[5]="이봐, 난 이미 되돌아가는 걸 포기했어."
set hD[6]="이제 말하는데, 난 약속을 싫어해."
set hD[7]="그냥 본론으로 들어가자구."
set hD[8]="좋아, 상대해줘서 고맙군."
set hD[9]="안녕. 꽤 바빴었지, 응?"
set hD[10]="야, 인상 펴, 인마!"
set hD[11]="나도 오늘은 뼈 빠지게 일했다구."
set hD[12]="와, 엄청 노력하는 것 같네... 뼛속까지 말이야."
set hD[13]="자, 여기까지 왔네."
set hD[14]="네가 해야 하는 일이 그렇게 가치 있는 일이야?"
set hD[15]="네 여정도 거의 끝난거지, 응?"
set hD[16]="뭐, 나 같으면 지금쯤 포기했을 거야."
set hD[17]="너에게는 의지라는 게 있으니까."
set hD[18]="넌, 음, 의지가 매우 강해. 그렇지?"
set hD[19]="자, 네 기분 알아, 친구"
set hD[20]="곧 지루해질거야."
set hD[21]="가장 나쁜 사람이라도 바뀔 수 있을까?"
set hD[22]="노력만 한다면 모두가 착한 사람이 될 수 있을까?"
set hD[23]="원하는 걸 얻고 나면 그 짓을 멈춰줄거라 생각했어."
set hD[24]="그래, 넌 절대 만족할 수 없는 부류잖아."
set hD[25]="넌 계속해서 시간을 허비하고 허비하겠지, 계속해서..."
set hD[26]="언젠가 적절한 시기에 그만두는 법을 배워야 할 거야."
set hD[27]="난 머리가 나쁜게 아니라 골이 빈거라구."
set hD[28]="널 정말로 응원하고 있어, 꼬맹이"
set hD[29]="우린 친구가 될 거라고 내심 기대했었거든"
endfunction
function CG5 takes string hC,unit Cm,integer JG returns nothing
set bj_lastCreatedTextTag=CreateTextTagUnitBJ(hC,Cm,8.,9.,100,100,100,15.)
call SetTextTagPermanent(bj_lastCreatedTextTag,false)
call SetTextTagLifespan(bj_lastCreatedTextTag,1.5)
call SetTextTagFadepoint(bj_lastCreatedTextTag,.45)
call SetTextTagVelocityBJ(bj_lastCreatedTextTag,45.,90)
call SetTextTagVisibility(bj_lastCreatedTextTag,GetLocalPlayer()==Player(JG))
endfunction
function CG6 takes integer JG,integer IC,unit JL returns nothing
if GetItemCharges(hB[JG])==30 then
return
endif
if GetItemCharges(hB[JG])+IC>=30 then
call SetItemCharges(hB[JG],30)
call SetPlayerTechResearched(Player(JG),$52303051,30)
else
call SetItemCharges(hB[JG],GetItemCharges(hB[JG])+IC)
call SetPlayerTechResearched(Player(JG),$52303051,GetItemCharges(hB[JG]))
endif
if GetItemCharges(hB[JG])>=30 and g7[JG]==0 then
set g7[JG]=1
call UnitAddAbility(JL,$4131305A)
call UnitAddAbility(JL,$41313131)
call UnitAddAbility(JL,$41313132)
call UnitRemoveAbility(JL,$41305842)
call UnitRemoveAbility(JL,$41305838)
call SetUnitAbilityLevel(JL,$41305841,2)
if GetLocalPlayer()==Player(JG) then
call SetCineFilterTexture("ReplaceableTextures\\CameraMasks\\Black_mask.blp")
call SetCineFilterBlendMode(BLEND_MODE_BLEND)
call SetCineFilterStartUV(0,0,2,2)
call SetCineFilterEndUV(0,0,2,2)
call SetCineFilterStartColor(255,255,255,255)
call SetCineFilterEndColor(255,255,255,0)
call SetCineFilterDuration(3)
call DisplayCineFilter(true)
endif
call BcH(Player(JG),"|cffff0000당신은 죄악이 등을 타고 오르는 것을 느꼈다|r",0,-50,0,3,3)
call StartSound(BHD("SE\\SansAwaken2.mp3",null,127,1.*1.,false,0,0))
else
call CG5(hD[BFi(1,29)],JL,JG)
call BHF(Player(JG),"SE\\SansTalker.wav",null,127,1)
endif
endfunction
function CG7 takes nothing returns nothing
local unit JL=GetTriggerUnit()
local unit RN=GetSpellTargetUnit()
local integer JG=GetPlayerId(GetOwningPlayer(JL))
local integer hC=GetUnitUserData(JL)
if GetUnitTypeId(RN)==$6830314E then
if g7[JG]==0 then
call BdD(RN)
endif
call CG6(JG,12,JL)
elseif GetUnitTypeId(RN)==$68303044 then
if g7[JG]==0 then
call BdD(RN)
endif
call CG6(JG,2,JL)
else
call CG5("|cffff0000너... 정말 미친 놈인가 보구나. 그렇지?|r",JL,JG)
endif
set JL=null
set RN=null
endfunction
function CG8 takes nothing returns nothing
call w5($68303833,function CG3)
call BC5(KH,$41313056,function CGy)
call BC5(KH,$41305843,function CG7)
call CG4()
call BKD(g5)
call TriggerAddAction(g5,function CG0)
call BKD(hF)
call TriggerAddAction(hF,function CGz)
call BKD(g6)
call TriggerAddAction(g6,function CG2)
endfunction
function CG9 takes integer JG returns unit
if hK[JG]==null then
set hK[JG]=CreateUnit(Player(JG),$68303456,GetPlayerStartLocationX(Player(JG)),GetPlayerStartLocationY(Player(JG)),bj_UNIT_FACING)
call UnitAddAbility(hK[JG],$4130504E)
call UnitAddAbility(hK[JG],$41313055)
call UnitAddAbility(hK[JG],$41305347)
endif
return hK[JG]
endfunction
function CHB takes nothing returns boolean
call BIw()
set Q5=GetOwningPlayer(GetSpellAbilityUnit())
call BI1(GetPlayerStartLocationX(GetOwningPlayer(GetSpellAbilityUnit())),GetPlayerStartLocationY(GetOwningPlayer(GetSpellAbilityUnit())))
set WS=GetSpellAbilityId()
call BIz(GetSpellAbilityUnit())
return BI2()
endfunction
function CHC takes nothing returns nothing
if not CHB() then
return
endif
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,10,"|cffdc143c한마 유지로 : |r|cff4FC9DE가르쳐 주지. 단련으로 성장을 실감했던 100년의 세월이 헛되기만 한 착각의 역사였다는 것을!|r")
call StartSound(BHD("SE\\Yujiro.mp3",null,127,1.*1.,false,0,0))
endfunction
function CHD takes real V1,real hL returns real
if V1>0 then
set V1=0
else
set V1=-V1
endif
return V1*hL+1.
endfunction
function CHE takes nothing returns boolean
return IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(LoadUnitHandle(E2,0,DR*EM+0)))
endfunction
function CHG takes nothing returns nothing
