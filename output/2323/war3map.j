local integer Up
local integer U5
call BHn(U0,",")
set TK=S2I(Rm[0])
set Up=S2I(Rm[1])
set U5=LoadInteger(L7,Up,L8)
if U4 and TK==$68303831 and Up==Ly[5] or Up==Ly[6] then
set U5=1
endif
if Sx[JG]<U5 then
call BcH(Player(JG),"|cffFF0000베리가 부족합니다.|r",VB,VC,0,VD,1)
else
set Sx[JG]=Sx[JG]-U5
call SaveInteger(Lx[JG],TK,Up,SX)
call BkB(Player(JG),TK)
call BCd(Player(JG))
call Bkq(JG)
endif
endfunction
