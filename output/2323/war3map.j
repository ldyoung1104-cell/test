function B3O takes nothing returns nothing
local unit JL=GetAttacker()
local unit RN=GetTriggerUnit()
local unit JI
local location Id=GetUnitLoc(JL)
local location Ie=GetUnitLoc(RN)
local real I0=GetUnitFacing(JL)
local player RT=GetOwningPlayer(JL)
local integer Ix=GetUnitCurrentOrder(JL)
call SetUnitState(JL,UNIT_STATE_LIFE,GetUnitStateSwap(UNIT_STATE_LIFE,JL)+1)
call UnitDamagePointLoc(JL,0.,215.,Ie,40000.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
if BFi(1,100)<=36 then
call IssueTargetOrder(cK[GetPlayerId(RT)],"firebolt",RN)
call Bcb(JL,RN,360000.,1.,1.,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL)
endif
if GetUnitStateSwap(UNIT_STATE_LIFE,JL)>=40. then
if GetUnitAbilityLevelSwapped($41313045,JL)==2 then
call SetUnitState(JL,UNIT_STATE_LIFE,1)
call TriggerExecute(cN)
else
call SetUnitState(JL,UNIT_STATE_LIFE,1)
call TriggerExecute(cO)
endif
endif
if BFi(1,100)<=10 then
if GetUnitAbilityLevelSwapped($41313045,JL)==2 then
call TriggerExecute(cP)
else
call TriggerExecute(cQ)
endif
endif
if BFi(1,1000)<=65 then
if GetItemCharges(cM[GetPlayerId(RT)])>=5 then
call TriggerExecute(cR)
call SetItemCharges(cM[GetPlayerId(RT)],0)
else
call TriggerExecute(cS)
call SetItemCharges(cM[GetPlayerId(RT)],GetItemCharges(cM[GetPlayerId(RT)])+1)
endif
endif
call RemoveLocation(Id)
call RemoveLocation(Ie)
set JL=null
set RN=null
set JI=null
set Id=null
set Ie=null
set RT=null
endfunction
