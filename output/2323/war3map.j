function CGt takes nothing returns nothing
local unit JL=GetAttacker()
local unit RN=GetTriggerUnit()
if not (GetUnitAbilityLevel(RN,$41393041)>0) and GetUnitStateSwap(UNIT_STATE_MANA,JL)==75. then
call SetUnitState(JL,UNIT_STATE_MANA,0)
call TriggerExecute(gz)
else
call SetUnitState(JL,UNIT_STATE_MANA,GetUnitStateSwap(UNIT_STATE_MANA,JL)+1)
endif
if not (GetUnitAbilityLevel(RN,$41393041)>0) and GetUnitStateSwap(UNIT_STATE_LIFE,JL)==45. then
call SetUnitState(JL,UNIT_STATE_LIFE,1.)
call TriggerExecute(g0)
else
call SetUnitState(JL,UNIT_STATE_LIFE,GetUnitStateSwap(UNIT_STATE_LIFE,JL)+1)
endif
if BFi(1,16)==1 then
call TriggerExecute(g1)
endif
set JL=null
set RN=null
endfunction
function CGu takes nothing returns nothing
local unit RN=GetTriggerUnit()
local unit Cm
local location Id=GetUnitLoc(RN)
local real XP=GetUnitFacing(RN)
local location Ie=PolarProjectionBJ(Id,75.,XP-130.)
local location V7=PolarProjectionBJ(Id,75.,XP+130.)
local integer JG=GetPlayerId(GetOwningPlayer(RN))
local real EN=GetRectCenterX(Lm[JG])
local real JS=GetRectCenterY(Lm[JG])
set bj_lastPlayedSound=BHD("SE\\Anya_dad.wav",null,127,1,true,2000,2500)
call StopSound(bj_lastPlayedSound,false,false)
call BHH(RN,bj_lastPlayedSound)
call BFu("Smoke_Guni.mdx",V7)
call BFu("blackblink.mdx",Ie)
set Cm=CreateUnitAtLoc(HY,$65304D33,V7,XP)
call UnitApplyTimedLife(Cm,$42487765,3)
set Cm=CreateUnitAtLoc(HY,$65304D34,Ie,XP)
call UnitApplyTimedLife(Cm,$42487765,3)
set Cm=CreateUnit(GetOwningPlayer(RN),$68304347,EN,JS,bj_UNIT_FACING)
call UnitRemoveAbilityBJ($416D6F76,Cm)
call RemoveLocation(Id)
call RemoveLocation(Ie)
call RemoveLocation(V7)
set Id=null
set Ie=null
set V7=null
set Cm=null
set RN=null
endfunction
