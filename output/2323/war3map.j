function B6Y takes nothing returns nothing
local player RT=GetTriggerPlayer()
local integer JG=GetPlayerId(RT)
local unit ZP
if not B6X($45543130) then
return
endif
call StartSound(BHD("SE\\Odeng.mp3",null,127,1.*1.,false,0,0))
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,10,"|CFFFFFA78코즈키 오뎅 : |r|CFFC15AF4\"삶아야 마땅히 오뎅이올시다!\"|r")
call SetPlayerTechResearchedSwap($52303344,1,RT)
set ZP=FirstOfGroup(Q6)
if GetPlayerTechCount(RT,$52303052,true)==1 then
call UnitAddAbility(ZP,$41313142)
endif
set aJ=true
if dc==false then
set dc=true
call TriggerRegisterAnyUnitEventBJ(dd,EVENT_PLAYER_UNIT_ATTACKED)
call EnableTrigger(dd)
endif
set ZP=null
set RT=null
endfunction
function B6Z takes nothing returns nothing
local location Id
local integer JG
if GetPlayerState(GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_RESOURCE_FOOD_USED)<4 then
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,5,"|cffff0000[오류]|r|cff1e90ff특성포인트|r가 부족합니다!")
call IssueImmediateOrder(GetTriggerUnit(),"stop")
return
endif
set JG=GetPlayerId(GetOwningPlayer(GetTriggerUnit()))
set Id=GetStartLocationLoc(GetPlayerStartLocation(Player(JG)))
call CreateUnitAtLoc(GetTriggerPlayer(),$68304341,Id,bj_UNIT_FACING)
call UnitRemoveAbility(GetTriggerUnit(),$41313943)
call SetPlayerState(GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_RESOURCE_FOOD_USED,GetPlayerState(GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_RESOURCE_FOOD_USED)-4)
call RemoveLocation(Id)
set Id=null
endfunction
