if hM>1 then
call Bdq(RN,12)
endif
call Bcb(LoadUnitHandle(E2,0,DR*EM+0),RN,hM*$225510,1.,1.,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL)
call Bcb(LoadUnitHandle(E2,0,DR*EM+0),RN,hM*$225510,1.,1.,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
set RN=null
endfunction
