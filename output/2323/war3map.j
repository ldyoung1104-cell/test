else
call Bcb(LoadUnitHandle(E2,0,DR*EM+3),LoadUnitHandle(E2,0,DR*EM+1),(GetUnitStateSwap(UNIT_STATE_MAX_LIFE,LoadUnitHandle(E2,0,DR*EM+1))-GetUnitStateSwap(UNIT_STATE_LIFE,LoadUnitHandle(E2,0,DR*EM+1)))*.03*(.79+.01*I2R(GetUnitAbilityLevel(LoadUnitHandle(E2,0,DR*EM+1),JD))),1.,1.,ATTACK_TYPE_HERO,DAMAGE_TYPE_UNIVERSAL)
