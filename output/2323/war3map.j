function CJB takes nothing returns nothing
local integer JG=GetPlayerId(GetTriggerPlayer())
local integer EK
call BdD(GetSoldUnit())
if BFi(1,100)>25 then
set EK=BFi(10,50)
call Bcf(Player(JG),EK)
call DisplayTimedTextToPlayer(Player(JG),0,0,5,"|cffffd700"+I2S(EK)+" 골드 획득!|r")
else
set EK=BFi(3,5)
call Bcf(Player(JG),EK)
call DisplayTimedTextToPlayer(Player(JG),0,0,5,"|cffff8200돈 도박에 실패하여 "+I2S(EK)+" 골드를 되돌려받습니다.|r")
endif
endfunction
function CJC takes nothing returns nothing
local integer JG=GetPlayerId(GetTriggerPlayer())
local integer EK
local unit Cm=i6[JG]
local real EN=GetUnitX(Cm)
local real JS=GetUnitY(Cm)
call BdE(GetSoldUnit())
if BFi(1,100)>30 then
set EK=BFi(500,4500)
call Bcf(Player(JG),EK)
call DisplayTimedTextToPlayer(Player(JG),0,0,5,"|cffffd700"+I2S(EK)+" 골드 획득!|r")
call StopSound(BHD("coinsound.mp3",null,127,1.,false,1,1),false,false)
call BHF(GetTriggerPlayer(),"coinsound.mp3",null,127,1.)
