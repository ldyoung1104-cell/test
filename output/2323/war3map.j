function O30_LottoDraw takes nothing returns nothing
local integer O30_AI=0
local integer O30_N=0
local integer O30_Match
local string O30_Msg=""
if not O30_LottoOn then
return
endif
loop
exitwhen O30_N>=10
set O30_LottoDrawn[O30_N]=GetRandomInt(1,9)
set O30_Msg=O30_Msg+I2S(O30_LottoDrawn[O30_N])+"  "
if O30_N==4 then
set O30_Msg=O30_Msg+"\n"
endif
set O30_N=O30_N+1
endloop
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,10,"|cffffff80[로또모드] 이번 회차 추첨 결과 :|r\n"+O30_Msg)
loop
exitwhen O30_AI>=4
if GetPlayerSlotState(Player(O30_AI))==PLAYER_SLOT_STATE_PLAYING and O30_LottoAuto[O30_AI] and O30_LottoPick[O30_AI]==0 then
set O30_LottoPick[O30_AI]=GetRandomInt(1,9)
endif
set O30_AI=O30_AI+1
endloop
set O30_AI=0
loop
exitwhen O30_AI>=4
if GetPlayerSlotState(Player(O30_AI))==PLAYER_SLOT_STATE_PLAYING and O30_LottoPick[O30_AI]>0 then
set O30_Match=0
set O30_N=0
loop
exitwhen O30_N>=10
if O30_LottoDrawn[O30_N]==O30_LottoPick[O30_AI] then
set O30_Match=O30_Match+1
endif
set O30_N=O30_N+1
endloop
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,10,GetPlayerName(Player(O30_AI))+"|cffffff80님의 선택 : "+I2S(O30_LottoPick[O30_AI])+"    맞춘 횟수 : |r"+I2S(O30_Match))
if O30_Match>0 then
call Bc4(Player(O30_AI),O30_Match)
endif
if O30_Match>0 and O30_Match<=2 then
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,10,"|cffffff80보상 : 선택위습 "+I2S(O30_Match)+"개|r")
elseif O30_Match==3 then
call SetPlayerState(Player(O30_AI),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(Player(O30_AI),PLAYER_STATE_RESOURCE_LUMBER)+1)
call Bc1(Player(O30_AI),1)
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,10,"|cffffff80보상 : 선택위습 "+I2S(O30_Match)+"개, 목재 1개, 특별위습 1개|r")
elseif O30_Match==4 then
call SetPlayerState(Player(O30_AI),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(Player(O30_AI),PLAYER_STATE_RESOURCE_LUMBER)+3)
call Bc2(Player(O30_AI),1)
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,10,"|cffffff80보상 : 선택위습 "+I2S(O30_Match)+"개, 목재 3개, 희귀위습 1개|r")
elseif O30_Match==5 then
call SetPlayerState(Player(O30_AI),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(O30_AI),PLAYER_STATE_RESOURCE_GOLD)+10000)
call SetPlayerState(Player(O30_AI),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(Player(O30_AI),PLAYER_STATE_RESOURCE_LUMBER)+10)
call Bc0(Player(O30_AI),1)
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,10,"|cffffff80보상 : 선택위습 "+I2S(O30_Match)+"개, 목재 10개, 안흔함위습 1개, 골드 10000|r")
elseif O30_Match>=6 then
call SetPlayerState(Player(O30_AI),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(O30_AI),PLAYER_STATE_RESOURCE_GOLD)+50000)
call SetPlayerState(Player(O30_AI),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(Player(O30_AI),PLAYER_STATE_RESOURCE_LUMBER)+20)
call Bc3(Player(O30_AI),2)
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,10,"|cffffff80보상 : 선택위습 "+I2S(O30_Match)+"개, 목재 20개, 전설위습 2개, 골드 50000|r")
endif
endif
set O30_LottoPick[O30_AI]=0
set O30_AI=O30_AI+1
endloop
endfunction
function O30_LottoChat takes nothing returns nothing
local player O30_Player=GetTriggerPlayer()
local integer O30_ID=GetPlayerId(O30_Player)
local string O30_Msg=GetEventPlayerChatString()
local integer O30_Num=0
if O30_Msg=="@로또모드" then
if O30_LottoOn then
set O30_LottoOn=false
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,10,"|cffffff80[로또모드] 종료합니다.|r")
else
set O30_LottoOn=true
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,10,"|cffffff80[로또모드] 시작! 채팅창에 '@로또1'~'@로또9'로 번호를 고르거나, '@로또자동'을 입력하면 매 라운드 자동으로 번호가 정해집니다. 60초마다 추첨합니다.|r")
endif
return
endif
if O30_Msg=="@로또자동" then
if O30_LottoOn then
set O30_LottoAuto[O30_ID]=true
call DisplayTimedTextToPlayer(O30_Player,0,0,5,"|cffffff80[로또모드] 자동 번호 선택으로 전환했습니다.|r")
endif
return
endif
if O30_Msg=="@로또1" then
set O30_Num=1
elseif O30_Msg=="@로또2" then
set O30_Num=2
elseif O30_Msg=="@로또3" then
set O30_Num=3
elseif O30_Msg=="@로또4" then
set O30_Num=4
elseif O30_Msg=="@로또5" then
set O30_Num=5
elseif O30_Msg=="@로또6" then
set O30_Num=6
elseif O30_Msg=="@로또7" then
set O30_Num=7
elseif O30_Msg=="@로또8" then
set O30_Num=8
elseif O30_Msg=="@로또9" then
set O30_Num=9
endif
if O30_Num>0 and O30_LottoOn then
set O30_LottoPick[O30_ID]=O30_Num
set O30_LottoAuto[O30_ID]=false
call DisplayTimedTextToPlayer(O30_Player,0,0,5,"|cffffff80[로또모드] "+I2S(O30_Num)+"번을 선택했습니다.|r")
endif
endfunction
function O30_LottoInit takes nothing returns nothing
local integer O30_AI=0
set O30_LottoTrig=CreateTrigger()
loop
exitwhen O30_AI>=4
call TriggerRegisterPlayerChatEvent(O30_LottoTrig,Player(O30_AI),"@로또모드",true)
call TriggerRegisterPlayerChatEvent(O30_LottoTrig,Player(O30_AI),"@로또자동",true)
call TriggerRegisterPlayerChatEvent(O30_LottoTrig,Player(O30_AI),"@로또1",true)
call TriggerRegisterPlayerChatEvent(O30_LottoTrig,Player(O30_AI),"@로또2",true)
call TriggerRegisterPlayerChatEvent(O30_LottoTrig,Player(O30_AI),"@로또3",true)
call TriggerRegisterPlayerChatEvent(O30_LottoTrig,Player(O30_AI),"@로또4",true)
call TriggerRegisterPlayerChatEvent(O30_LottoTrig,Player(O30_AI),"@로또5",true)
call TriggerRegisterPlayerChatEvent(O30_LottoTrig,Player(O30_AI),"@로또6",true)
call TriggerRegisterPlayerChatEvent(O30_LottoTrig,Player(O30_AI),"@로또7",true)
call TriggerRegisterPlayerChatEvent(O30_LottoTrig,Player(O30_AI),"@로또8",true)
call TriggerRegisterPlayerChatEvent(O30_LottoTrig,Player(O30_AI),"@로또9",true)
set O30_AI=O30_AI+1
endloop
call TriggerAddAction(O30_LottoTrig,function O30_LottoChat)
call TimerStart(CreateTimer(),60.0,true,function O30_LottoDraw)
endfunction
function Bc5 takes integer kD returns nothing
if kD>150 then
call SetCameraFieldForPlayer(GetTriggerPlayer(),CAMERA_FIELD_FARZ,6500.,0)
else
call SetCameraFieldForPlayer(GetTriggerPlayer(),CAMERA_FIELD_FARZ,5000.,1)
endif
call SetCameraFieldForPlayer(GetTriggerPlayer(),CAMERA_FIELD_TARGET_DISTANCE,25.*I2R(kD),1.)
endfunction
function Bc6 takes unit JM,real JN,real JO returns nothing
call SetUnitX(JM,-10400.)
call SetUnitY(JM,JO)
call SetUnitX(JM,JN)
call IssueImmediateOrder(JM,"stop")
endfunction
function Bc7 takes real Hr,location Hs,boolexpr Ht,code Iu returns nothing
local group H1=CreateGroup()
call GroupEnumUnitsInRangeOfLoc(H1,Hs,Hr,Ht)
call ForGroup(H1,Iu)
call DestroyGroup(H1)
set H1=null
endfunction
function Bc9 takes real Hr,location Hs,boolexpr Ht returns unit
local group H1=CreateGroup()
call GroupEnumUnitsInRangeOfLoc(H1,Hs,Hr,Ht)
set bj_groupRandomConsidered=0
set bj_groupRandomCurrentPick=null
call ForGroup(H1,function GroupPickRandomUnitEnum)
call DestroyGroup(H1)
set H1=null
return bj_groupRandomCurrentPick
endfunction
function BdC takes real Hr,location Hs,boolexpr Ht returns group
set bj_randomSubGroupGroup=CreateGroup()
call GroupEnumUnitsInRangeOfLoc(bj_randomSubGroupGroup,Hs,Hr,Ht)
return bj_randomSubGroupGroup
endfunction
function BdD takes unit Cm returns nothing
call ShowUnit(Cm,false)
call KillUnit(Cm)
endfunction
function BdE takes unit Cm returns nothing
call ShowUnit(Cm,false)
call UnitApplyTimedLife(Cm,$42487765,.5)
endfunction
function BdG takes unit Db,real Jl,string Jm,real H4,real H1,real Hw,real Jn,real Jo,boolean Jp returns nothing
local string Jq=I2S(R2I(Jl))
local integer Jr=StringLength(Jq)
local integer Hv=0
local integer Ju=0
local string array Js
local unit Cm
if Jp==true then
set Cm=CreateUnit(HY,$65303545,GetUnitX(Db)+(Jr-3)*25,GetUnitY(Db),270)
else
set Cm=CreateUnit(HY,$68304335,GetUnitX(Db)+(Jr-3)*25,GetUnitY(Db),270)
endif
call UnitApplyTimedLife(Cm,$42487765,1.)
call SetUnitVertexColorBJ(Cm,H4,H1,Hw,0)
call SetUnitScale(Cm,Jn*.01,1,1)
call SetUnitFlyHeight(Cm,Jo,0)
loop
exitwhen Hv>Jr-4
if Jp==true then
set Js[Jr-4-Hv]=Jt[Jr-4-Hv]
else
set Js[Jr-4-Hv]="origin"
endif
set Ju=S2I(SubString(Jq,Hv,Hv+1))
call DestroyEffect(AddSpecialEffectTarget("S"+Jm+I2S(Ju)+".mdx",Cm,Js[Jr-4-Hv]))
set Hv=Hv+1
endloop
set Cm=null
endfunction
function BdH takes unit Iv,unit Iw,integer Ix returns nothing
local real Iy=GetUnitX(Iv)-GetUnitX(Iw)
local real Iz=GetUnitY(Iv)-GetUnitY(Iw)
local real I0=SquareRoot(Iy*Iy+Iz*Iz)
local real Is=GetUnitAcquireRange(Iv)+200
if Ix==0 or I0>Is or Ix==OrderId("holdposition") then
call IssueImmediateOrder(Iv,"holdposition")
return
endif
if not IsUnitType(Iw,UNIT_TYPE_DEAD) and GetWidgetLife(Iw)>.405 and Ix==OrderId("attack") or (Ix==OrderId("smart") and IsUnitEnemy(Iw,GetOwningPlayer(Iv))) then
call IssueTargetOrder(Iv,"attack",Iw)
return
endif
call IssueImmediateOrder(Iv,"holdposition")
endfunction
function BdI takes unit Cm,integer Me,boolean RE returns nothing
call UnitAddAbility(Cm,Me)
call UnitMakeAbilityPermanent(Cm,RE,Me)
endfunction
function BdJ takes unit Cm,integer X6,real IM returns nothing
if GetUnitAbilityLevel(Cm,$416C6F63)>0 then
call UnitApplyTimedLife(Cm,X6,IM)
endif
endfunction
function BdK takes integer JG,integer oq returns nothing
set os[JG]=os[JG]+oq
set ot=wn()
set is[ot]=Player(JG)
set it[ot]=os[JG]
call BC2(ot)
endfunction
function BdL takes integer JG,integer Hk returns nothing
if kW[JG]==ka then
set Hk=Hk+1
endif
set kP[JG]=kP[JG]+Hk
call AddUnitToStock(i6[JG],$48304157,kP[JG],16)
endfunction
function BdT takes unit IV,real eo returns nothing
call SetUnitState(IV,ConvertUnitState(37),eo)
endfunction
function BdV takes unit RN,unit JL,real V0 returns real
local real Jl=V0
local real V1=GetUnitState(RN,ConvertUnitState(32))
local real V3=.02
local real V2=1.
if V1>=0 then
set V2=1./(1.+V1*V3)
else
set V2=2.-Pow(.94,-V1)
if V2>1.71 then
set V2=1.71
endif
endif
if UnitHasBuffBJ(RN,$4230364A) then
set Jl=Jl/1.1
elseif UnitHasBuffBJ(RN,$42303457) then
set Jl=Jl/1.25
elseif UnitHasBuffBJ(RN,$42303753) then
set Jl=Jl/1.2
endif
if V2>0 then
set Jl=Jl/V2
endif
return Jl
endfunction
function BdW takes nothing returns nothing
if up==null then
set up=CreateTimer()
set s3=CreateTimerDialog(up)
endif
endfunction
function Bdd takes integer JG,integer DF returns nothing
set ZE[JG]=ZE[JG]+DF
call TriggerEvaluate(ZF)
endfunction
function Bde takes nothing returns nothing
local integer iu=GetUnitAbilityLevel(GetTriggerUnit(),$41393031)
local integer JG
if IsUnitInGroup(GetTriggerUnit(),uo) then
return
endif
if iu==0 then
return
endif
set JG=iu-1
if not Ji[JG] then
return
endif
call Bdd(JG,-1)
endfunction
function Bdf takes nothing returns nothing
local integer iu=GetUnitAbilityLevel(GetTriggerUnit(),$41393032)
local integer JG
if IsUnitInGroup(GetTriggerUnit(),uo) then
return
endif
if iu==0 then
return
endif
set JG=iu-1
if not Ji[JG] then
return
endif
if ModuloInteger(X3,5)==0 and X3>50 then
if TimerGetElapsed(up)<16 then
call DisplayTimedTextToPlayer(Player(JG),0,0,5,"|cffdc143c[클리어점수]|r 신속한 보스 처치! : |cffffd7001000점|r\n|cff9dff00"+R2S(TimerGetElapsed(up))+"초|r 만에 처치!")
call BdK(JG,1000)
else
call DisplayTimedTextToPlayer(Player(JG),0,0,5,"|cffdc143c[클리어점수]|r 보스 처치! : |cffffd700500점|r\n|cff9dff00"+R2S(TimerGetElapsed(up))+"초|r 만에 처치!")
call BdK(JG,500)
endif
endif
set un[JG]=un[JG]-1
endfunction
function Bdi takes unit Cm returns boolean
return GetUnitAbilityLevel(Cm,$41393032)>0 or GetUnitAbilityLevel(Cm,$41393131)>0
endfunction
function Bdl takes unit Cm returns boolean
return not Bdi(Cm) and not (GetUnitAbilityLevel(Cm,$41393033)>0) and not (GetUnitAbilityLevel(Cm,$41393034)>0)
endfunction
function Bdm takes integer JG returns nothing
if not Ji[JG] then
return
else
call BH6(JG)
call BH8(JG)
set Ji[JG]=false
endif
call BCX(Player(JG))
endfunction
function Bdq takes unit Cm,integer Hk returns nothing
if Hk>0 and GetUnitAbilityLevel(Cm,Hl)==0 then
call UnitAddAbility(Cm,Hl)
endif
call SetUnitAbilityLevel(Cm,Hl,GetUnitAbilityLevel(Cm,Hl)+Hk)
endfunction
function Bdt takes unit Cm,integer Hk returns nothing
if Hk>0 and GetUnitAbilityLevel(Cm,dI)==0 then
call UnitAddAbility(Cm,dI)
endif
call SetUnitAbilityLevel(Cm,dI,GetUnitAbilityLevel(Cm,dI)+Hk)
endfunction
function Bdw takes unit Cm,integer Hk returns nothing
if Hk>0 and GetUnitAbilityLevel(Cm,Jg)==0 then
call UnitAddAbility(Cm,Jg)
endif
call SetUnitAbilityLevel(Cm,Jg,GetUnitAbilityLevel(Cm,Jg)+Hk)
endfunction
function Bdz takes unit Cm,integer Hk returns nothing
if Hk>0 and GetUnitAbilityLevel(Cm,Jf)==0 then
call UnitAddAbility(Cm,Jf)
endif
call SetUnitAbilityLevel(Cm,Jf,GetUnitAbilityLevel(Cm,Jf)+Hk)
endfunction
function Bd2 takes unit Cm,integer Hk returns nothing
if Hk>0 and GetUnitAbilityLevel(Cm,I2)==0 then
call UnitAddAbility(Cm,I2)
endif
call SetUnitAbilityLevel(Cm,I2,GetUnitAbilityLevel(Cm,I2)+Hk)
endfunction
function Bd4 takes unit Cm,integer Hk returns nothing
if Hk>0 and GetUnitAbilityLevel(Cm,JV)==0 then
call UnitAddAbility(Cm,JV)
endif
call SetUnitAbilityLevel(Cm,JV,Hk)
endfunction
function Bd5 takes unit Cm,integer Hk returns nothing
if Hk>0 and GetUnitAbilityLevel(Cm,JV)==0 then
call UnitAddAbility(Cm,JV)
endif
call SetUnitAbilityLevel(Cm,JV,GetUnitAbilityLevel(Cm,JV)+Hk)
endfunction
function Bd8 takes unit Cm,integer Hk returns nothing
if Hk>0 and GetUnitAbilityLevel(Cm,XL)==0 then
call UnitAddAbility(Cm,XL)
endif
call SetUnitAbilityLevel(Cm,XL,GetUnitAbilityLevel(Cm,XL)+Hk)
endfunction
function BeC takes unit Cm,integer Hk returns nothing
if Hk>0 and GetUnitAbilityLevel(Cm,JD)==0 and not (GetUnitAbilityLevel(Cm,$41393033)>0) then
call UnitAddAbility(Cm,JD)
endif
call SetUnitAbilityLevel(Cm,JD,GetUnitAbilityLevel(Cm,JD)+Hk)
endfunction
function BeE takes string Oz,code Hu returns nothing
local trigger Db=CreateTrigger()
call TriggerAddAction(Db,Hu)
call DzTriggerRegisterSyncData(Db,Oz,false)
set Db=null
endfunction
function BeH takes real YD,real YE,real YF,real YG,real YH returns boolean
return YD>=YF-YH and YD<=YF+YH and YE>=YG-YH and YE<=YG+YH
endfunction
function BeI takes integer JG,real EN,real JS returns nothing
local integer YK
local integer YM=1
local unit Cm
local integer YJ=X3
set YI=YI+1
if YJ<50 then
set YK=BFi(1,2)
else
set YK=1
endif
set Cm=CreateUnit(HY,$68304335,EN,JS,bj_UNIT_FACING)
call BdJ(Cm,$42487765,2)
call SetUnitScale(Cm,3,1,1)
call DestroyEffect(AddSpecialEffectTarget("Objects\\InventoryItems\\TreasureChest\\treasurechest.mdx",Cm,"origin"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Transmute\\PileofGold.mdx",Cm,"origin"))
if YL[JG]==true then
set YM=BFi(1,2)
endif
if YN[JG]==true then
set YM=2
endif
if YK==1 then
if YN[JG]==true and YJ<50 then
set YO[JG]=YO[JG]+1
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,5,GetPlayerName(Player(JG))+"님이 |cff00ced1보물상자|r를 발견하여 |cffff8200"+GetObjectName(YP)+"|r "+I2S(YM)+"기 획득!|r")
call Bc4(Player(JG),YM)
else
set YQ[JG]=YQ[JG]+1
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,5,GetPlayerName(Player(JG))+"님이 |cff00ced1보물상자|r를 발견하여 |cffffd700"+GetObjectName(YR)+"|r "+I2S(YM)+"기 획득!|r")
call Bcz(Player(JG),YM)
endif
elseif YK==2 then
set YS[JG]=YS[JG]+1
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,5,GetPlayerName(Player(JG))+"님이 |cff00ced1보물상자|r를 발견하여 |cff9553ec"+GetObjectName(YT)+"|r "+I2S(YM)+"기 획득!|r")
call Bc0(Player(JG),YM)
endif
if not YU and BFi(1,1000)<=25 then
set Sx[JG]=Sx[JG]+1
call DisplayTimedTextToPlayer(Player(JG),0,0,5,"|cff04ffc4[보물 발견]|r |cff00d9ff1 베리|r를 추가로 획득했습니다!")
endif
call TriggerEvaluate(YV)
set Cm=null
endfunction
function BeJ takes integer JG,real EN,real JS returns nothing
local unit Cm=CreateUnit(HY,$68304335,EN,JS,bj_UNIT_FACING)
call BdJ(Cm,$42487765,2)
call SetUnitScale(Cm,LM[JG]*.01,1,1)
if GetLocalPlayer()==Player(JG) then
call SetUnitVertexColor(Cm,255,255,255,150)
else
call SetUnitVertexColor(Cm,0,0,0,0)
endif
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\TreasureIndicator.mdx",Cm,"origin"))
set Cm=null
endfunction
function BeL takes nothing returns nothing
local integer EK
local location It
if X7==0 then
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,5,"|cffff0000[Error]|r 생성된 보물이 존재하지 않습니다.")
return
endif
set EK=0
loop
exitwhen EK>=X7
set It=Location(X9[EK],YC[EK])
if YW[EK]==null and (X9[EK]!=0 and YC[EK]!=0) then
set YW[EK]=AddSpecialEffectLoc("war3mapImported\\Etc Quest To Me.mdx",It)
endif
call RemoveLocation(It)
set EK=EK+1
endloop
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,5,"|cff04ffc4[알림]|r 모든 보물 위치가 표시됩니다.")
set It=null
endfunction
function BeM takes integer C1,string U6 returns nothing
local integer EK=0
loop
exitwhen EK>=C1
set X9[X7]=BFj(GetRectMinX(CB),GetRectMaxX(CB))
set YC[X7]=BFj(GetRectMinY(CB),GetRectMaxY(CB))
set X7=X7+1
set EK=EK+1
endloop
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,5,"|cff04ffc4[알림]|r 보물이 "+I2S(C1)+"개 스폰되었습니다. "+U6)
endfunction
function BeN takes integer JG,location Xp,real Is,integer Xq,boolean Xr returns nothing
local integer EK
local location It
local real X4
local real X5
local real X8=0
local real YB=0
local string YX
call BJI(JG,0,Xq-3,GetTriggerUnit(),"보물찾기")
set X4=GetLocationX(Xp)
set X5=GetLocationY(Xp)
if Xr then
call BeJ(JG,X4,X5)
endif
set EK=0
loop
exitwhen EK>=X7
set X8=X9[EK]
set YB=YC[EK]
if not (X8==0 and YB==0) then
if BeH(X8,YB,X4,X5,Is) then
if Xr then
set X9[EK]=0
set YC[EK]=0
call BeI(JG,X8,YB)
if YW[EK]!=null then
call DestroyEffect(YW[EK])
endif
else
set It=Location(X8,YB)
if YW[EK]==null then
if GetLocalPlayer()==Player(JG) then
set YX="war3mapImported\\Etc Quest To Me.mdx"
else
set YX=""
endif
set YW[EK]=AddSpecialEffectLoc(YX,It)
endif
call RemoveLocation(It)
call PingMinimapForPlayer(Player(JG),X8,YB,3)
endif
endif
endif
set EK=EK+1
endloop
call RemoveLocation(Xp)
set Xp=null
set It=null
endfunction
