call DisplayTimedTextToPlayer(Player(JG),0,0,15,"    |cffF15F5F◈ 루피|r : |cffFAED7D"+I2S(Bid(Bih(Player(JG),$68303033)))+"|r개")
call DisplayTimedTextToPlayer(Player(JG),0,0,15,"    |cffF15F5F◈ 조로|r : |cffFAED7D"+I2S(Bid(Bih(Player(JG),$68303032)))+"|r개")
call DisplayTimedTextToPlayer(Player(JG),0,0,15,"    |cffF15F5F◈ 나미|r : |cffFAED7D"+I2S(Bid(Bih(Player(JG),$68303031)))+"|r개")
call DisplayTimedTextToPlayer(Player(JG),0,0,15,"    |cffF15F5F◈ 우솝|r : |cffFAED7D"+I2S(Bid(Bih(Player(JG),$68303037)))+"|r개")
call DisplayTimedTextToPlayer(Player(JG),0,0,15,"    |cffF15F5F◈ 상디|r : |cffFAED7D"+I2S(Bid(Bih(Player(JG),$68303034)))+"|r개")
call DisplayTimedTextToPlayer(Player(JG),0,0,15,"    |cffF15F5F◈ 쵸파|r : |cffFAED7D"+I2S(Bid(Bih(Player(JG),$68303038)))+"|r개")
call DisplayTimedTextToPlayer(Player(JG),0,0,15,"    |cffF15F5F◈ 버기|r : |cffFAED7D"+I2S(Bid(Bih(Player(JG),$68303035)))+"|r개")
call DisplayTimedTextToPlayer(Player(JG),0,0,15,"    |cffF15F5F◈ 총병|r : |cffFAED7D"+I2S(Bid(Bih(Player(JG),$68303039)))+"|r개")
call DisplayTimedTextToPlayer(Player(JG),0,0,15,"    |cffF15F5F◈ 칼병|r : |cffFAED7D"+I2S(Bid(Bih(Player(JG),$68303036)))+"|r개")
