function CBc takes nothing returns nothing
local unit JL=GetAttacker()
local unit RN=GetTriggerUnit()
if GetUnitStateSwap(UNIT_STATE_LIFE,JL)==115. then
call SetUnitState(JL,UNIT_STATE_LIFE,1.)
call TriggerExecute(eu)
endif
if not UnitHasBuffBJ(JL,$42303734) then
if not Bdl(RN) then
call TriggerExecute(ev)
elseif BFi(1,1000)<=125 then
call TriggerExecute(ev)
endif
endif
call TriggerExecute(ew)
if GetUnitAbilityLevel(JL,$41313137)==1 then
if GetUnitUserData(JL)>=15 then
call SetUnitUserData(JL,0)
call TriggerExecute(ex)
endif
endif
set JL=null
set RN=null
endfunction
function CBd takes nothing returns nothing
