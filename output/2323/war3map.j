function B93 takes nothing returns nothing
local unit JL=GetAttacker()
local unit RN=GetTriggerUnit()
local unit JI
local location Id
local location Ie
local location V7
local location XQ
local real I0=GetUnitFacing(JL)
local player RT=GetOwningPlayer(JL)
local integer eb=0
local integer Cl
call SetUnitState(JL,UNIT_STATE_MANA,GetUnitStateSwap(UNIT_STATE_MANA,JL)+1)
if GetUnitAbilityLevelSwapped($41305434,JL)==4 then
set eb=4
elseif GetUnitAbilityLevelSwapped($41305434,JL)==3 then
set eb=3
else
set eb=2
endif
if GetUnitStateSwap(UNIT_STATE_MANA,JL)==125. then
call SetUnitState(JL,UNIT_STATE_MANA,0.)
call TriggerExecute(ec)
endif
if BFi(1,100)<=10 then
set Ie=GetUnitLoc(RN)
set JI=CreateUnitAtLoc(HY,$65303236,Ie,bj_UNIT_FACING)
call UnitApplyTimedLife(JI,$42487765,3.)
call IssuePointOrderById(JI,OrderId("dreadlordinferno"),GetLocationX(Ie),GetLocationY(Ie))
set Cl=BiE()
call BiZ(Cl,600.,Ie,Condition(function B9m),function B92)
call BiF(Cl)
call RemoveLocation(Ie)
set bj_lastPlayedSound=BHD("SE\\shiki_wave3.wav",null,100,1,true,1500,2000)
call StopSound(bj_lastPlayedSound,false,false)
call BHH(JL,bj_lastPlayedSound)
endif
if BFi(1,1000)<=75 then
call TriggerExecute(ed)
endif
if GetUnitAbilityLevelSwapped($41305434,JL)>=1 then
if BFi(1,2000)<=56+4*GetUnitAbilityLevelSwapped($41305434,JL) then
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=eb
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
set Id=GetUnitLoc(JL)
set V7=PolarProjectionBJ(Id,275.,BFj(170.,210.)+bj_forLoopAIndex*40)
set JI=CreateUnitAtLoc(RT,$68303752,V7,I0)
call RemoveLocation(Id)
call RemoveLocation(V7)
call SetUnitAbilityLevel(JI,$41305A37,GetUnitAbilityLevel(JL,$41305434))
call UnitApplyTimedLife(JI,$42487765,2.25)
call IssueTargetOrderById(JI,OrderId("attack"),RN)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
endif
if BFi(1,2000)<=111 then
set Ie=GetUnitLoc(RN)
set V7=PolarProjectionBJ(Ie,333.,GetRandomDirectionDeg())
set JI=CreateUnitAtLoc(HY,$68304248,V7,AngleBetweenPoints(V7,Ie))
call UnitApplyTimedLife(JI,$42487765,1.05)
call SetUnitUserData(JI,GetPlayerId(RT))
call IssueTargetOrderById(JI,OrderId("attack"),RN)
set XQ=PolarProjectionBJ(V7,-55.,GetUnitFacing(JI)+BFj(-45.,45.))
set JI=CreateUnitAtLoc(HY,$68304249,XQ,AngleBetweenPoints(XQ,Ie))
call UnitApplyTimedLife(JI,$42487765,1.05)
call SetUnitUserData(JI,GetPlayerId(RT))
call IssueTargetOrderById(JI,OrderId("attack"),RN)
set JI=CreateUnitAtLoc(HY,$6830424A,XQ,AngleBetweenPoints(XQ,Ie))
call UnitApplyTimedLife(JI,$42487765,1.05)
call SetUnitUserData(JI,GetPlayerId(RT))
call IssueTargetOrderById(JI,OrderId("attack"),RN)
call RemoveLocation(Ie)
call RemoveLocation(V7)
call RemoveLocation(XQ)
endif
if GetUnitAbilityLevelSwapped($41305434,JL)>=1 then
if BFi(1,1000)<=26+4*GetUnitAbilityLevelSwapped($41305434,JL) then
call TriggerExecute(ee)
endif
endif
set JL=null
set RN=null
set JI=null
set Id=null
set Ie=null
set V7=null
set XQ=null
set RT=null
endfunction
