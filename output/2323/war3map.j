call SaveInteger(EG,0,DT*EH+FN+EF+2,FO[DT]+2)
set FO[DT]=EF
endif
endfunction
function BVU takes integer DT,integer EK,integer EN returns nothing
call BVS(DT,EK)
call RemoveSavedInteger(FP,0,DT*EM+EK)
call SaveInteger(FP,0,DT*EM+EK,EN)
endfunction
function BVZ takes nothing returns nothing
local integer DT=Do
local integer EK
local integer HF
if FO[DT]==-1 then
return
endif
set EK=FO[DT]
loop
exitwhen EK==-1
call RemoveSavedInteger(FP,0,DT*EM+EK)
set HF=LoadInteger(EG,0,DT*EH+FN+EK+2)-2
call RemoveSavedInteger(EG,0,DT*EH+FN+EK+2)
set EK=HF
endloop
endfunction
function BVa takes nothing returns nothing
call BLS(function BVZ)
endfunction
