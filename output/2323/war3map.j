set Cm=CreateUnitAtLoc(HY,$6530434F,Ie,XP)
call SetUnitUserData(Cm,JG)
call SetUnitScale(Cm,1,1,1)
call IssueTargetOrder(ZQ[JG],"acidbomb",RN)
set Cl=BiE()
call BiZ(Cl,450,Ie,Condition(function BwL),function BwM)
call BiF(Cl)
else
set Cm=CreateUnitAtLoc(HY,$65303551,Ie,XP)
call SetUnitUserData(Cm,JG)
call SetUnitScale(Cm,1.25,1,1)
call SetUnitFlyHeight(Cm,45.,10000.)
call IssueTargetOrder(ZQ[JG],"acidbomb",RN)
call Bcc(JL,0.,450,Ie,200000.,1.,1.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
endif
call RemoveLocation(Id)
call RemoveLocation(Ie)
set Id=null
set Ie=null
set Cm=null
endfunction
