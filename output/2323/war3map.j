function BcD takes integer JG returns nothing
local real M2
if Mx[JG]>=My[JG] then
set Mv[JG]=false
if GetLocalPlayer()==Player(JG) then
call DzFrameSetAlpha(Mz,0)
endif
return
endif
if Mx[JG]==0 then
if GetLocalPlayer()==Player(JG) then
call DzFrameSetText(Mz,M0[JG])
endif
endif
if Mx[JG]<M1[JG] then
set M2=255.*Mx[JG]/M1[JG]
elseif Mx[JG]<M1[JG]+M3[JG] then
set M2=255
elseif Mx[JG]<My[JG] then
set M2=255.-255.*(Mx[JG]-M3[JG]-M1[JG])/M4[JG]
else
set M2=0
endif
if GetLocalPlayer()==Player(JG) then
call DzFrameSetAlpha(Mz,R2I(M2))
endif
endfunction
function BcE takes nothing returns nothing
local boolean Mw=false
local integer EK=0
loop
exitwhen EK>=LG
if Mv[EK] then
set Mw=true
set Mx[EK]=Mx[EK]+1
call BcD(EK)
endif
set EK=EK+1
endloop
if Mw then
return
endif
call DisableTrigger(Mu)
endfunction
function BcF takes nothing returns nothing
local integer Kr=DzGetGameUI()
set M5=BDt(Kr,"GUICenterTextroot")
call DzFrameSetPriority(M5,1000)
set Mz=BD6(M5,"GUICenterTexttext")
call DzFrameSetPoint(Mz,K4,Kr,K4,0*1./Kx*Ky,-(0*1.)/Kz*K0)
call DzFrameSetFont(Mz,"Fonts\\DFHeiMd.ttf",50*1.*K3,0)
call BED(Mz,1,1)
call DzFrameSetEnable(Mz,false)
endfunction
function BcG takes nothing returns nothing
call DisableTrigger(Mu)
call TriggerRegisterTimerEvent(Mu,.02,true)
call TriggerAddAction(Mu,function BcE)
call BDU(.5,function BcF)
endfunction
function BcH takes player Cl,string U6,real EN,real JS,real U7,real U8,real U9 returns nothing
local integer Kr=DzGetGameUI()
local integer JG=GetPlayerId(Cl)
set Mv[JG]=true
set Mx[JG]=0
set M1[JG]=R2I(U7/.02)
set M3[JG]=R2I(U8/.02)
set M4[JG]=R2I(U9/.02)
set My[JG]=M1[JG]+M3[JG]+M4[JG]
set M0[JG]=U6
call DzFrameSetPoint(Mz,K4,Kr,K4,EN*1./Kx*Ky,-(JS*1.)/Kz*K0)
call BcD(JG)
call EnableTrigger(Mu)
endfunction
function BcL takes integer lc,integer JG,integer K7 returns boolean
return lm[JG*3+K7]==lc
endfunction
function BcN takes integer JG,integer K7 returns boolean
local integer Hk=JG*3+K7
return X3<10 and JG>=0 and JG<LG and K7>=0 and K7<3 and not tQ[JG] and not ln[Hk] and lm[Hk]!=0
endfunction
function BcQ takes integer JG returns boolean
return ln[JG*3] and ln[JG*3+1] and ln[JG*3+2]
endfunction
function BcR takes integer lc,integer K7 returns nothing
set lh=K7
call TriggerExecute(LoadTriggerHandle(ld,0,lc))
set lh=-1
endfunction
function BcS takes integer lc,player Cl,integer K7 returns nothing
set lm[GetPlayerId(Cl)*3+K7]=lc
set ln[GetPlayerId(Cl)*3+K7]=false
set lf=Cl
set lh=K7
call TriggerExecute(LoadTriggerHandle(ld,0,lc))
set lf=null
set lh=-1
endfunction
function BcT takes integer lc,code Hu returns nothing
if not HaveSavedHandle(ld,0,lc) then
call SaveTriggerHandle(ld,0,lc,CreateTrigger())
endif
call TriggerAddAction(LoadTriggerHandle(ld,0,lc),Hu)
endfunction
function BcU takes player Cl,integer Hz returns real
local integer EK=0
local real IN=0
local real Dr=0
loop
set EK=EK+1
exitwhen EK>Hz
set Dr=LoadReal(IS,GetHandleId(Cl),1000+EK)
if Dr>IN then
set IN=Dr
endif
endloop
return IN
endfunction
function BcV takes nothing returns nothing
local timer Db=GetExpiredTimer()
local integer EF=GetHandleId(Db)
local player Cl=LoadPlayerHandle(IS,EF,0)
local integer IT=LoadInteger(IS,EF,1)
local integer IO=GetPlayerId(Cl)
set IQ[IO]=IQ[IO]-1
if IQ[IO]==0 then
call CameraClearNoiseForPlayer(Cl)
set IR[IO]=0
else
call SaveReal(IS,GetHandleId(Cl),1000+IT,0)
call CameraSetEQNoiseForPlayer(Cl,BcU(Cl,IR[IO]))
endif
call FlushChildHashtable(IS,EF)
call BHu(Db)
set Cl=null
set Db=null
endfunction
function BcW takes player Cl,real IM,real IN returns nothing
local timer Db
local integer EF
local integer IO=GetPlayerId(Cl)
if not IP[IO] then
call CameraClearNoiseForPlayer(Cl)
return
endif
if IQ[IO]>0 then
return
endif
set Db=BHs(0)
set EF=GetHandleId(Db)
set IQ[IO]=IQ[IO]+1
set IR[IO]=IR[IO]+1
call SaveReal(IS,GetHandleId(Cl),1000+IR[IO],IN)
call SavePlayerHandle(IS,EF,0,Cl)
call SaveInteger(IS,EF,1,IR[IO])
if IN+.0001>=BcU(Cl,IR[IO]) then
call CameraSetEQNoiseForPlayer(Cl,IN)
endif
call TimerStart(Db,IM,false,function BcV)
set Db=null
endfunction
function BcX takes nothing returns nothing
local timer Db=GetExpiredTimer()
local integer EF=GetHandleId(Db)
local unit Cm=LoadUnitHandle(IS,EF,$B6A6EBAA)
local real Ij=LoadReal(IS,EF,$9966AD24)
local real Im=LoadReal(IS,EF,$642F4BA8)
local integer In=LoadInteger(IS,EF,$3DB7A2DC)
local integer Il=LoadInteger(IS,EF,$2DE288C0)
local location Io
local location Ip
if In>=Il or not IsUnitAliveBJ(Cm) then
call FlushChildHashtable(IS,EF)
call BHu(Db)
else
set Io=GetUnitLoc(Cm)
set Ip=PolarProjectionBJ(Io,Im,Ij)
call SetUnitX(Cm,GetLocationX(Ip))
call SetUnitY(Cm,GetLocationY(Ip))
call SaveInteger(IS,EF,$3DB7A2DC,In+1)
call RemoveLocation(Io)
call RemoveLocation(Ip)
set Io=null
set Ip=null
endif
set Cm=null
set Db=null
endfunction
function BcY takes unit Cm,location If,real Ig,real Ih returns nothing
local timer Db=BHs(0)
local integer EF=GetHandleId(Db)
local location Ii=GetUnitLoc(Cm)
local real Ij=AngleBetweenPoints(Ii,If)
local real Ik=DistanceBetweenPoints(Ii,If)
local integer Il=R2I(Ig/Ih)
local real Im
if Il<1 then
set Il=1
endif
set Im=Ik/Il
call SaveUnitHandle(IS,EF,$B6A6EBAA,Cm)
call SaveReal(IS,EF,$9966AD24,Ij)
call SaveReal(IS,EF,$642F4BA8,Im)
call SaveInteger(IS,EF,$3DB7A2DC,0)
call SaveInteger(IS,EF,$2DE288C0,Il)
call TimerStart(Db,Ih,true,function BcX)
call RemoveLocation(Ii)
set Db=null
set Ii=null
endfunction
function BcZ takes nothing returns nothing
local timer Db=GetExpiredTimer()
local unit Cm=LoadUnitHandle(IS,GetHandleId(Db),$D28FDAB4)
local real bp=LoadReal(IS,GetHandleId(Db),$D7056039)
local real bq=LoadReal(IS,GetHandleId(Db),$ECC34823)
local real br=LoadReal(IS,GetHandleId(Db),$E6CF19C7)
local real bs=LoadReal(IS,GetHandleId(Db),$E5862439)
if bq>=bs-br then
call FlushChildHashtable(IS,GetHandleId(Db))
call BHu(Db)
else
set bq=bq+bp
call SetUnitVertexColorBJ(Cm,100,100,100,br+bq)
call SaveReal(IS,GetHandleId(Db),$ECC34823,bq)
endif
set Cm=null
set Db=null
endfunction
function Bca takes unit Hv,real bn,real Ju,real Hw,real Hx returns nothing
local timer Db=BHs(0)
local real bo=Hw/Hx
local real bp=(Ju-bn)/bo
call SaveReal(IS,GetHandleId(Db),$D7056039,bp)
call SaveReal(IS,GetHandleId(Db),$E6CF19C7,bn)
call SaveReal(IS,GetHandleId(Db),$E5862439,Ju)
call SaveUnitHandle(IS,GetHandleId(Db),$D28FDAB4,Hv)
call SaveReal(IS,GetHandleId(Db),$ECC34823,0)
call TimerStart(Db,Hx,true,function BcZ)
set Db=null
endfunction
function Bcb takes unit Hv,unit Hw,real Hx,real Hy,real Hz,attacktype H0,damagetype H1 returns nothing
local real H4=BFj(Hy,Hz)
local real IB=H4*Hx
call UnitDamageTarget(Hv,Hw,IB,true,false,H0,H1,WEAPON_TYPE_WHOKNOWS)
endfunction
function Bcc takes unit Iq,real Ir,real Is,location It,real Hx,real Hy,real Hz,attacktype H0,damagetype H1 returns nothing
local real H4=BFj(Hy,Hz)
local real IB=H4*Hx
call UnitDamagePointLoc(Iq,Ir,Is,It,IB,H0,H1)
endfunction
function Bcf takes player Cl,integer H1 returns nothing
call SetPlayerState(Cl,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Cl,PLAYER_STATE_RESOURCE_GOLD)+H1)
endfunction
function Bci takes player Cl,integer H1 returns nothing
call SetPlayerState(Cl,PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(Cl,PLAYER_STATE_RESOURCE_LUMBER)+H1)
endfunction
function Bcl takes player Cl,integer H1 returns nothing
call SetPlayerState(Cl,PLAYER_STATE_RESOURCE_FOOD_USED,GetPlayerState(Cl,PLAYER_STATE_RESOURCE_FOOD_USED)+H1)
endfunction
function Bco takes unit Cm,real HS returns nothing
call SetUnitState(Cm,UNIT_STATE_LIFE,GetUnitState(Cm,UNIT_STATE_LIFE)+HS)
endfunction
function Bcs takes unit Cm,real HS returns nothing
call SetUnitState(Cm,UNIT_STATE_MANA,GetUnitState(Cm,UNIT_STATE_MANA)+HS)
endfunction
function Bcu takes unit Cm returns boolean
return not IsUnitType(Cm,UNIT_TYPE_DEAD) and GetWidgetLife(Cm)>.405
endfunction
function Bcv takes nothing returns player
local integer EK=0
loop
exitwhen EK>=LG
if GetPlayerSlotState(Player(EK))==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(EK))==MAP_CONTROL_USER then
return Player(EK)
endif
set EK=EK+1
endloop
return null
endfunction
function Bcw takes player Cl returns boolean
return Bcv()==Cl
endfunction
function Bcx takes string Oz,boolean WQ,code Hu returns nothing
local integer EK=0
local trigger HV=CreateTrigger()
call TriggerAddAction(HV,Hu)
loop
exitwhen EK>=LG
call TriggerRegisterPlayerChatEvent(HV,Player(EK),Oz,WQ)
set EK=EK+1
endloop
set HV=null
endfunction
function Bcy takes player Cl,integer TK,integer C1,real EN,real JS,real H0 returns nothing
local integer EK=0
if not Ji[GetPlayerId(Cl)] then
return
endif
loop
exitwhen EK>=C1
call CreateUnit(Cl,TK,EN,JS,H0)
set EK=EK+1
endloop
endfunction
