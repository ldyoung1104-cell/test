function CCC takes nothing returns nothing
if not IsUnitType(GetSpellTargetUnit(),UNIT_TYPE_UNDEAD) then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,5,"|cffFF0000[오류]|r 흔함 유닛에게만 사용 가능")
call IssueImmediateOrder(GetTriggerUnit(),"stop")
return
endif
if GetOwningPlayer(GetSpellTargetUnit())!=GetTriggerPlayer() then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,5,"|cffFF0000[오류]|r 자신의 유닛에게만 사용 가능")
call IssueImmediateOrder(GetTriggerUnit(),"stop")
return
endif
call BdD(GetSpellTargetUnit())
endfunction
