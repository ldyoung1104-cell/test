call TriggerAddAction(ex,function CBb)
call BC5(KH,$41313136,function CBS)
endfunction
function CBe takes integer JG returns unit
if e9[JG]==null then
set e9[JG]=CreateUnit(Player(JG),$68303456,GetPlayerStartLocationX(Player(JG)),GetPlayerStartLocationY(Player(JG)),bj_UNIT_FACING)
call UnitAddAbility(e9[JG],$41304A4C)
call UnitAddAbility(e9[JG],$41313751)
call UnitAddAbility(e9[JG],$41305348)
endif
return e9[JG]
endfunction
function CBf takes player Cl returns group
local group fL=CreateGroup()
local group fK=CreateGroup()
local unit Cm
call GroupEnumUnitsOfPlayer(fL,Cl,null)
loop
set Cm=FirstOfGroup(fL)
exitwhen Cm==null
call GroupRemoveUnit(fL,Cm)
if Bcu(Cm) and IsUnitType(Cm,UNIT_TYPE_UNDEAD) then
call GroupAddUnit(fK,Cm)
endif
endloop
call DestroyGroup(fL)
set fL=null
set Cm=null
return fK
endfunction
function CBg takes nothing returns nothing
local unit Cm=GetTriggerUnit()
local player Cl=GetOwningPlayer(Cm)
if GetUnitTypeId(Cm)!=$68303831 or GetUnitAbilityLevel(Cm,$41323033)==0 or GetUnitAbilityLevel(Cm,$41323037)>0 or GetUnitAbilityLevel(Cm,$41305751)>3 or GetUnitAbilityLevel(Cm,$4130574F)>3 or GetUnitAbilityLevel(Cm,$4130574E)>3 then
set Cm=null
set Cl=null
return
endif
if GetPlayerState(Cl,PLAYER_STATE_RESOURCE_FOOD_USED)<4 then
call DisplayTimedTextToPlayer(Cl,0,0,5,"|cffff0000[오류]|r|cff1e90ff특성포인트|r가 부족합니다!")
call IssueImmediateOrder(Cm,"stop")
set Cm=null
set Cl=null
return
endif
call UnitAddAbility(Cm,$41323037)
call UnitMakeAbilityPermanent(Cm,true,$41323037)
call UnitMakeAbilityPermanent(Cm,true,$41323034)
call UnitMakeAbilityPermanent(Cm,true,$41323035)
call UnitMakeAbilityPermanent(Cm,true,$41323036)
call UnitRemoveAbility(Cm,$41323033)
call SetPlayerState(Cl,PLAYER_STATE_RESOURCE_FOOD_USED,GetPlayerState(Cl,PLAYER_STATE_RESOURCE_FOOD_USED)-4)
set Cm=null
set Cl=null
endfunction
function CBh takes nothing returns nothing
local unit Cm=GetTriggerUnit()
local player Cl=GetOwningPlayer(Cm)
local integer fE=GetSpellAbilityId()
local integer e1=0
local integer fF=0
local integer fG=0
local integer fI=20
local integer EK=0
local string fH=""
local string fJ="미확인"
local group fK
local unit fM
if GetUnitTypeId(Cm)!=$68303831 or GetUnitAbilityLevel(Cm,$41323037)==0 then
set Cm=null
set Cl=null
return
endif
if fE==$41323034 then
set fF=$41305751
set e1=GetUnitAbilityLevel(Cm,fF)
set fG=1
set fH="공격력"
elseif fE==$41323035 then
set fF=$4130574F
set e1=GetUnitAbilityLevel(Cm,fF)
set fG=2
set fH="공격속도"
elseif fE==$41323036 then
set fF=$4130574E
set e1=GetUnitAbilityLevel(Cm,fF)
set fG=3
set fI=25
set fH="방어력 감소"
else
set Cm=null
set Cl=null
return
endif
if e1!=3 then
if e1==1 then
set fJ="기본"
elseif e1==2 then
set fJ="유니크"
endif
call DisplayTimedTextToPlayer(Cl,0,0,5,"|cffff0000[오류]|r "+fH+" 항목이 레전더리 등급일 때만 한계돌파 할 수 있습니다. 현재 등급: "+fJ)
call IssueImmediateOrder(Cm,"stop")
set Cm=null
set Cl=null
return
endif
set fK=CBf(Cl)
if CountUnitsInGroup(fK)<5 then
call DisplayTimedTextToPlayer(Cl,0,0,5,"|cffff0000[오류]|r 한계돌파에는 흔함 등급 유닛 5기가 필요합니다.")
call IssueImmediateOrder(Cm,"stop")
call DestroyGroup(fK)
set fK=null
set Cm=null
set Cl=null
return
endif
loop
exitwhen EK>=5
set fM=GroupPickRandomUnit(fK)
call GroupRemoveUnit(fK,fM)
if IsUnitType(fM,UNIT_TYPE_HERO) then
call RemoveUnit(fM)
else
call BdD(fM)
endif
set EK=EK+1
endloop
call SetUnitAbilityLevel(Cm,fF,4)
call UnitRemoveAbility(Cm,$41323037)
call UnitRemoveAbility(Cm,$41323034)
call UnitRemoveAbility(Cm,$41323035)
call UnitRemoveAbility(Cm,$41323036)
call UnitAddAbility(Cm,$4130534A)
call SetUnitAbilityLevel(Cm,$4130534A,fG)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Levelup\\LevelupCaster.mdx",Cm,"origin"))
call DisplayTimedTextToPlayer(Cl,0,0,5,"|cff1e90ff[한계돌파]|r 유니언 아르마다 :: "+fH+"의 레전더리 효과가 "+I2S(fI)+"% 강화되었습니다.")
call DestroyGroup(fK)
set fK=null
set fM=null
set Cm=null
set Cl=null
endfunction
