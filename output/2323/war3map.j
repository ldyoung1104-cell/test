else
set NB=CreateUnit(Player(7),$6F303332,GetRectCenterX(Ce),GetRectCenterY(Ce)-200,bj_UNIT_FACING)
endif
if NE==NL then
call SetUnitAbilityLevel(NB,$41313348,2)
endif
call SetUnitVertexColor(NB,PercentTo255(0),PercentTo255(0),PercentTo255(0),255)
set NC=CreateTextTag()
