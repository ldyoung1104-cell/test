function BwI takes nothing returns nothing
local unit JL=GetAttacker()
local unit RN=GetTriggerUnit()
local unit JI
local location Id=GetUnitLoc(JL)
local location Ie=GetUnitLoc(RN)
local location V7=PolarProjectionBJ(Ie,175.,GetRandomDirectionDeg())
local player RT=GetOwningPlayer(JL)
call SetUnitState(JL,UNIT_STATE_LIFE,GetUnitStateSwap(UNIT_STATE_LIFE,JL)+1)
if GetUnitPropWindowBJ(RN)!=64. and Bdi(RN) or GetUnitAbilityLevel(RN,$41393034)>0 then
call SetUnitPropWindowBJ(RN,64.)
call TriggerExecute(ZL)
elseif GetUnitStateSwap(UNIT_STATE_LIFE,JL)==50. then
call SetUnitLifeBJ(JL,1.)
call TriggerExecute(ZL)
endif
if BFi(1,100)<=10 then
call TriggerExecute(ZM)
call SetUnitAnimation(JL,"spell")
endif
if BFi(1,1000)<=125 then
call TriggerExecute(ZN)
call Bcb(JL,RN,600000.,1.,1.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
if Bdi(RN) then
call Bcb(JL,RN,GetUnitStateSwap(UNIT_STATE_MAX_LIFE,RN)*.02,1.,1.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
elseif not Bdi(RN) and not (GetUnitAbilityLevel(RN,$41393033)>0) and not (GetUnitAbilityLevel(RN,$41393034)>0) then
call Bcb(JL,RN,GetUnitStateSwap(UNIT_STATE_MAX_LIFE,RN)*.08*(.79+.01*I2R(GetUnitAbilityLevel(RN,JD))),1.,1.,ATTACK_TYPE_MELEE,DAMAGE_TYPE_UNIVERSAL)
endif
endif
if BFi(1,100)<=9 then
set JI=CreateUnitAtLoc(HY,$68303836,V7,AngleBetweenPoints(V7,Ie))
call SetUnitUserData(JI,GetPlayerId(RT))
call UnitApplyTimedLife(JI,$42487765,2.25)
call IssueTargetOrder(JI,"attack",RN)
set JI=CreateUnitAtLoc(HY,$65303346,V7,AngleBetweenPoints(V7,Ie))
call SetUnitVertexColor(JI,100,255,100,255)
call SetUnitScale(JI,.65,1,1)
call SetUnitFlyHeight(JI,30.,10000.)
set JI=CreateUnitAtLoc(HY,$65303448,V7,AngleBetweenPoints(V7,Ie))
call SetUnitVertexColor(JI,100,255,100,255)
call SetUnitScale(JI,.65,1,1)
call SetUnitFlyHeight(JI,30.,10000.)
call IssueTargetOrder(ZO[GetPlayerId(RT)],"firebolt",RN)
endif
if GetUnitAbilityLevelSwapped($41305541,JL)==2 then
if BFi(1,100)<=5 then
set V7=PolarProjectionBJ(Ie,175.,GetRandomDirectionDeg())
set JI=CreateUnitAtLoc(HY,$68303836,V7,AngleBetweenPoints(V7,Ie))
call SetUnitUserData(JI,GetPlayerId(RT))
call UnitApplyTimedLife(JI,$42487765,2.25)
call UnitAddAbility(JI,$41305A54)
call IssueTargetOrder(JI,"attack",RN)
set JI=CreateUnitAtLoc(HY,$65303346,V7,AngleBetweenPoints(V7,Ie))
call SetUnitVertexColor(JI,100,255,100,255)
call SetUnitScale(JI,.65,1,1)
call SetUnitFlyHeight(JI,30.,10000.)
set JI=CreateUnitAtLoc(HY,$65303448,V7,AngleBetweenPoints(V7,Ie))
call SetUnitVertexColor(JI,100,255,100,255)
call SetUnitScale(JI,.65,1,1)
call SetUnitFlyHeight(JI,30.,10000.)
call IssueTargetOrder(ZO[GetPlayerId(RT)],"firebolt",RN)
endif
endif
call RemoveLocation(Id)
call RemoveLocation(Ie)
call RemoveLocation(V7)
set JL=null
set RN=null
set JI=null
set Id=null
set Ie=null
set V7=null
set RT=null
endfunction
