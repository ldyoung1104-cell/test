if GetPlayerController(RT)==MAP_CONTROL_USER then
set og[GetPlayerId(RT)]=og[GetPlayerId(RT)]+GetEventDamage()
else
set og[GetUnitUserData(JL)]=og[GetUnitUserData(JL)]+GetEventDamage()
endif
else
set oj=oi-oY
set ok=GetEventDamage()-oj
if GetPlayerController(RT)==MAP_CONTROL_USER then
set og[GetPlayerId(RT)]=og[GetPlayerId(RT)]+ok
else
set og[GetUnitUserData(JL)]=og[GetUnitUserData(JL)]+ok
endif
endif
set JL=null
set RN=null
set RT=null
endfunction
