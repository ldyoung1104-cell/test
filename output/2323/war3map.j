function B7u takes nothing returns nothing
local unit JL=GetAttacker()
local unit RN=GetTriggerUnit()
local unit dt
local location It
if GetUnitState(JL,UNIT_STATE_LIFE)==115 then
call SetUnitState(JL,UNIT_STATE_LIFE,1*1.)
set It=GetUnitLoc(JL)
set dt=CreateUnitAtLoc(HY,$65304B56,It,GetUnitFacing(JL))
call UnitApplyTimedLife(dt,$42487765,1)
call IssueTargetOrder(dt,"bloodlust",JL)
call RemoveLocation(It)
set It=null
set dt=null
else
call SetUnitState(JL,UNIT_STATE_LIFE,(GetUnitState(JL,UNIT_STATE_LIFE)+1)*1.)
endif
if GetUnitState(JL,UNIT_STATE_MANA)==150 then
call SetUnitState(JL,UNIT_STATE_MANA,0*1.)
call B7b(JL,RN)
else
call SetUnitState(JL,UNIT_STATE_MANA,(GetUnitState(JL,UNIT_STATE_MANA)+1)*1.)
endif
if UnitHasBuffBJ(JL,$42303643) then
call B7n(JL,RN)
if BFi(1,100)<=20 then
call B7h(JL,RN,true)
endif
else
if BFi(1,100)<=15 then
call B7s(JL,RN)
endif
if BFi(1,100)<=10 then
call B7h(JL,RN,false)
endif
endif
set JL=null
set RN=null
endfunction
function B7v takes integer WR returns boolean
call BIw()
set Q5=GetTriggerPlayer()
set WS=WR
call BI1(GetPlayerStartLocationX(GetTriggerPlayer()),GetPlayerStartLocationY(GetTriggerPlayer()))
return BI2()
endfunction
function B7w takes nothing returns nothing
local player Cl
local group H1
local unit Cm
local integer VM
local integer dn=0
local integer do=0
local integer dp=0
local integer dq=0
local boolean dm=false
local unit ds
local unit dr
set Cl=GetTriggerPlayer()
set H1=CreateGroup()
call GroupEnumUnitsOfPlayer(H1,Cl,null)
loop
set Cm=FirstOfGroup(H1)
exitwhen Cm==null
call GroupRemoveUnit(H1,Cm)
if not dm then
set VM=GetUnitTypeId(Cm)
if VM==$48303939 or VM==$48304232 or VM==$48304233 then
set dn=GetHeroStatBJ(bj_HEROSTAT_STR,Cm,false)
set do=GetHeroStatBJ(bj_HEROSTAT_AGI,Cm,false)
set dp=GetHeroStatBJ(bj_HEROSTAT_INT,Cm,false)
set dq=GetHeroXP(Cm)
set dm=true
set dr=Cm
endif
endif
endloop
call DestroyGroup(H1)
if NG[GetPlayerId(Cl)]==0 then
call DisplayTimedTextToPlayer(Cl,0,0,5,"|cffff0000[오류]|r "+GetUnitName(dr)+"의 특성강화가 필요합니다!")
set Cl=null
set H1=null
set dr=null
return
endif
if not B7v($45543032) then
set Cl=null
set H1=null
set dr=null
return
endif
call StartSound(BHD("SE\\Nika.mp3",null,127,1.*1.,false,0,0))
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,10,"|CFFFFFA78니카 : |r|CFFC15AF4기어 피프스!|r")
set ds=FirstOfGroup(Q6)
call UnitAddItemToSlotById(ds,$49303030,0)
set NG[GetPlayerId(Cl)]=2
call BeQ()
if dm then
call SetHeroXP(ds,dq,false)
call ModifyHeroStat(bj_HEROSTAT_STR,ds,bj_MODIFYMETHOD_SET,dn)
call ModifyHeroStat(bj_HEROSTAT_AGI,ds,bj_MODIFYMETHOD_SET,do)
call ModifyHeroStat(bj_HEROSTAT_INT,ds,bj_MODIFYMETHOD_SET,dp)
endif
set Cl=null
set H1=null
set Cm=null
set dr=null
set ds=null
endfunction
function B7x takes nothing returns nothing
call Bcx("태양의신",true,function B7w)
call Bcx("nika et",true,function B7w)
call w5($4830424B,function B7u)
endfunction
function B7y takes integer WR returns boolean
call BIw()
