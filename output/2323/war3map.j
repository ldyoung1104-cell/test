function CF0 takes nothing returns nothing
local unit JL=GetAttacker()
local unit RN=GetTriggerUnit()
local integer JG=GetPlayerId(GetOwningPlayer(JL))
local location Id=GetUnitLoc(JL)
local location Ie=GetUnitLoc(RN)
local unit JI
if GetUnitStateSwap(UNIT_STATE_LIFE,JL)==75. then
call SetUnitState(JL,UNIT_STATE_LIFE,1)
set JI=CreateUnitAtLoc(HY,$65304B34,Ie,GetUnitFacing(JL))
call Bcb(JL,RN,5000000.,1.,1.,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
if BFi(1,100)<=45 then
call Bci(Player(JG),1)
else
call Bcf(Player(JG),1500)
endif
else
call SetUnitState(JL,UNIT_STATE_LIFE,GetUnitStateSwap(UNIT_STATE_LIFE,JL)+1)
endif
if BFi(1,16)==1 then
call TriggerExecute(gj)
endif
if BFi(1,100)<=8 then
set JI=CreateUnitAtLoc(HY,$68304335,Id,bj_UNIT_FACING)
call UnitAddAbility(JI,$41305857)
call IssueTargetOrder(JI,"bloodlust",JL)
call UnitApplyTimedLife(JI,$42487765,2)
endif
if UnitHasBuffBJ(JL,$42303258)==true then
call SetUnitAnimation(JL,"Spell channel five")
call TriggerExecute(gk)
endif
call RemoveLocation(Id)
call RemoveLocation(Ie)
set JI=null
set JL=null
set RN=null
set Id=null
set Ie=null
endfunction
