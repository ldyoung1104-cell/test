call DzFrameSetText(RZ[DT],K9)
endfunction
function Bi2 takes integer DT,integer Ks,real II,real Kt,real EN,real JS,boolean Ku returns nothing
if Ku then
set RY[DT]=BDs(Ks,"PresentBoxDashBoard___PlayerInfoButton icon")
else
set RY[DT]=BDt(Ks,"PresentBoxDashBoard___PlayerInfoButton icon")
endif
call DzFrameSetSize(RY[DT],II*1./Kx*Ky,Kt*1./Kz*K0)
call DzFrameSetPoint(RY[DT],K1,Ks,K1,EN*1./Kx*Ky,-(JS*1.)/Kz*K0)
set RZ[DT]=BD6(RY[DT],"PresentBoxDashBoard___PlayerInfoButton text1")
call DzFrameSetFont(RZ[DT],"Fonts\\esamanruMedium.ttf",20*1.*K3,0)
call DzFrameSetPoint(RZ[DT],K4,RY[DT],K4,0*1./Kx*Ky,-(0*1.)/Kz*K0)
call DzFrameSetEnable(RZ[DT],false)
if DT==0 then
set Ra[DT]=BDv(RY[DT],"PresentBoxDashBoard___PlayerInfoButton button")
else
set Ra[DT]=BDx(RY[DT],"PresentBoxDashBoard___PlayerInfoButton button")
endif
call DzFrameSetSize(Ra[DT],II*1./Kx*Ky,Kt*1./Kz*K0)
call DzFrameSetPoint(Ra[DT],K4,RY[DT],K4,0*1./Kx*Ky,-(0*1.)/Kz*K0)
call SaveInteger(K6,0,Ra[DT],DT)
call DzFrameSetScriptByCode(Ra[DT],1,function Bi0,false)
call DzFrameSetScriptByCode(Ra[DT],2,function Biy,false)
call DzFrameSetScriptByCode(Ra[DT],3,function Biz,false)
endfunction
