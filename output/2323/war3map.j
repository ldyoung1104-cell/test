function B2P takes nothing returns nothing
local unit JL=GetAttacker()
local unit RN=GetTriggerUnit()
local unit JI
local location Id
local player RT=GetOwningPlayer(JL)
local real bt=I2R(Sw[GetPlayerId(RT)])
if bt>300 then
set bt=300
endif
if UnitHasBuffBJ(JL,$42303948)==true then
call TriggerExecute(bx)
endif
if BFi(1,16)==1 then
set Id=GetUnitLoc(JL)
set JI=CreateUnitAtLoc(HY,$65304B48,Id,GetUnitFacing(JL))
call UnitApplyTimedLife(JI,$42487765,1)
call IssueTargetOrderById(JI,OrderId("bloodlust"),JL)
set JI=CreateUnitAtLoc(HY,$65303559,Id,GetUnitFacing(JL))
call SetUnitFlyHeight(JI,40,10000)
call SetUnitScale(JI,1.5,1,1)
call RemoveLocation(Id)
set bj_lastPlayedSound=BHD("SE\\lamgack.wav",null,127,1,true,2000,2500)
call StopSound(bj_lastPlayedSound,false,false)
call BHH(JL,bj_lastPlayedSound)
endif
if BFi(1,100)<=20 then
call TriggerExecute(bx)
endif
if BFj(1.,100.)<=5.25+.01*.25*bt then
call TriggerExecute(by)
endif
set JI=null
set JL=null
set RN=null
set Id=null
set RT=null
endfunction
function B2Q takes nothing returns nothing
local unit JL=GetAttacker()
local player RT=GetOwningPlayer(JL)
local real bt=I2R(Sw[GetPlayerId(RT)])
if bt>300 then
set bt=300
endif
if BFj(1.,100.)<=5.25+.01*.25*bt then
call TriggerExecute(bu)
endif
if BFi(1,100)<=18 then
call TriggerExecute(bv)
endif
if BFj(1.,100.)<=7.25+.01*.25*bt then
call TriggerExecute(bw)
endif
set JL=null
set RT=null
endfunction
