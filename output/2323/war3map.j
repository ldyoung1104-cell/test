set Y7=null
return
endif
set Y7=Bif(Y5)
set Y8=GetUnitStatePercent(Y7,UNIT_STATE_LIFE,UNIT_STATE_MAX_LIFE)*.85
set Y9=GetUnitDefaultAcquireRange(Y7)
set ZB=R2I(Y9)-BFi(3,5)
call GroupRemoveUnit(Hp[Y5],Y7)
call BdD(Y7)
if ZB>X3-7 then
