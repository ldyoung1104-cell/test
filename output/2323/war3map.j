call BST(DR,10,CreateUnitAtLoc(HY,$65304738,LoadLocationHandle(E9,0,DR*EM+2),AngleBetweenPoints(LoadLocationHandle(E9,0,DR*EM+2),LoadLocationHandle(E9,0,DR*EM+1))+BFj(-110.,110.)))
call BST(DR,10,CreateUnitAtLoc(HY,$65304739,LoadLocationHandle(E9,0,DR*EM+2),AngleBetweenPoints(LoadLocationHandle(E9,0,DR*EM+2),LoadLocationHandle(E9,0,DR*EM+1))+BFj(-110.,110.)))
