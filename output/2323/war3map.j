call UnitAddAbility(Cm,$41393041)
call SetUnitAbilityLevel(Cm,$41393041,JG+1)
call SetUnitState(Cm,UNIT_STATE_MANA,(JG+1)*1.)
if Yd then
call TriggerRegisterUnitEvent(sz,Cm,EVENT_UNIT_DAMAGED)
endif
set Cm=null
endfunction
function CTp takes nothing returns nothing
local integer JG=GetPlayerId(GetOwningPlayer(GetKillingUnit()))
local integer sy=GetUnitAbilityLevel(GetTriggerUnit(),$41393041)
local integer EK=0
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,10,"|cffFF8200[크립]|r "+GetPlayerName(Player(JG))+"|r 님이 |cffff00001단계 크립|r을 사냥하여 모든 플레이어에게 |cffffd7001000 골드|r 와 |cff7ad8231 목재|r를 지급합니다.")
loop
exitwhen EK>=LG
call SetPlayerState(Player(EK),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(EK),PLAYER_STATE_RESOURCE_GOLD)+1000)
call SetPlayerState(Player(EK),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(Player(EK),PLAYER_STATE_RESOURCE_LUMBER)+1)
set EK=EK+1
endloop
call CTo(sy-1,$6E303046,true)
