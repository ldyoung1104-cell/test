call DialogDisplay(GetOwningPlayer(fR),fP,false)
call DialogClear(fP)
call RemoveLocation(It)
set It=null
set fT=false
set fQ=null
set fR=null
elseif GetClickedButton()==fU then
call DisplayTimedTextToPlayer(Player(JG),0,0,5,"|cff04ffc4[알림]|r 유닛 소유권 변경을 상대방이 거절했습니다")
