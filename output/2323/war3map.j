function CI4 takes nothing returns nothing
local integer JG=GetPlayerId(GetOwningPlayer(GetTriggerUnit()))
local real EN=GetPlayerStartLocationX(Player(JG))
local real JS=GetPlayerStartLocationY(Player(JG))
if GetPlayerState(Player(JG),PLAYER_STATE_RESOURCE_LUMBER)<8 then
call DisplayTimedTextToPlayer(Player(JG),0,0,5,"목재가 부족합니다. |cff7ad8238 목재|r 필요")
return
endif
call BdD(GetTriggerUnit())
call SetPlayerState(Player(JG),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(Player(JG),PLAYER_STATE_RESOURCE_LUMBER)-8)
set bj_lastCreatedUnit=CreateUnit(Player(JG),$68303630,EN,JS,bj_UNIT_FACING)
call IssueImmediateOrder(bj_lastCreatedUnit,"holdposition")
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,GetPlayerName(Player(JG))+"|r 님이 |cffFF8200[고대의 배]|r 도박으로 "+GetUnitName(bj_lastCreatedUnit)+" 을 획득하셨습니다.|r")
endfunction
function CI5 takes nothing returns nothing
local integer JG=GetPlayerId(GetOwningPlayer(GetTriggerUnit()))
local real EN=GetPlayerStartLocationX(Player(JG))
local real JS=GetPlayerStartLocationY(Player(JG))
if GetPlayerState(Player(JG),PLAYER_STATE_RESOURCE_LUMBER)<7 then
call DisplayTimedTextToPlayer(Player(JG),0,0,5,"목재가 부족합니다. |cff7ad8237 목재|r 필요")
return
endif
call BdD(GetTriggerUnit())
call SetPlayerState(Player(JG),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(Player(JG),PLAYER_STATE_RESOURCE_LUMBER)-7)
if BFi(1,100)<=28 then
set bj_lastCreatedUnit=CreateUnit(Player(JG),$68303558,EN,JS,bj_UNIT_FACING)
call IssueImmediateOrder(bj_lastCreatedUnit,"holdposition")
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,GetPlayerName(Player(JG))+"|r 님이 |cffFF8200[고대의 배]|r 도박으로 "+GetUnitName(bj_lastCreatedUnit)+" 를 획득하셨습니다.|r")
else
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,GetPlayerName(Player(JG))+"|r 님이 |cffFF8200[고대의 배]|r '레일리' 도박에 |cffff0000실패|r하셨습니다.")
endif
endfunction
