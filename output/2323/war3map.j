function CEs takes nothing returns nothing
call BJ7(0)
if HR[DR]==0 then
call BST(DR,0,gG[5])
call BJ3(DR,.03)
elseif HR[DR]==1 then
if Bcu(LoadUnitHandle(E2,0,DR*EM+0)) then
if GetUnitUserData(LoadUnitHandle(E2,0,DR*EM+0))==1 then
call BTV(DR,0,GetUnitLoc(LoadUnitHandle(E2,0,DR*EM+0)))
call BTV(DR,1,PolarProjectionBJ(LoadLocationHandle(E9,0,DR*EM+0),GetUnitFlyHeight(LoadUnitHandle(E2,0,DR*EM+0))*1.2*I2R(GetUnitUserData(LoadUnitHandle(E2,0,DR*EM+0))),GetUnitFacing(LoadUnitHandle(E2,0,DR*EM+0))))
