function Bbs takes integer Up returns boolean
return Up==MP or Up==MT or Up==MW or Up==MQ or Up==KV or Up==KW or Up==MR or Up==MS or Up==MU or Up==MV
endfunction
function Bbt takes integer JG returns nothing
set TU[JG]=0
set Sa[JG]=0
call SetPlayerName(Player(JG),BFy(KT[JG]))
endfunction
function Bbu takes integer JG,integer Up returns nothing
local player Cl=Player(JG)
local boolean VI=LoadBoolean(L7,Up,Mc)
local string VJ=""
local string TS
set TS=Sv[GetPlayerId(Cl)]
if VJ=="" or VJ==null then
if TS=="블랙#33123" then
set VJ="|cddffffff[단끝견]|r"
set VI=true
elseif TS=="kni12313" then
set VJ="|cddffffff[단끝견]|r"
set VI=true
elseif TS=="히바리#31542" then
set VJ="|cfff7f458[Designer]|r"
set VI=true
elseif TS=="GONE#31756" then
set VJ="|cffc7ffd9[늙고병든]|r"
set VI=true
elseif TS=="오석균#3312" then
set VJ="|cff5997c9[마르코]|r"
set VI=true
else
set VJ=VJ+LoadStr(L7,Up,L9)
endif
endif
if VK[JG] then
set VJ=GetAbilityEffectById($415A5A5A,EFFECT_TYPE_CASTER,0)
set VI=false
endif
set TU[JG]=Up
call SaveInteger(Lx[JG],0,Up,U1)
call SetPlayerName(Cl,VJ+Ld[JG]+BFy(KT[JG]))
if VI then
set VL[JG]=1
else
set VL[JG]=0
endif
if Bbs(Up) then
set Sa[JG]=1
else
set Sa[JG]=0
endif
endfunction
