function CEm takes nothing returns nothing
local unit JL=GetAttacker()
local unit RN=GetTriggerUnit()
local unit JI
local location Id=GetUnitLoc(JL)
local location Ie=GetUnitLoc(RN)
local integer JG=GetPlayerId(GetOwningPlayer(JL))
if GetUnitUserData(JL)==1 then
call SetUnitUserData(JL,0)
set JI=CreateUnitAtLoc(HY,$65304A58,Id,GetUnitFacing(JL)+BFj(-25,25))
else
call SetUnitUserData(JL,1)
set JI=CreateUnitAtLoc(HY,$65304A59,Id,GetUnitFacing(JL)+BFj(-25,25))
endif
if not IsUnitInGroup(RN,f9[JG]) then
call GroupAddUnit(f9[JG],RN)
endif
call Bcb(JL,RN,50000,1.,1.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
call BeC(RN,4)
if Bdl(RN) then
call Bcb(JL,RN,CEg(RN,.08),1.,1.,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_UNIVERSAL)
endif
if GetUnitStateSwap(UNIT_STATE_MANA,JL)==60. then
call SetUnitState(JL,UNIT_STATE_MANA,0)
call TriggerExecute(gB)
else
call SetUnitState(JL,UNIT_STATE_MANA,GetUnitStateSwap(UNIT_STATE_MANA,JL)+1)
endif
if BFi(1,100)<=8 then
call TriggerExecute(gC)
endif
call RemoveLocation(Id)
call RemoveLocation(Ie)
set JL=null
set RN=null
set JI=null
set Id=null
set Ie=null
endfunction
