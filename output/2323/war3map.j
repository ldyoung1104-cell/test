function CT3 takes nothing returns nothing
local trigger HV=CreateTrigger()
call TriggerAddAction(HV,function CT2)
call TriggerAddCondition(HV,Condition(function CT0))
call TriggerRegisterAnyUnitEventBJ(HV,EVENT_PLAYER_UNIT_SPELL_EFFECT)
set HV=null
endfunction
function CT4 takes nothing returns integer
local integer oH=tS-1
local integer kq=BFi(0,oH)
local integer Y7=tT[kq]
set tT[kq]=tT[oH]
set tS=tS-1
return Y7
endfunction
function CT5 takes player Cl,integer K7 returns nothing
local integer lc=CT4()
call BcS(lc,Cl,K7)
endfunction
function CT6 takes player Cl returns nothing
local integer tv=3
local integer EK=0
loop
exitwhen EK>=tv
call CT5(Cl,EK)
set EK=EK+1
endloop
call DisplayTimedTextToPlayer(Cl,0,0,8,"|cffF361A6[퀘스트]|r 기록지침의 리롤 버튼을 클릭하여 10라운드 시작 전까지 미완료 퀘스트를 1회 변경할 수 있습니다.")
endfunction
function CT7 takes nothing returns nothing
local player Cl=DzGetTriggerSyncPlayer()
local integer JG=GetPlayerId(Cl)
local integer K7=S2I(DzGetTriggerSyncData())
local integer lc
local integer tR
if not BcN(JG,K7) then
call DisplayTimedTextToPlayer(Cl,0,0,5,"|cffff0000[오류]|r 퀘스트 변경은 10라운드 시작 전, 미완료 퀘스트에 한해 변경할 수 있습니다.")
set Cl=null
return
endif
set tR=lm[JG*3+K7]
set lc=CT4()
set tT[tS]=tR
set tS=tS+1
set tQ[JG]=true
call BcS(lc,Cl,K7)
if GetLocalPlayer()==Cl then
call BhG()
endif
call DisplayTimedTextToPlayer(Cl,0,0,5,"|cffF361A6[퀘스트]|r 선택한 퀘스트를 새로운 퀘스트로 변경했습니다. (게임 내 변경 기회 사용 완료)")
set Cl=null
endfunction
function CT8 takes integer tr returns nothing
set tT[tS]=tr
set tS=tS+1
endfunction
