endfunction
function BsK takes nothing returns nothing
local integer Cl
call BJ7(0)
if HR[DR]==0 then
call BST(DR,0,GetAttacker())
call BST(DR,1,GetTriggerUnit())
call BTV(DR,0,GetUnitLoc(LoadUnitHandle(E2,0,DR*EM+0)))
call BTV(DR,1,GetUnitLoc(LoadUnitHandle(E2,0,DR*EM+1)))
call BST(DR,3,IG[GetPlayerId(GetOwningPlayer(LoadUnitHandle(E2,0,DR*EM+0)))])
call BWT(DR,0,AngleBetweenPoints(LoadLocationHandle(E9,0,DR*EM+0),LoadLocationHandle(E9,0,DR*EM+1)))
call BVU(DR,0,0)
call BKL(DR,LoadUnitHandle(E2,0,DR*EM+1),EVENT_UNIT_DAMAGED,Condition(function BsH),4)
call BJ2(DR,2.2,2)
elseif HR[DR]==2 then
call BKe(DR)
call BJx(DR)
elseif HR[DR]==4 then
call BKe(DR)
call BWT(DR,3,BdV(LoadUnitHandle(E2,0,DR*EM+1),LoadUnitHandle(E2,0,DR*EM+0),GetEventDamage()))
set Cl=BiE()
call BiZ(Cl,375.,LoadLocationHandle(E9,0,DR*EM+1),Condition(function BsI),function BsJ)
call BiF(Cl)
if BFi(1,100)<=10 and $6830324E==GetUnitTypeId(LoadUnitHandle(E2,0,DR*EM+0)) then
call BJ2(DR,.03,5)
else
call BJ2(DR,.1,2)
endif
elseif HR[DR]==5 then
call BST(DR,10,CreateUnitAtLoc(HY,$65303354,LoadLocationHandle(E9,0,DR*EM+1),bj_UNIT_FACING))
call Bcc(LoadUnitHandle(E2,0,DR*EM+3),0.,400,LoadLocationHandle(E9,0,DR*EM+1),250000.,1.,1.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
call BJ2(DR,.05,6)
elseif HR[DR]==6 then
if LoadInteger(FP,0,DR*EM+0)<2 then
call Bcb(LoadUnitHandle(E2,0,DR*EM+3),LoadUnitHandle(E2,0,DR*EM+1),200000,1,1,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
