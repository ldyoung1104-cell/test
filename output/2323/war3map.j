function BzH takes nothing returns nothing
local unit JL=GetAttacker()
local unit RN=GetTriggerUnit()
local unit JI
local location Id=GetUnitLoc(JL)
local location Ie=GetUnitLoc(RN)
local real I0=GetUnitFacing(JL)
local player RT=GetOwningPlayer(JL)
local integer Ix=GetUnitCurrentOrder(JL)
call SetUnitState(JL,UNIT_STATE_MANA,GetUnitStateSwap(UNIT_STATE_MANA,JL)+1)
if GetUnitStateSwap(UNIT_STATE_MANA,JL)==150. then
if GetUnitAbilityLevelSwapped($41313838,JL)>=1 then
call CreateUnit(RT,$68303452,GetUnitX(JL),GetUnitY(JL),I0)
call IssueImmediateOrderById(JL,OrderId("metamorphosis"))
call BdH(JL,RN,Ix)
call TriggerExecute(aW)
else
call SetUnitState(JL,UNIT_STATE_MANA,0)
call TriggerExecute(aX)
endif
endif
if BFi(1,100)<=10 then
call SetUnitAnimation(JL,"spell throw")
set JI=CreateUnitAtLoc(HY,$6530334F,Ie,I0)
call SetUnitScale(JI,3.75,1,1)
call SetUnitTimeScale(JI,3.75)
call Bcc(JL,0,400,Ie,400000.,.8,1.5,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
call Bcb(JL,RN,200000.,.8,1.5,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
endif
if BFi(1,100)<=8 then
call TriggerExecute(aY)
endif
call RemoveLocation(Id)
call RemoveLocation(Ie)
set JL=null
set RN=null
set JI=null
set Id=null
set Ie=null
set RT=null
endfunction
function BzI takes nothing returns nothing
