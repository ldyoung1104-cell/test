call SetPlayerState(Cl,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Cl,PLAYER_STATE_RESOURCE_GOLD)-3333)
call IncUnitAbilityLevel(GetTriggerUnit(),$41304E4B)
call IncUnitAbilityLevel(GetTriggerUnit(),$41304E4C)
if GetUnitAbilityLevel(GetTriggerUnit(),$41304E4C)>=6 then
call UnitRemoveAbility(GetTriggerUnit(),GetSpellAbilityId())
call DisplayTimedTextToPlayer(Cl,0,0,5,"|cffFF8200스킬이 최대 레벨에 도달했습니다.|r")
else
call DisplayTimedTextToPlayer(Cl,0,0,5,"|cffFF8200스킬레벨이 증가했습니다.|r")
endif
endfunction
