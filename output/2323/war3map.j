function Bl6 takes nothing returns nothing
local integer JG=GetPlayerId(DzGetTriggerSyncPlayer())
local integer Up=S2I(DzGetTriggerSyncData())
local integer VG=LoadInteger(L7,Up,L8)
local integer VH=LoadInteger(L7,Up,MZ)
if VH==0 then
call Bbu(JG,Up)
call Bj7(Player(JG))
call BCd(Player(JG))
call Bj8(Player(JG))
call Bl5(JG)
elseif VH==1 then
if Sx[JG]<LoadInteger(L7,Up,L8) then
call BcH(Player(JG),"|cffFF0000베리가 부족합니다.|r",VB,VC,0,VD,1)
else
set Sx[JG]=Sx[JG]-LoadInteger(L7,Up,L8)
call Bbu(JG,Up)
call Bj7(Player(JG))
call BCd(Player(JG))
call Bl5(JG)
endif
endif
endfunction
function Bl7 takes nothing returns nothing
local integer JG=GetPlayerId(DzGetTriggerSyncPlayer())
local string U0=DzGetTriggerSyncData()
local integer Up=S2I(U0)
local integer VN
if LoadInteger(Lx[JG],0,Up)!=Tt then
if TU[JG]==Up then
call BcH(Player(JG),"해당 칭호를 |cffFF0000해제|r했습니다.",VB,VC,0,VD,1)
call Bbt(JG)
else
call BcH(Player(JG),"해당 칭호를 |cffFF0000장착|r했습니다.",VB,VC,0,VD,1)
call Bbu(JG,Up)
call Bj8(Player(JG))
endif
call Bj7(Player(JG))
call Bl5(JG)
else
set VN=LoadInteger(L7,Up,MZ)
if VN==VO then
if Sw[JG]<LoadInteger(L7,Up,L8) then
call BcH(Player(JG),"|cffFF0000클리어 횟수가 부족합니다.|r",VB,VC,0,VD,1)
else
if GetLocalPlayer()==Player(JG) then
set UU[0]="칭호보상수령"
set UV[0]=LoadStr(L7,Up,L9)+" 칭호를 수령하시겠습니까?"
set UW[0]=I2S(Up)
set UX[0]="BuyTitle"
call BkN(0,true)
endif
endif
elseif VN==Ma then
if GetLocalPlayer()==Player(JG) then
set UU[0]="상품구매확인"
set UV[0]=LoadStr(L7,Up,L9)+" 상품을 |cff1e90ff"+I2S(LoadInteger(L7,Up,L8))+" 베리|r 에 구매하시겠습니까?"
set UW[0]=I2S(Up)
set UX[0]="BuyTitle"
call BkN(0,true)
endif
elseif VN==Mb then
call BcH(Player(JG),"|cffFF0000구매하실 수 없습니다.|r",VB,VC,0,VD,1)
endif
endif
endfunction
