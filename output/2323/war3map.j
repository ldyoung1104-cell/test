function COp takes nothing returns nothing
local integer EK=0
local integer oc=0
loop
exitwhen EK>=LG
if Ji[EK] and GetPlayerSlotState(Player(EK))==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(EK))==MAP_CONTROL_USER then
set oc=oc+1
endif
set EK=EK+1
endloop
if oc==2 then
set pp=30
elseif oc==3 then
set pp=25
else
set pp=20
endif
endfunction
function COq takes nothing returns nothing
local integer EK=0
local integer JG=0
local real of
if po<=0 then
return
endif
call COp()
loop
exitwhen JG>=LG
if LU[JG] then
call BjM(JG,GetObjectName(pl))
set EK=0
loop
exitwhen EK>=LG
if Ji[EK] then
set of=100.*pq[EK]/po
if pk<=2 then
call LeaderboardAddItem(jM[JG],GetPlayerName(Player(EK))+Ld[EK]+" [|cff00ff22"+R2SW(of,1,2)+"%|r"+Ld[EK]+"]|r",0,Player(EK))
elseif of>=I2R(pp) then
call LeaderboardAddItem(jM[JG],GetPlayerName(Player(EK))+Ld[EK]+" [|cff00ff22"+R2SW(of,1,2)+"%|r"+Ld[EK]+" / |cff00ced1"+I2S(pp)+"%|r"+Ld[EK]+"]|r",0,Player(EK))
else
call LeaderboardAddItem(jM[JG],GetPlayerName(Player(EK))+Ld[EK]+" ["+R2SW(of,1,2)+"% / |cff00ced1"+I2S(pp)+"%|r"+Ld[EK]+"]|r",0,Player(EK))
endif
endif
set EK=EK+1
endloop
call BjO(JG)
else
call BjQ(JG)
endif
set JG=JG+1
endloop
endfunction
function COr takes nothing returns nothing
local unit JL=GetEventDamageSource()
local unit RN=GetTriggerUnit()
local player RT=GetOwningPlayer(JL)
local real oY=GetUnitStateSwap(UNIT_STATE_MAX_LIFE,RN)
local real oj
local real ok
if not pm then
set pm=true
call TimerStart(pn,.25,true,function COq)
endif
if pr!=oY then
set pr=oY
if po<oY then
set po=oY
else
set ps=ps*(oY/po)
set po=oY
endif
endif
set ps=ps+GetEventDamage()
if GetUnitStateSwap(UNIT_STATE_MAX_LIFE,RN)>=ps then
if GetPlayerController(RT)==MAP_CONTROL_USER then
set pq[GetPlayerId(RT)]=pq[GetPlayerId(RT)]+GetEventDamage()
else
set pq[GetUnitUserData(JL)]=pq[GetUnitUserData(JL)]+GetEventDamage()
endif
else
set oj=ps-oY
set ok=GetEventDamage()-oj
if GetPlayerController(RT)==MAP_CONTROL_USER then
set pq[GetPlayerId(RT)]=pq[GetPlayerId(RT)]+ok
else
set pq[GetUnitUserData(JL)]=pq[GetUnitUserData(JL)]+ok
endif
endif
set JL=null
set RN=null
set RT=null
endfunction
function COs takes nothing returns nothing
local real oo=GetUnitStateSwap(UNIT_STATE_MAX_LIFE,GetTriggerUnit())
local real hL=0
local integer Js=0
local integer EK=0
set EK=0
loop
exitwhen EK>=LG
if LU[EK] then
call BjP(EK)
else
call BjQ(EK)
endif
set EK=EK+1
endloop
call PauseTimer(pn)
set pm=false
call COp()
set EK=0
loop
exitwhen EK>=LG
if Ji[EK] then
set hL=100*(pq[EK]/oo)
set pv[EK]=hL>=I2R(pp)
set Js=R2I((300-kJ[pk])*hL*5/100)
call DisplayTimedTextToPlayer(Player(EK),0,0,5,"|cffffd700자신이 가한데미지는 "+R2SW(hL,0,2)+"% 입니다.")
if Js>0 then
call DisplayTimedTextToPlayer(Player(EK),0,0,10,"|cffdc143c[클리어점수]|r 스토리 파괴 : |cffffd700"+I2S(Js)+"점|r")
call BdK(EK,Js)
endif
if pw<=pq[EK] then
set pw=pq[EK]
set px=EK
set py=hL
endif
endif
set EK=EK+1
endloop
set mX[px]=mX[px]+1
set kF[pk]=Player(px)
set kK[pk]=py*1.
endfunction
