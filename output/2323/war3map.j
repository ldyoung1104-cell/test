function MyFu_B7s takes nothing returns boolean
local player Cl
local group H1
local unit Cm
local integer ml_VL
local integer dl=0
local integer dm=0
local integer dn=0
local integer do=0
local boolean dk=false
local unit dq
local unit dp
set Cl=MyCurPlayer
set H1=CreateGroup()
call GroupEnumUnitsOfPlayer(H1,Cl,null)
loop
set Cm=FirstOfGroup(H1)
exitwhen Cm==null
call GroupRemoveUnit(H1,Cm)
if not dk then
set ml_VL=GetUnitTypeId(Cm)
if ml_VL==$48303939 or ml_VL==$48304232 or ml_VL==$48304233 then
set dl=GetHeroStatBJ(bj_HEROSTAT_STR,Cm,false)
set dm=GetHeroStatBJ(bj_HEROSTAT_AGI,Cm,false)
set dn=GetHeroStatBJ(bj_HEROSTAT_INT,Cm,false)
set do=GetHeroXP(Cm)
set dk=true
set dp=Cm
endif
endif
endloop
call DestroyGroup(H1)
if NG[GetPlayerId(Cl)]==0 then
call DisplayTimedTextToPlayer(Cl,0,0,5,"|cffff0000[오류]|r "+GetUnitName(dp)+"의 특성강화가 필요합니다!")
set Cl=null
set H1=null
set dp=null
return true
endif
if not MyCraft($45543032) then
set Cl=null
set H1=null
set dp=null
return true
endif
call StartSound(BHD("SE\\Nika.mp3",null,127,1.*1.,false,0,0))
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,10,"|CFFFFFA78니카 : |r|CFFC15AF4기어 피프스!|r")
set dq=FirstOfGroup(Q6)
call UnitAddItemToSlotById(dq,$49303030,0)
set NG[GetPlayerId(Cl)]=2
call BeQ()
if dk then
call SetHeroXP(dq,do,false)
call ModifyHeroStat(bj_HEROSTAT_STR,dq,bj_MODIFYMETHOD_SET,dl)
call ModifyHeroStat(bj_HEROSTAT_AGI,dq,bj_MODIFYMETHOD_SET,dm)
call ModifyHeroStat(bj_HEROSTAT_INT,dq,bj_MODIFYMETHOD_SET,dn)
endif
set Cl=null
set H1=null
set Cm=null
set dp=null
set dq=null
return true
endfunction
