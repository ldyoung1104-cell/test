local player RT=GetOwningPlayer(JL)
call UnitDamagePointLoc(JL,0,300.,Ie,200000.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
if BFi(1,100)<=33 then
set JI=CreateUnitAtLoc(HY,$6530374C,Id,I0)
call SetUnitFlyHeight(JI,30,0)
call SetUnitScale(JI,2.2,1,1)
set JI=CreateUnitAtLoc(HY,$65303556,Id,I0)
call SetUnitFlyHeight(JI,175,0)
call SetUnitScale(JI,1.75,1,1)
call SetUnitVertexColor(JI,0,0,100,255)
call UnitDamagePointLoc(JL,0,450.,Ie,600000.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
