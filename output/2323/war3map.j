function CTn takes nothing returns nothing
local integer JG=GetPlayerId(GetOwningPlayer(GetEventDamageSource()))
local integer sy=GetUnitAbilityLevel(GetTriggerUnit(),$41393041)
call BJ7(0)
if sy==JG+1 then
return
endif
if HR[DR]==0 then
call BST(DR,0,GetEventDamageSource())
call BST(DR,1,GetTriggerUnit())
call UnitAddAbility(LoadUnitHandle(E2,0,DR*EM+1),$4176756C)
call UnitAddAbility(LoadUnitHandle(E2,0,DR*EM+1),$41304B4B)
call SetUnitState(LoadUnitHandle(E2,0,DR*EM+1),UNIT_STATE_LIFE,(GetUnitState(LoadUnitHandle(E2,0,DR*EM+1),UNIT_STATE_LIFE)+GetEventDamage())*1.)
call IssueImmediateOrder(LoadUnitHandle(E2,0,DR*EM+0),"stop")
call BVU(DR,10,GetUnitCurrentOrder(LoadUnitHandle(E2,0,DR*EM+0)))
call EXPauseUnit(LoadUnitHandle(E2,0,DR*EM+0),true)
if s0[JG]==5 then
call DisplayTimedTextToPlayer(Player(JG),0,0,1,"|cffff0000(!)|r 다른 플레이어의 크립에게는 피해를 줄 수 없습니다!")
set s0[JG]=0
else
set s0[JG]=s0[JG]+1
endif
call BJ3(DR,.1)
elseif HR[DR]==1 then
call UnitRemoveAbility(LoadUnitHandle(E2,0,DR*EM+1),$4176756C)
call UnitRemoveAbility(LoadUnitHandle(E2,0,DR*EM+1),$41304B4B)
call EXPauseUnit(LoadUnitHandle(E2,0,DR*EM+0),false)
call BJx(DR)
endif
endfunction
function CTo takes integer JG,integer TK,boolean Yd returns nothing
