function Bkw takes integer TK returns nothing
call DzFrameSetTexture(UQ,Bkt(TK),0)
call DzFrameSetText(UR,Bku(TK)+"|n|cffbfbfbf획득 경로: "+Bkv(TK)+"|r")
call DzFrameShow(UQ,true)
endfunction
function Bkx takes integer K7 returns nothing
local integer TK=TM[K7]
local player Cl=DzGetTriggerUIEventPlayer()
if GetLocalPlayer()==DzGetTriggerUIEventPlayer() then
call Bkw(TK)
if not Bjo(Cl,TK) or (not LoadBoolean(UL,0,TK) and not LoadBoolean(UL,1,TK)) then
call DzSyncData(UT,I2S(TK))
else
set UU[0]="스킨 적용 확인"
if LoadBoolean(UL,1,TK) then
set UV[0]="스킨 적용 이전의 특수효과(그린블러드, 도시락 등)는|n반영되지 않으며 원래의 상태로 돌아올 수 없습니다."
else
set UV[0]="스킨 적용 이전의 특성강화는 반영되지 않으며|n다시 원래의 상태로 돌아올 수 없습니다."
endif
set UW[0]=I2S(TK)
set UX[0]="ApplySkin"
call BkN(0,true)
endif
endif
set Cl=null
endfunction
function Bky takes nothing returns nothing
local player Cl=DzGetTriggerSyncPlayer()
local integer TK=S2I(DzGetTriggerSyncData())
if not Bjo(Cl,TK) then
if TK==TT then
call BcH(Cl,"|cffFF0000VIP 효과가 적용되는 칭호를 장착해야 이달의 스킨을 적용할 수 있습니다.|r",VB,VC,0,VD,1)
else
call BcH(Cl,"|cffFF0000보유하지 않은 스킨입니다.|r",VB,VC,0,VD,1)
endif
elseif Bjr(Cl,TK) then
call BcH(Cl,"|cff1DDB16스킨을 적용했습니다.|r",VB,VC,0,VD,1)
set Sf[GetPlayerId(Cl)]=false
if GetLocalPlayer()==Cl then
call BkF()
endif
else
call BcH(Cl,"|cffFF0000스킨을 적용할 대상 유닛이 없습니다.|r",VB,VC,0,VD,1)
endif
set Cl=null
endfunction
function Bk1 takes integer DT,boolean TQ returns nothing
endfunction
function Bk3 takes nothing returns nothing
local integer DT=LoadInteger(K6,0,DzGetTriggerUIEventFrame())
call Bkx(DT)
endfunction
function Bk4 takes integer DT,integer Ks,real EN,real JS returns nothing
set TO[DT]=BDt(Ks,"DashBoardPremiumSkinIcon"+I2S(DT))
call DzFrameSetSize(TO[DT],45*1./Kx*Ky,45*1./Kz*K0)
call DzFrameSetPoint(TO[DT],0,Ks,0,EN*1./Kx*Ky,-(JS*1.)/Kz*K0)
set US[DT]=BDx(TO[DT],"DashBoardPremiumSkinIconButton"+I2S(DT))
call DzFrameSetSize(US[DT],45*1./Kx*Ky,45*1./Kz*K0)
call DzFrameSetPoint(US[DT],K4,TO[DT],K4,0*1./Kx*Ky,-(0*1.)/Kz*K0)
call SaveInteger(K6,0,US[DT],DT)
call DzFrameSetScriptByCode(US[DT],1,function Bk3,false)
endfunction
function Bk5 takes integer JG returns nothing
local integer EK=0
local integer TG
local integer TK
local integer TF=15
if GetLocalPlayer()==Player(JG) then
loop
exitwhen EK>=TF
set TG=TH*TI+TJ*TF+EK
set TK=TL[TG]
set TM[EK]=TK
if TG>=TH*TI+TN[TH] or TK==0 then
call DzFrameShow(TO[EK],false)
else
call DzFrameSetTexture(TO[EK],LoadStr(TP,0,TK),0)
call Bk1(EK,Bjo(Player(JG),TK))
call DzFrameShow(TO[EK],true)
endif
set EK=EK+1
endloop
endif
endfunction
function Bk6 takes integer UP returns nothing
set TH=UP
set TJ=0
call Bk5(GetPlayerId(DzGetTriggerUIEventPlayer()))
endfunction
function BlC takes integer DT returns nothing
local integer TF=15
local integer Uf=(TN[TH]+TF-1)/TF
if DT==0 and TJ>0 then
set TJ=TJ-1
elseif DT==1 and TJ+1<Uf then
set TJ=TJ+1
else
return
endif
call Bk5(GetPlayerId(DzGetTriggerUIEventPlayer()))
endfunction
