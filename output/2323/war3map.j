call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,5,"|cffff0000[오류]|r|cff1e90ff특성포인트|r가 부족합니다!")
call IssueImmediateOrder(GetTriggerUnit(),"stop")
return
endif
call UnitAddAbility(GetTriggerUnit(),$41313838)
call UnitMakeAbilityPermanent(GetTriggerUnit(),true,$41313838)
call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()),$41304736,false)
call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()),$41313244,false)
call SetPlayerState(GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_RESOURCE_FOOD_USED,GetPlayerState(GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_RESOURCE_FOOD_USED)-4)
endfunction
function By2 takes nothing returns boolean
