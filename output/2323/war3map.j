endfunction
function By8 takes nothing returns nothing
local integer Cl
call BJ7(1)
if HR[DR]==1 then
call BST(DR,0,GetAttacker())
call BST(DR,1,GetTriggerUnit())
call BTV(DR,0,GetUnitLoc(LoadUnitHandle(E2,0,DR*EM+0)))
call BTV(DR,1,GetUnitLoc(LoadUnitHandle(E2,0,DR*EM+1)))
call BVU(DR,2,0)
set Cl=BiE()
call BiZ(Cl,750.,LoadLocationHandle(E9,0,DR*EM+0),Condition(function By5),function By6)
call BiF(Cl)
call BVU(DR,4,4+LoadInteger(FP,0,DR*EM+2))
call BVU(DR,5,5+LoadInteger(FP,0,DR*EM+2))
set bj_lastPlayedSound=BHD("SE\\franky_Mi_sound.wav",null,127,1,true,1000,1500)
call BHH(LoadUnitHandle(E2,0,DR*EM+0),bj_lastPlayedSound)
call BJ3(DR,.04)
elseif HR[DR]<=LoadInteger(FP,0,DR*EM+4) then
call BTV(DR,2,PolarProjectionBJ(LoadLocationHandle(E9,0,DR*EM+1),BFj(30.,200.),GetRandomDirectionDeg()))
call BST(DR,2,CreateUnitAtLoc(HY,$65304131,LoadLocationHandle(E9,0,DR*EM+2),GetRandomDirectionDeg()))
call BTV(DR,2,PolarProjectionBJ(LoadLocationHandle(E9,0,DR*EM+1),BFj(35.,185.),GetRandomDirectionDeg()))
call BST(DR,2,CreateUnitAtLoc(HY,$65304131,LoadLocationHandle(E9,0,DR*EM+2),GetRandomDirectionDeg()))
if ModuloInteger(HR[DR],2)==0 then
set Cl=BiE()
call BiZ(Cl,400.,LoadLocationHandle(E9,0,DR*EM+1),Condition(function By2),function By7)
call BiF(Cl)
endif
call BJ3(DR,.07)
elseif HR[DR]==LoadInteger(FP,0,DR*EM+5) then
call BJx(DR)
endif
endfunction
function By9 takes nothing returns nothing
