set JI=CreateUnitAtLoc(HY,$65304D44,V7,I0)
call UnitApplyTimedLife(JI,$42487765,.2)
call SetUnitAnimation(JI,"attack")
call Bcb(JL,RN,800000.,1.,1.,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL)
if not (GetUnitAbilityLevel(RN,$41393034)>0) and not Bdi(RN) and not (GetUnitAbilityLevel(RN,$41393033)>0) then
call Bcb(JL,RN,GetUnitStateSwap(UNIT_STATE_MAX_LIFE,RN)*.06*(.79+.01*I2R(GetUnitAbilityLevel(RN,JD))),1.,1.,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_UNIVERSAL)
else
call Bcb(JL,RN,75000.,1.,1.,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
endif
call RemoveLocation(Id)
call RemoveLocation(V7)
set Id=null
set V7=null
endif
set JL=null
set RN=null
set JI=null
endfunction
