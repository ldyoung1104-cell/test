function Bld takes integer DT,integer Ks,real EN,real JS returns nothing
set Ta[DT]=BDt(Ks,"PlayerDashBoard__DashBoardClearListIcon icon")
call DzFrameSetSize(Ta[DT],65*1./Kx*Ky,65*1./Kz*K0)
