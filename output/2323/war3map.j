endif
call Bcc(LoadUnitHandle(E2,0,DR*EM+0),0,750,LoadLocationHandle(E9,0,DR*EM+1),800000,1.,1.25,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
call BJx(DR)
