function B8B takes unit Xt,integer dw returns nothing
local integer dx=GetPlayerId(GetOwningPlayer(Xt))
local integer dz
local player dy=GetOwningPlayer(Xt)
set dv[dx]=dv[dx]+dw
if GetPlayerTechCount(dy,$52303344,true)==1 then
call SetPlayerTechResearchedSwap($52303344,2,dy)
set dv[dx]=dv[dx]+200
call DisplayTimedTextToPlayer(dy,0,0,5,"|cffFF0000'오뎅 - 영원'|r 의 효과로 사무라이의 혼 스택이 |cffFF0000200 증가|r 했습니다.|r")
endif
set dz=dv[dx]
if GetPlayerTechResearched(dy,$52303346,false) then
set dy=null
return
endif
if dz>=100 and GetUnitAbilityLevelSwapped($4131424A,Xt)<=1 then
call IncUnitAbilityLevelSwapped($4131424A,Xt)
call BFw("Abilities\\Spells\\Other\\Levelup\\LevelupCaster.mdx",Xt,"origin")
endif
if dz>=400 and GetUnitAbilityLevelSwapped($41313652,Xt)<1 then
call UnitAddAbility(Xt,$41313652)
call BFw("Abilities\\Spells\\Other\\Levelup\\LevelupCaster.mdx",Xt,"origin")
endif
if dz>=700 then
call SetPlayerTechResearched(dy,$52303346,1)
call BFw("Abilities\\Spells\\Other\\Levelup\\LevelupCaster.mdx",Xt,"origin")
endif
set dy=null
endfunction
function B8C takes nothing returns nothing
local integer Hv=dv[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))]
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,5,"|cffFF0000사무라이의 혼|r : "+I2S(Hv)+"|r")
endfunction
function B8D takes nothing returns nothing
if GetOwningPlayer(GetTriggerUnit())!=GetOwningPlayer(GetSpellTargetUnit()) then
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,5,"|cffFF8200내 소유 유닛에게만 사용할 수 있습니다.|r")
call IssueImmediateOrderBJ(GetTriggerUnit(),"stop")
return
endif
if GetUnitTypeId(GetSpellTargetUnit())==$6830434A then
if GetUnitAbilityLevelSwapped($41314249,GetSpellTargetUnit())==2 then
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,5,"|cffFF8200이미 '류마 영원' 을 강화했습니다.|r")
call IssueImmediateOrderBJ(GetTriggerUnit(),"stop")
return
endif
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,3,"|cffFF0000도신 류마 : |r|cffFA8072내 시체가 부서지더라도... 검사의 긍지는 절대 지울 수 없다!|r")
call IncUnitAbilityLevelSwapped($41314249,GetSpellTargetUnit())
call AddSpecialEffectTarget("Windwalk_dark.mdx",GetSpellTargetUnit(),"origin")
call Bha(GetOwningPlayer(GetTriggerUnit()),$41493033)
call UnitAddItemToSlotById(GetSpellTargetUnit(),$49303033,0)
elseif GetUnitTypeId(GetSpellTargetUnit())==$48303946 then
call IssueImmediateOrderBJ(GetTriggerUnit(),"stop")
else
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,5,"|cffFF8200'조로 초월' 또는 '류마 영원' 에게만 사용할 수 있습니다.|r")
call IssueImmediateOrderBJ(GetTriggerUnit(),"stop")
endif
endfunction
function B8E takes nothing returns nothing
local unit JL=GetAttacker()
local unit RN=GetTriggerUnit()
local unit XX=IG[GetPlayerId(GetOwningPlayer(JL))]
local unit JI
local location Id
local location Ie
local real I0=GetUnitFacing(JL)
local real dw=dv[GetPlayerId(GetOwningPlayer(JL))]
call SetUnitState(JL,UNIT_STATE_MANA,GetUnitStateSwap(UNIT_STATE_MANA,JL)+1)
if BFi(1,100)<=10 then
call B8B(JL,1)
endif
if GetUnitStateSwap(UNIT_STATE_MANA,JL)==150. then
call SetUnitState(JL,UNIT_STATE_MANA,0)
if GetUnitAbilityLevelSwapped($41314249,JL)==1 then
call TriggerExecute(d0)
else
call TriggerExecute(d1)
endif
endif
call TriggerExecute(d2)
if BFi(1,100)<=25 then
set Ie=GetUnitLoc(RN)
set JI=CreateUnitAtLoc(HY,$65304735,Ie,GetRandomDirectionDeg())
call SetUnitScale(JI,(100.+dw*.1)*.01,1,1)
call UnitDamagePointLoc(XX,0.,300.,Ie,160000+dw*160,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
call RemoveLocation(Ie)
endif
if BFi(1,100)<=15 then
set Id=GetUnitLoc(JL)
set Ie=GetUnitLoc(RN)
set JI=CreateUnitAtLoc(HY,$65304736,Id,GetUnitFacing(JL))
call SetUnitScale(JI,(100.+dw*.07)*.01,1,1)
call UnitDamagePointLoc(XX,0.,400.,Ie,400000+dw*450,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
call RemoveLocation(Id)
call RemoveLocation(Ie)
if BFi(1,100)<=20 then
if UnitHasBuffBJ(JL,$42303942)==false then
call B8B(JL,2)
set JI=CreateUnitAtLoc(HY,$65304B58,Id,0)
call UnitApplyTimedLife(JI,$42487765,1)
call IssueTargetOrder(JI,"frostarmor",JL)
endif
endif
endif
if BFi(1,100)<=12 then
call TriggerExecute(d3)
endif
if GetPlayerTechResearched(GetOwningPlayer(JL),$52303331,false)==true then
if BFi(1,100)<=5 then
if GetUnitPointValue(RN)<200 then
call Bcb(XX,RN,GetUnitStateSwap(UNIT_STATE_LIFE,RN)*.1*(.79+.01*I2R(GetUnitAbilityLevel(RN,JD))),1.,1.,ATTACK_TYPE_HERO,DAMAGE_TYPE_UNIVERSAL)
set Ie=GetUnitLoc(RN)
set JI=CreateUnitAtLoc(HY,$65303554,Ie,270)
call SetUnitFlyHeight(JI,30,0)
call RemoveLocation(Ie)
endif
endif
endif
set JL=null
set RN=null
set JI=null
set Id=null
set Ie=null
endfunction
function B8F takes nothing returns nothing
call Bcx("전설의사무라이",true,function B7z)
call Bcx("ryuma et",true,function B7z)
call w5($6830434A,function B8E)
set d0=CreateTrigger()
call BKD(d0)
