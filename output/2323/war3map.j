call UnitDamagePointLoc(JL,0.,500.,Ie,102500.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
endif
endif
if UnitHasBuffBJ(JL,$42303037)==false then
