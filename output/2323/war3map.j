function CB4 takes nothing returns nothing
local unit JL=GetAttacker()
local integer e5
call TriggerExecute(e4)
if GetUnitState(JL,UNIT_STATE_MANA)==150. then
set e5=GetUnitAbilityLevel(JL,$41305755)
call TriggerExecute(e6)
if e5>=2 then
call TriggerExecute(e7)
endif
if e5>=3 then
call TriggerExecute(e8)
endif
call SetUnitState(JL,UNIT_STATE_MANA,0*1.)
else
call SetUnitState(JL,UNIT_STATE_MANA,(GetUnitState(JL,UNIT_STATE_MANA)+1)*1.)
endif
set JL=null
endfunction
function CB5 takes unit Cm returns boolean
return GetUnitAbilityLevel(Cm,$41305751)>=2 and GetUnitAbilityLevel(Cm,$4130574F)>=2 and GetUnitAbilityLevel(Cm,$4130574E)>=2
endfunction
function CB6 takes unit Cm returns boolean
return GetUnitAbilityLevel(Cm,$41305751)>=3 and GetUnitAbilityLevel(Cm,$4130574F)>=3 and GetUnitAbilityLevel(Cm,$4130574E)>=3
endfunction
function CB7 takes nothing returns nothing
local player RT=GetTriggerPlayer()
local item ez=GetManipulatedItem()
local unit e0=GetTriggerUnit()
local integer e2=0
local integer e3
local integer e1=GetUnitAbilityLevel(e0,$41305751)
if e1>=3 then
set RT=null
set ez=null
set e0=null
return
endif
if BFi(1,5)<=2 then
set e2=1
else
set e2=2
endif
set e3=GetItemCharges(ez)+1+e2
if e3>=30 then
set e3=30
call DisplayTimedTextToPlayer(RT,0,0,5,"|cffFF0000[시스템]|r '유니언 아르마다 :: 공격력' 스택이 최대치에 도달했습니다.")
else
call DisplayTimedTextToPlayer(RT,0,0,5,"|cffFF0000[시스템]|r '유니언 아르마다 :: 공격력' 스택이 "+I2S(e2)+"개 상승했습니다.")
endif
call SetItemCharges(ez,e3)
if e1==1 then
if e3>=15 then
call SetUnitAbilityLevel(e0,$4130574C,2)
call SetUnitAbilityLevel(e0,$41305751,2)
call DisplayTimedTextToPlayer(RT,0,0,5,"|cffFF0000[레벨업]|r 유니크로 등급 업!")
if CB5(e0) then
call SetUnitAbilityLevel(e0,$41305755,2)
call DisplayTimedTextToPlayer(RT,0,0,5,"|cffffe100[유니크]|r 모든 스킬이 유니크 달성! '데어 슈테르크슈테 스트라이크' 레벨업")
endif
endif
elseif e1==2 then
if e3>=30 then
call SetUnitAbilityLevel(e0,$4130574C,3)
call SetUnitAbilityLevel(e0,$41305751,3)
call DisplayTimedTextToPlayer(RT,0,0,5,"|cffFF0000[레벨업]|r 레전더리로 등급 업!")
if CB6(e0) then
call SetUnitAbilityLevel(e0,$41305755,3)
call DisplayTimedTextToPlayer(RT,0,0,5,"|cff5eff00[레전더리]|r 모든 스킬이 레전더리 달성! '데어 슈테르크슈테 스트라이크' 레벨업")
endif
call UnitRemoveItemFromSlot(e0,0)
call RemoveItem(ez)
call UnitAddItemToSlotById(e0,$49303036,0)
endif
endif
set RT=null
set ez=null
set e0=null
endfunction
