function Bhc takes player Cl,integer Hk,integer fX returns nothing
local integer JG=GetPlayerId(Cl)
if Hk<=0 then
call BJDebugMsg("|cffff0000[오류]|r index에 0보다 같거나 작은값이 입력되었습니다.")
return
endif
if Hk>10 then
call BJDebugMsg("|cffff0000[오류]|r index에 10보다 큰값이 입력되었습니다. 최대값은 10 입니다.")
return
endif
if fX==fY then
if fZ[JG]-Hk<0 then
call BJDebugMsg("|cffff0000[오류]|r 아이템 스택이 0보다 작아질 수 없습니다.")
return
endif
call UnitRemoveAbility(RV[JG],LoadInteger(Qr,0,fZ[JG]))
set fZ[JG]=fZ[JG]-Hk
call UnitAddAbility(RV[JG],LoadInteger(Qr,0,fZ[JG]))
call DisplayTimedTextToPlayer(Cl,0,0,5,"|cff04ffc4[알림]|r |cffA6A6A6아이템 발굴|r 스택이 |cff1e90ff"+I2S(Hk)+"|r 감소했습니다.")
elseif fX==fa then
if fb[JG]-Hk<0 then
call BJDebugMsg("|cffff0000[오류]|r 유니크 아이템 스택이 0보다 작아질 수 없습니다.")
return
endif
call UnitRemoveAbility(RV[JG],LoadInteger(Qr,1,fb[JG]))
set fb[JG]=fb[JG]-Hk
call UnitAddAbility(RV[JG],LoadInteger(Qr,1,fb[JG]))
call DisplayTimedTextToPlayer(Cl,0,0,5,"|cff04ffc4[알림]|r |cffFF8200유니크 아이템 발굴|r 스택이 |cff1e90ff"+I2S(Hk)+"|r 감소했습니다.")
endif
endfunction
function Bhd takes player Cl,integer Hk,integer fX returns nothing
local integer JG=GetPlayerId(Cl)
if Hk<=0 then
call BJDebugMsg("|cffff0000[오류]|r index에 0보다 같거나 작은값이 입력되었습니다")
return
endif
if Hk>10 then
call BJDebugMsg("|cffff0000[오류]|r index에 10보다 큰값이 입력되었습니다. 최대값은 10 입니다")
return
endif
if fX==fY then
if fZ[JG]+Hk>10 then
call BJDebugMsg("|cffff0000[오류]|r 아이템 스택이 최대값인 10을 초과했습니다")
return
endif
call UnitRemoveAbility(RV[JG],LoadInteger(Qr,0,fZ[JG]))
set fZ[JG]=fZ[JG]+Hk
call UnitAddAbility(RV[JG],LoadInteger(Qr,0,fZ[JG]))
call DisplayTimedTextToPlayer(Cl,0,0,5,"|cff04ffc4[알림]|r |cffA6A6A6아이템 발굴|r 스택이 |cff1e90ff"+I2S(Hk)+"|r 증가했습니다.")
call DisplayTimedTextToPlayer(Cl,0,0,5,"현재 |cffA6A6A6아이템 발굴|r 스택 : |cff1e90ff"+I2S(Bhb(Cl,0))+"|r")
elseif fX==fa then
if fb[JG]+Hk>10 then
call BJDebugMsg("|cffff0000[오류]|r 유니크 아이템 스택이 최대값인 10을 초과했습니다")
return
endif
call UnitRemoveAbility(RV[JG],LoadInteger(Qr,1,fb[JG]))
